  // Checkboxes de flags registradas por plugins (ej. "es de streaming" del plugin Streaming)
  function renderMappingFlags(idx) {
    const wrap = document.getElementById("map-flags");
    if (!wrap) return;
    wrap.innerHTML = "";
    const flags = pluginRuntime.indexFlags;
    if (!flags.length) { wrap.style.display = "none"; return; }
    wrap.style.display = "flex";
    for (const f of flags) {
      const label = document.createElement("label");
      label.className = "plx-flag-label";
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.dataset.plxflag = f.id;
      cb.checked = !!(idx.flags && idx.flags[f.id]);
