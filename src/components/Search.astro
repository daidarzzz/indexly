---
// src/components/Search.astro — Premium SaaS restyle + generic normalizer + P0 polish
---

<div class="Search">
  <div class="index-manager-card" id="drop-zone">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12H14l-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6l2 2h8a2 2 0 0 1 2 2v4Z"/><path d="M14 14v6H4a2 2 0 0 1-2-2v-6"/></svg>
        </div>
        <div>
          <h3>Fuentes</h3>
          <p class="manager-desc">Gestiona tus índices activos</p>
        </div>
      </div>
      <div class="manager-actions">
        <button type="button" id="collapse-fuentes" class="collapse-btn" aria-expanded="true" aria-controls="indexes-list bulk-actions" aria-label="Comprimir fuentes" title="Comprimir">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <button type="button" id="export-btn" class="action-btn secondary" title="Descargar backup">Exportar</button>
        <button type="button" id="import-btn" class="action-btn secondary" title="Restaurar backup">Importar</button>
        <input type="file" id="import-input" accept=".json,.gz" class="sr-only" tabindex="-1" />
        <label for="json-input" class="file-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Añadir archivo
        </label>
        <input type="file" id="json-input" accept=".json,.csv,.tsv,.yaml,.yml,.xml,.txt" multiple class="sr-only" />
      </div>
    </div>
    <div id="indexes-list" class="indexes-grid-list">
      <p class="no-indexes">No hay índices cargados todavía.</p>
    </div>
    <div id="bulk-actions" class="bulk-actions" style="display:none">
      <button type="button" id="bulk-enable" class="bulk-btn">Activar todo</button>
      <button type="button" id="bulk-disable" class="bulk-btn">Desactivar todo</button>
      <button type="button" id="bulk-clear" class="bulk-btn danger">Borrar todo</button>
    </div>
    <p class="drop-hint">Arrastra archivos aquí o pega con Ctrl+V</p>
  </div>
  <div class="index-manager-card hub-card" id="hub-card">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="2.5"/></svg>
        </div>
        <div>
          <h3>IndexlyHub <span id="hub-status" class="hub-status">desconectado</span></h3>
          <p class="manager-desc" id="hub-desc">Explora paquetes de la comunidad</p>
        </div>
      </div>
      <div class="manager-actions">
        <button type="button" id="hub-card-btn" class="action-btn secondary">Conectar</button>
      </div>
    </div>
    <div id="hub-offline" class="hub-offline">
      <p>Conecta tu API de IndexlyHub para explorar paquetes populares, ver tus favoritos e importarlos sin salir de aquí.</p>
      <button type="button" class="file-label" onclick="openHubModal()">Conectar con el Hub</button>
    </div>
    <div id="hub-online" style="display:none">
      <div class="hub-toolbar">
        <div class="filter-chips hub-tabs" role="group" aria-label="Explorar Hub">
          <button type="button" class="chip active" data-hubtab="popular">Populares</button>
          <button type="button" class="chip" data-hubtab="recent">Recientes</button>
          <button type="button" class="chip" data-hubtab="favs">Favoritos</button>
        </div>
        <input type="text" id="hub-search" class="mapping-input hub-search" placeholder="Buscar paquetes…" autocomplete="off" spellcheck="false" aria-label="Buscar paquetes en el Hub" />
      </div>
      <div id="hub-list" class="hub-list" aria-live="polite"></div>
      <button type="button" id="hub-more" class="load-more-btn" style="display:none">Cargar más</button>
    </div>
  </div>
  <div class="search-wrap">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="text" id="search-input" placeholder="Buscar…" disabled autocomplete="off" spellcheck="false" aria-label="Buscar en índices" />
  </div>
  <div class="controls">
    <div class="filter-chips" role="group" aria-label="Filtrar por enlace">
      <button type="button" class="chip active" data-filter="all">Todos</button>
      <button type="button" class="chip" data-filter="link">Con enlace</button>
      <button type="button" class="chip" data-filter="nolink">Sin enlace</button>
    </div>
    <select id="sort-select" class="sort-select" aria-label="Ordenar">
      <option value="relevance">Relevancia</option>
      <option value="title-asc">Título A-Z</option>
      <option value="title-desc">Título Z-A</option>
      <option value="size-desc">Tamaño ↓</option>
      <option value="size-asc">Tamaño ↑</option>
      <option value="date-desc">Fecha reciente</option>
      <option value="date-asc">Fecha antigua</option>
    </select>
  </div>
  <div id="quota-info" class="quota-info" aria-live="polite"></div>
  <div id="stats-container" class="stats-container" aria-live="polite" aria-atomic="true"></div>
  <div id="results" class="results-grid" aria-live="polite"></div>
  <button type="button" id="load-more-btn" class="load-more-btn" style="display: none;">Cargar más</button>
  <p class="footer-note" id="footer-note">Todo se guarda localmente. Nada se envía a servidores.</p>
</div>

<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

<div id="confirm-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <h4 id="confirm-title">Confirmar</h4>
    <p id="confirm-msg" class="mapping-desc"></p>
    <div class="mapping-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeConfirmModal()">Cancelar</button>
      <button type="button" class="mapping-btn danger" id="confirm-ok">Confirmar</button>
    </div>
  </div>
</div>

<div id="mapping-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="mapping-title">
    <div class="mapping-header">
      <h4 id="mapping-title">Ajustar fuente</h4>
      <button type="button" class="mapping-close" onclick="closeMappingModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Renombra la fuente y elige qué campo de tu archivo corresponde a cada rol.</p>
    <div class="mapping-fields">
      <label class="mapping-label" for="map-name">Nombre de la fuente
        <input id="map-name" type="text" class="mapping-input" placeholder="Ej: Mis Juegos" maxlength="60" />
      </label>
      <label class="mapping-label" for="map-title">Título (obligatorio)
        <select id="map-title"></select>
      </label>
      <label class="mapping-label" for="map-subtitle">Subtítulo (opcional)
        <select id="map-subtitle"></select>
      </label>
      <label class="mapping-label" for="map-link">Enlace (opcional)
        <select id="map-link"></select>
      </label>
    </div>
    <p class="mapping-hint">Vista previa: <span id="mapping-preview">—</span></p>
    <div class="mapping-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeMappingModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" onclick="saveMapping()">Aplicar</button>
    </div>
  </div>
</div>

<div id="export-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog io-dialog" role="dialog" aria-modal="true" aria-labelledby="export-title">
    <div class="mapping-header">
      <div class="io-heading">
        <div class="io-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3M8 7l4-4 4 4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
        </div>
        <h4 id="export-title">Exportar fuentes</h4>
      </div>
      <button type="button" class="mapping-close" onclick="closeExportModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Selecciona las fuentes que quieres guardar en el backup.</p>
    <div class="io-toolbar">
      <label class="io-select-all"><input type="checkbox" id="export-select-all" checked /> Seleccionar todo</label>
      <span id="export-counter" class="io-counter">0/0</span>
    </div>
    <div id="export-list" class="io-list" role="group" aria-label="Fuentes a exportar"></div>
    <p id="export-hint" class="mapping-hint" style="display:none"></p>
    <div class="mapping-actions io-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeExportModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" id="export-confirm">Exportar</button>
    </div>
  </div>
</div>

<div id="import-select-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog io-dialog" role="dialog" aria-modal="true" aria-labelledby="import-select-title">
    <div class="mapping-header">
      <div class="io-heading">
        <div class="io-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v8M8 12l4 4 4-4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/><path d="M4 8v-1a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1"/></svg>
        </div>
        <h4 id="import-select-title">Importar fuentes</h4>
      </div>
      <button type="button" class="mapping-close" onclick="closeImportSelectModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Elige qué fuentes del backup quieres añadir.</p>
    <div class="io-toolbar">
      <label class="io-select-all"><input type="checkbox" id="import-select-all" /> Seleccionar todo</label>
      <span id="import-counter" class="io-counter">0/0</span>
    </div>
    <div id="import-select-list" class="io-list" role="group" aria-label="Fuentes a importar"></div>
    <p id="import-hint" class="mapping-hint" style="display:none"></p>
    <div class="mapping-actions io-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeImportSelectModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" id="import-select-confirm">Importar</button>
    </div>
  </div>
</div>

<div id="hub-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="hub-modal-title">
    <div class="mapping-header">
      <h4 id="hub-modal-title">Conectar IndexlyHub</h4>
      <button type="button" class="mapping-close" onclick="closeHubModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Pega un token <code>ih_…</code> creado en tu perfil del Hub (<a href="https://indexlyhub.daida.net/profile" target="_blank" rel="noopener">indexlyhub.daida.net/profile</a> → Tokens de API). Desbloquea explorar, importar y favoritos.</p>
    <div class="mapping-fields">
      <label class="mapping-label" for="hub-token">Token de API
        <input id="hub-token" type="password" class="mapping-input" placeholder="ih_…" autocomplete="off" spellcheck="false" maxlength="120" />
      </label>
    </div>
    <p class="mapping-hint">El token se guarda solo en este navegador. Equivale a tu contraseña: no lo compartas. Puedes revocarlo cuando quieras desde el Hub.</p>
    <div class="mapping-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeHubModal()">Cancelar</button>
      <button type="button" class="mapping-btn danger" id="hub-disconnect" style="display:none">Desconectar</button>
      <button type="button" class="mapping-btn primary" id="hub-save">Conectar</button>
    </div>
  </div>
</div>

<script>
  import { normalizeJson, getAvailableKeys, getAutoMapping } from "../utils/normalizer";
  import { parseFileContent } from "../utils/loaders";
  import { get, set } from "idb-keyval";
  import { compactIndexes, inflateIndexes, migrateV1, isV2Envelope } from "../utils/exportCodec";
  import { compressJsonToBlob, decompressBlobToText, hasCompressionSupport } from "../utils/compress";
  let indexes = [];
  let currentFilteredGames = [];
  let visibleCount = 50;
  let mappingModalIndexId = null;
  let lastRemoved = null;
  let undoTimer = null;
  let activeFilter = "all";
  let sortBy = "relevance";
  const fileInput = document.getElementById("json-input");
  const importInput = document.getElementById("import-input");
  const exportBtn = document.getElementById("export-btn");
  const importBtn = document.getElementById("import-btn");
  const searchInput = document.getElementById("search-input");
  const resultsContainer = document.getElementById("results");
  const indexesListContainer = document.getElementById("indexes-list");
  const loadMoreBtn = document.getElementById("load-more-btn");
  const statsContainer = document.getElementById("stats-container");
  const bulkActions = document.getElementById("bulk-actions");
  const dropZone = document.getElementById("drop-zone");
  const collapseBtn = document.getElementById("collapse-fuentes");
  const fuentesCard = document.getElementById("drop-zone");
  const toastContainer = document.getElementById("toast-container");
  const confirmModal = document.getElementById("confirm-modal");
  const confirmMsg = document.getElementById("confirm-msg");
  const confirmOk = document.getElementById("confirm-ok");
  const mappingModal = document.getElementById("mapping-modal");
  const mapNameInput = document.getElementById("map-name");
  const mapTitleSelect = document.getElementById("map-title");
  const mapSubtitleSelect = document.getElementById("map-subtitle");
  const mapLinkSelect = document.getElementById("map-link");
  const mappingPreview = document.getElementById("mapping-preview");
  const exportModal = document.getElementById("export-modal");
  const exportList = document.getElementById("export-list");
  const exportSelectAll = document.getElementById("export-select-all");
  const exportHint = document.getElementById("export-hint");
  const exportConfirm = document.getElementById("export-confirm");
  const importSelectModal = document.getElementById("import-select-modal");
  const importSelectList = document.getElementById("import-select-list");
  const importSelectAll = document.getElementById("import-select-all");
  const importHint = document.getElementById("import-hint");
  const importSelectConfirm = document.getElementById("import-select-confirm");
  const exportCounter = document.getElementById("export-counter");
  const importCounter = document.getElementById("import-counter");
  let pendingImportData = null;

  function showToast(message, type="info", duration=3000, action=null) {
    const toast = document.createElement("div");
    toast.className = `toast toast-${type}`;
    toast.setAttribute("role", "status");
    const textWrap = document.createElement("div");
    textWrap.className = "toast-text";
    const span = document.createElement("span");
    span.textContent = message;
    textWrap.appendChild(span);
    toast.appendChild(textWrap);
    if (action) {
      const sep = document.createElement("span");
      sep.className = "toast-sep";
      sep.setAttribute("aria-hidden","true");
      toast.appendChild(sep);
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "toast-action";
      btn.textContent = action.label;
      btn.addEventListener("click", async (e) => {
        e.preventDefault(); e.stopPropagation();
        try { await action.onClick(); } catch(err){ console.error(err); }
        toast.remove();
      });
      toast.appendChild(btn);
    }
    toastContainer.appendChild(toast);
    let t = setTimeout(() => dismiss(), duration);
    function dismiss(){ toast.remove(); if (action && lastRemoved) lastRemoved = null; }
    toast.addEventListener("mouseenter", ()=> clearTimeout(t));
    toast.addEventListener("mouseleave", ()=> { t = setTimeout(()=>dismiss(), 1200); });
    return { dismiss };
  }

  let confirmCallback = null;
  function showConfirm(msg, onConfirm) {
    confirmMsg.textContent = msg;
    confirmCallback = onConfirm;
    confirmModal.style.display = "flex";
    confirmModal.setAttribute("aria-hidden","false");
    confirmOk.focus();
  }
  window.closeConfirmModal = function() {
    confirmModal.style.display = "none";
    confirmModal.setAttribute("aria-hidden","true");
    confirmCallback = null;
  };
  confirmOk.addEventListener("click", () => { const cb = confirmCallback; closeConfirmModal(); if (cb) cb(); });
  confirmModal.addEventListener("click", (e) => { if (e.target === confirmModal) closeConfirmModal(); });

  function normalizeStr(s) { return s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase(); }
  function getSearchableText(item) {
    if (item._searchText != null) return item._searchText;
    const parts = [item.title, item.subtitle, item.source];
    if (item.meta) parts.push(...Object.values(item.meta));
    if (item.fileSize) parts.push(item.fileSize);
    const t = normalizeStr(parts.filter(Boolean).join(" "));
    try { Object.defineProperty(item, "_searchText", { value: t, writable: true, enumerable: false }); } catch { item._searchText = t; }
    return t;
  }
  function parseSizeToBytes(str) {
    if (!str || typeof str!=="string") return 0;
    const m = str.trim().match(/^([\d.,]+)\s*(B|KB|MB|GB|TB)?/i);
    if (!m) return 0;
    const n = parseFloat(m[1].replace(",","."));
    const unit = (m[2]||"B").toUpperCase();
    const mult = {B:1,KB:1024,MB:1024**2,GB:1024**3,TB:1024**4};
    return n * (mult[unit]||1);
  }
  function parseDateVal(v) {
    if (!v) return 0;
    const d = new Date(String(v));
    return isNaN(d.getTime()) ? 0 : d.getTime();
  }
  function getItemDate(item) {
    if (item.meta) {
      for (const [k,v] of Object.entries(item.meta)) {
        if (["uploaddate","upload_date","fecha","fechasubida"].includes(k.toLowerCase())) return parseDateVal(v);
      }
    }
    if (item.uploadDate) return parseDateVal(item.uploadDate);
    return 0;
  }

  function debounce(fn, delay) {
    let t;
    return (...args) => { clearTimeout(t); t = setTimeout(()=>fn(...args), delay); };
  }

  function escapeHtml(str) { const d = document.createElement("div"); d.textContent = str == null ? "" : String(str); return d.innerHTML; }
  function formatDateDDMMYY(val) {
    if (!val || typeof val !== "string") return val;
    const s = val.trim();
    const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[3]}/${iso[2]}/${iso[1].slice(2)}`;
    const d = new Date(s);
    if (!isNaN(d.getTime())) {
      const dd = String(d.getDate()).padStart(2, "0");
      const mm = String(d.getMonth()+1).padStart(2, "0");
      const yy = String(d.getFullYear()).slice(2);
      return `${dd}/${mm}/${yy}`;
    }
    return val;
  }

  function syncQueryToURL(q) {
    const url = new URL(window.location.href);
    if (q) url.searchParams.set("q", q);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }
  async function loadStoredIndexes() {
    try {
      const saved = await get("indexly_saved_indexes");
      if (saved) {
        indexes = saved.map((item) => {
          const parsedGames = normalizeJson(item.rawData, item.name, item.mapping || null);
          return { id: item.id, name: item.name, active: item.active, rawData: item.rawData, mapping: item.mapping || null, pkg: item.pkg || null, games: parsedGames };
        });
        if (indexes.length > 0) searchInput.removeAttribute("disabled");
      }
      const urlQ = new URL(window.location.href).searchParams.get("q");
      if (urlQ) searchInput.value = urlQ;
    } catch (e) { console.error(e); }
    updateApp();
  }
  async function saveIndexesToStorage() {
    try {
      const dataToSave = indexes.map((idx) => ({ id: idx.id, name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping || null, pkg: idx.pkg || null }));
      await set("indexly_saved_indexes", dataToSave);
    } catch (e) { console.error(e); showToast("Error al guardar en IndexedDB", "error"); }
  }

  async function handleFiles(files) {
    let addedCount = 0; let duplicateNames = [];
    for (const file of files) {
      try {
        const text = await file.text();
        const rawData = parseFileContent(text, file.name);
        const parsedGames = normalizeJson(rawData, file.name, null);
        const baseName = file.name.replace(/\.[^.]+$/i, "");
        const indexName = (rawData && typeof rawData === "object" && !Array.isArray(rawData) && rawData.name) ? rawData.name : baseName;
        const exists = indexes.some((idx) => idx.name.toLowerCase() === indexName.toLowerCase());
        if (exists) { duplicateNames.push(indexName); continue; }
        if (parsedGames.length === 0) {
          showToast(`"${file.name}" sin elementos reconocibles — puedes mapearlo`, "warning", 4000);
          indexes.push({ id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, mapping: null, pkg: null, games: [] });
          addedCount++;
          continue;
        }
        indexes.push({ id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, mapping: null, pkg: null, games: parsedGames });
        addedCount++;
      } catch (error) { console.error(error); showToast(`Error en "${file.name}": ${error.message}`, "error"); }
    }
    if (duplicateNames.length > 0) showToast(`Ya existían y se omitieron: ${duplicateNames.join(", ")}`, "warning", 4000);
    if (addedCount > 0) {
      searchInput.removeAttribute("disabled");
      await saveIndexesToStorage(); updateApp();
      showToast(`${addedCount} fuente(s) añadida(s)`, "success");
    }
  }

  fileInput.addEventListener("change", async (event) => {
    const files = event.target.files ? Array.from(event.target.files) : [];
    event.target.value = "";
    if (files.length === 0) return;
    await handleFiles(files);
  });

  // Drag & Drop
  ["dragenter","dragover"].forEach(ev => dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add("drag-over"); }));
  ["dragleave","drop"].forEach(ev => dropZone.addEventListener(ev, (e) => { e.preventDefault(); if (ev==="dragleave" && e.target!==dropZone) return; dropZone.classList.remove("drag-over"); }));
  dropZone.addEventListener("drop", async (e) => {
    const allowed = [".json",".csv",".tsv",".yaml",".yml",".xml",".txt"];
    const files = Array.from(e.dataTransfer.files || []).filter(f => allowed.some(ext=>f.name.toLowerCase().endsWith(ext)));
    if (files.length === 0) { showToast("Arrastra archivos .json/.csv/.yaml/.xml/.txt", "warning"); return; }
    await handleFiles(files);
  });
  // Paste archivos
  document.addEventListener("paste", async (e) => {
    if (document.activeElement === searchInput || document.activeElement === mapNameInput || document.activeElement === hubSearch || document.activeElement === hubTokenInput) return;
    const text = (e.clipboardData || window.clipboardData).getData("text");
    if (!text || !text.trim()) return;
    const t = text.trim();
    if (!t.startsWith("{") && !t.startsWith("[") && !t.includes(",") && !t.includes(":") && !t.startsWith("<")) return;
    try {
      let rawData;
      try { rawData = JSON.parse(t); } catch { rawData = parseFileContent(t, "Pegado.csv"); if (!rawData.items) throw new Error("no parse"); }
      const parsedGames = normalizeJson(rawData, "Pegado");
      if (parsedGames.length === 0) { showToast("El texto pegado no contiene elementos reconocibles", "warning"); return; }
      e.preventDefault();
      const indexName = (rawData && rawData.name) ? rawData.name : `Pegado ${new Date().toLocaleTimeString()}`;
      if (indexes.some(x=>x.name.toLowerCase()===indexName.toLowerCase())) { showToast("Ya existe una fuente con ese nombre", "warning"); return; }
      indexes.push({ id: Date.now().toString()+Math.random().toString(36).substring(2,7), name: indexName, active:true, rawData, mapping:null, pkg: null, games: parsedGames });
      searchInput.removeAttribute("disabled");
      await saveIndexesToStorage(); updateApp();
      showToast(`Fuente "${indexName}" creada desde portapapeles`, "success");
    } catch {}
  });

  // Export / Import — with selection popups
  function getSelectedIds(container) {
    return Array.from(container.querySelectorAll('input[type="checkbox"]:checked')).map(c=>c.value);
  }
  function fmtCompact(n){
    if (n < 1000) return String(n);
    const k = n/1000;
    if (k >= 100) return Math.round(k) + "k";
    const s = k.toFixed(k >= 10 ? 0 : 1).replace(".", ",").replace(",0", "");
    return s + "k";
  }
  function updateExportUI() {
    const total = indexes.length;
    const checked = exportList.querySelectorAll('input[type="checkbox"]:checked').length;
    exportSelectAll.checked = total>0 && checked===total;
    exportSelectAll.indeterminate = checked>0 && checked<total;
    exportConfirm.textContent = checked===0 ? "Exportar" : `Exportar (${checked})`;
    exportConfirm.disabled = checked===0;
    exportConfirm.style.opacity = checked===0 ? "0.45" : "1";
    exportHint.style.display = checked===0 ? "block" : "none";
    exportHint.textContent = "Selecciona al menos una fuente.";
    if (exportCounter) exportCounter.textContent = `${checked}/${total}`;
  }
  function openExportModal() {
    if (indexes.length===0) { showToast("No hay fuentes para exportar", "warning"); return; }
    exportList.innerHTML = indexes.map(idx=>{
      const count = idx.games.length;
      const full = count.toLocaleString("es-ES");
      const tags = [];
      if (idx.pkg && idx.pkg.slug) tags.push(idx.pkg.name || idx.pkg.slug);
      if (idx.mapping) tags.push("mapeado");
      const status = tags.join(" · ");
      return `<label class="io-item"><input type="checkbox" value="${escapeHtml(idx.id)}" checked /><span class="io-item-dot" aria-hidden="true"></span><span class="io-item-info"><strong>${escapeHtml(idx.name)}</strong><small>${escapeHtml(status)}</small></span><span class="io-item-meta"><span class="io-item-badge" title="${escapeHtml(full)} elementos">${escapeHtml(fmtCompact(count))}</span></span></label>`;
    }).join("");
    exportList.querySelectorAll('input[type="checkbox"]').forEach(cb=> cb.addEventListener("change", updateExportUI));
    updateExportUI();
    exportModal.style.display="flex";
    exportModal.setAttribute("aria-hidden","false");
  }
  window.closeExportModal = function(){ exportModal.style.display="none"; exportModal.setAttribute("aria-hidden","true"); };
  exportSelectAll.addEventListener("change", ()=>{
    const v = exportSelectAll.checked;
    exportList.querySelectorAll('input[type="checkbox"]').forEach(c=>c.checked=v);
    updateExportUI();
  });
  exportConfirm.addEventListener("click", async ()=>{
    const ids = new Set(getSelectedIds(exportList));
    if (ids.size===0) return;
    const selected = indexes.filter(idx=>ids.has(idx.id));
    exportConfirm.disabled = true;
    exportConfirm.textContent = "Comprimiendo…";
    try {
      const compact = compactIndexes(selected.map(idx=>({ name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping, pkg: idx.pkg || null })));
      const json = JSON.stringify(compact);
      let blob, ext;
      if (hasCompressionSupport()) {
        blob = await compressJsonToBlob(json);
        ext = "json.gz";
      } else {
        blob = new Blob([json], {type:"application/json"});
        ext = "json";
      }
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = `indexly-backup-${new Date().toISOString().slice(0,10)}.${ext}`;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
      closeExportModal();
      const prettySize = JSON.stringify(selected.map(idx=>({ id: idx.id, name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping, pkg: idx.pkg || null }), null, 2)).length;
      const savedPct = prettySize ? Math.round((1 - blob.size / prettySize)*100) : 0;
      showToast(`${selected.length} fuente(s) exportadas · ${savedPct}% más pequeño`, "success");
    } catch(err){
      console.error(err);
      showToast(`Error al exportar: ${err.message}`, "error");
    } finally {
      exportConfirm.disabled = false;
      updateExportUI();
    }
  });
  exportModal.addEventListener("click", (e)=>{ if(e.target===exportModal) closeExportModal(); });
  exportBtn.addEventListener("click", openExportModal);

  function updateImportUI() {
    const boxes = Array.from(importSelectList.querySelectorAll('input[type="checkbox"]'));
    const enabled = boxes.filter(c=>!c.disabled);
    const checked = enabled.filter(c=>c.checked).length;
    importSelectAll.checked = enabled.length>0 && checked===enabled.length;
    importSelectAll.indeterminate = checked>0 && checked<enabled.length;
    importSelectConfirm.textContent = checked===0 ? "Importar" : `Importar (${checked})`;
    importSelectConfirm.disabled = checked===0;
    importSelectConfirm.style.opacity = checked===0 ? "0.45" : "1";
    if (importCounter) importCounter.textContent = `${checked}/${enabled.length}`;
    const dupCount = boxes.filter(c=>c.disabled).length;
    if (dupCount>0) { importHint.style.display="block"; importHint.textContent = `${dupCount} ya existe(n) y se omitirá(n).`; }
    else { importHint.style.display="none"; }
  }
  function openImportSelectModal(data) {
    pendingImportData = data;
    const existing = new Set(indexes.map(x=>x.name.toLowerCase()));
    if (data.length===0) { showToast("Backup vacío", "warning"); return; }
    importSelectList.innerHTML = data.map((item, i)=>{
      const name = String(item.name || `Fuente ${i+1}`);
      const isDup = existing.has(name.toLowerCase()) || !item.rawData;
      const reason = !item.rawData ? "sin datos" : "ya existe";
      const count = (()=>{ try{ const p=normalizeJson(item.rawData, name, item.mapping||null); return p.length; } catch{ return 0; } })();
      const full = count.toLocaleString("es-ES");
      const tags = [];
      if (item.pkg && item.pkg.slug) tags.push(item.pkg.name || item.pkg.slug);
      if (isDup) tags.push(reason);
      const status = tags.join(" · ");
      return `<label class="io-item ${isDup ? "is-disabled" : ""}"><input type="checkbox" value="${i}" ${isDup ? "disabled" : "checked"} /><span class="io-item-dot" aria-hidden="true"></span><span class="io-item-info"><strong>${escapeHtml(name)}</strong><small>${escapeHtml(status)}</small></span><span class="io-item-meta"><span class="io-item-badge" title="${escapeHtml(full)} elementos">${escapeHtml(fmtCompact(count))}</span></span></label>`;
    }).join("");
    importSelectList.querySelectorAll('input[type="checkbox"]:not([disabled])').forEach(cb=> cb.addEventListener("change", updateImportUI));
    updateImportUI();
    importSelectModal.style.display="flex";
    importSelectModal.setAttribute("aria-hidden","false");
  }
  window.closeImportSelectModal = function(){ importSelectModal.style.display="none"; importSelectModal.setAttribute("aria-hidden","true"); pendingImportData=null; };
  importSelectAll.addEventListener("change", ()=>{
    const v = importSelectAll.checked;
    importSelectList.querySelectorAll('input[type="checkbox"]:not([disabled])').forEach(c=>c.checked=v);
    updateImportUI();
  });
  importSelectConfirm.addEventListener("click", async ()=>{
    if (!pendingImportData) return;
    const idxs = getSelectedIds(importSelectList).map(Number);
    if (idxs.length===0) return;
    let imported=0; let skipped=[];
    for (const i of idxs) {
      const item = pendingImportData[i];
      if (!item || !item.rawData) { skipped.push(String(item?.name||i)); continue; }
      if (indexes.some(x=>x.name.toLowerCase()===String(item.name).toLowerCase())) { skipped.push(item.name); continue; }
      const parsed = normalizeJson(item.rawData, item.name, item.mapping || null);
      indexes.push({ id: Date.now().toString()+Math.random().toString(36).substring(2,7), name: item.name, active: item.active ?? true, rawData: item.rawData, mapping: item.mapping||null, pkg: item.pkg||null, games: parsed });
      imported++;
    }
    const hadSkipped = skipped.length>0;
    closeImportSelectModal();
    if (imported) { searchInput.removeAttribute("disabled"); await saveIndexesToStorage(); updateApp(); showToast(`${imported} fuente(s) importadas`, "success"); }
    if (hadSkipped) showToast(`Omitidas: ${skipped.join(", ")}`, "warning", 4000);
    if (!imported && !hadSkipped) showToast("Nada que importar", "warning");
  });
  importSelectModal.addEventListener("click", (e)=>{ if(e.target===importSelectModal) closeImportSelectModal(); });
  importBtn.addEventListener("click", () => importInput.click());
  importInput.addEventListener("change", async (e) => {
    const file = e.target.files[0];
    e.target.value = "";
    if (!file) return;
    try {
      const text = await decompressBlobToText(file);
      const parsed = JSON.parse(text);
      let data;
      if (isV2Envelope(parsed)) {
        data = inflateIndexes(parsed);
      } else if (Array.isArray(parsed)) {
        data = migrateV1(parsed);
      } else {
        throw new Error("Backup debe ser un array o envelope v2");
      }
      openImportSelectModal(data);
    } catch(err){ showToast(`Error en backup: ${err.message}`, "error"); }
  });

  // Bulk actions
  document.getElementById("bulk-enable").addEventListener("click", async () => {
    indexes.forEach(i=>i.active=true); await saveIndexesToStorage(); updateApp(); showToast("Todas activadas", "success");
  });
  document.getElementById("bulk-disable").addEventListener("click", async () => {
    indexes.forEach(i=>i.active=false); await saveIndexesToStorage(); updateApp(); showToast("Todas desactivadas", "success");
  });
  document.getElementById("bulk-clear").addEventListener("click", () => {
    if (indexes.length===0) return;
    showConfirm(`¿Borrar todas las fuentes (${indexes.length})? No se puede deshacer en bloque.`, async () => {
      indexes = []; searchInput.value=""; searchInput.setAttribute("disabled","true");
      await saveIndexesToStorage(); updateApp(); showToast("Todas las fuentes borradas", "info");
    });
  });

  window.toggleIndex = async function (id) {
    const idx = indexes.find((i) => i.id === id);
    if (idx) { idx.active = !idx.active; await saveIndexesToStorage(); updateApp(); }
  };
  window.removeIndex = async function (id) {
    const idx = indexes.find(i=>i.id===id);
    if (!idx) return;
    showConfirm(`¿Eliminar “${idx.name}”?`, async () => {
      if (undoTimer) clearTimeout(undoTimer);
      const removedIdx = indexes.findIndex(x=>x.id===id);
      lastRemoved = { data: idx, index: removedIdx };
      indexes = indexes.filter((i) => i.id !== id);
      if (indexes.length === 0) { searchInput.setAttribute("disabled", "true"); searchInput.value = ""; }
      await saveIndexesToStorage(); updateApp();
      showToast(`${idx.name} eliminada`, "info", 6000, {
        label: "Deshacer",
        onClick: async () => {
          if (lastRemoved && lastRemoved.data.id === id) {
            const pos = Math.min(lastRemoved.index, indexes.length);
            indexes.splice(pos, 0, lastRemoved.data);
            lastRemoved = null;
            if (undoTimer) { clearTimeout(undoTimer); undoTimer=null; }
            if (indexes.length>=1) searchInput.removeAttribute("disabled");
            await saveIndexesToStorage(); updateApp();
            showToast("Restaurada", "success");
          }
        }
      });
      undoTimer = setTimeout(()=>{ lastRemoved=null; }, 6500);
    });
  };

  function fillSelect(select, keys, current, includeEmpty) {
    select.innerHTML = "";
    if (includeEmpty) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "— ninguno —";
      select.appendChild(opt);
    }
    for (const k of keys) {
      const opt = document.createElement("option");
      opt.value = k;
      opt.textContent = k;
      if (k === current) opt.selected = true;
      select.appendChild(opt);
    }
  }

  function updateMappingPreview() {
    const idx = indexes.find(i => i.id === mappingModalIndexId);
    if (!idx) return;
    const titleKey = mapTitleSelect.value;
    const linkKey = mapLinkSelect.value;
    const subtitleKey = mapSubtitleSelect.value;
    if (!titleKey) { mappingPreview.textContent = "Selecciona un campo de Título"; return; }
    try {
      const preview = normalizeJson(idx.rawData, idx.name, { titleKey, linkKey: linkKey || null, subtitleKey: subtitleKey || null });
      if (preview.length === 0) mappingPreview.textContent = "Sin elementos con ese mapeo";
      else mappingPreview.textContent = `${preview.length} elementos · ej: "${preview[0].title}"${preview[0].link ? " · con enlace" : ""}`;
    } catch (e) { mappingPreview.textContent = "Error en vista previa"; }
  }

  window.openMappingModal = function(id) {
    const idx = indexes.find(i => i.id === id);
    if (!idx) return;
    mappingModalIndexId = id;
    const keys = getAvailableKeys(idx.rawData);
    if (keys.length === 0) {
      showToast("Sin campos mapeables (array de primitivos)", "warning");
      return;
    }
    mapNameInput.value = idx.name || "";
    const auto = getAutoMapping(idx.rawData);
    const current = idx.mapping || auto;
    fillSelect(mapTitleSelect, keys, current.titleKey || auto.titleKey || keys[0], false);
    fillSelect(mapSubtitleSelect, keys, current.subtitleKey || auto.subtitleKey || "", true);
    fillSelect(mapLinkSelect, keys, current.linkKey || auto.linkKey || "", true);
    updateMappingPreview();
    mappingModal.style.display = "flex";
    mappingModal.setAttribute("aria-hidden", "false");
    setTimeout(() => mapNameInput.focus(), 50);
  };
  window.closeMappingModal = function() {
    mappingModal.style.display = "none";
    mappingModal.setAttribute("aria-hidden", "true");
    mappingModalIndexId = null;
  };
  window.saveMapping = async function() {
    const idx = indexes.find(i => i.id === mappingModalIndexId);
    if (!idx) return;
    const newName = mapNameInput.value.trim();
    if (!newName) { showToast("El nombre no puede estar vacío", "warning"); return; }
    const duplicate = indexes.some(x => x.id !== idx.id && x.name.toLowerCase() === newName.toLowerCase());
    if (duplicate) { showToast(`Ya existe "${newName}"`, "warning"); return; }
    const titleKey = mapTitleSelect.value;
    if (!titleKey) { showToast("Elige Título", "warning"); return; }
    const mapping = { titleKey, subtitleKey: mapSubtitleSelect.value || null, linkKey: mapLinkSelect.value || null };
    idx.name = newName;
    idx.mapping = mapping;
    idx.games = normalizeJson(idx.rawData, idx.name, mapping);
    await saveIndexesToStorage();
    closeMappingModal();
    updateApp();
    showToast("Mapeo actualizado", "success");
  };
  mapTitleSelect.addEventListener("change", updateMappingPreview);
  mapSubtitleSelect.addEventListener("change", updateMappingPreview);
  mapLinkSelect.addEventListener("change", updateMappingPreview);
  mappingModal.addEventListener("click", (e) => { if (e.target === mappingModal) closeMappingModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && mappingModal.style.display !== "none") closeMappingModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && confirmModal.style.display !== "none") closeConfirmModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && exportModal.style.display !== "none") closeExportModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && importSelectModal.style.display !== "none") closeImportSelectModal(); });

  function renderSearch() {
    let activeGames = [];
    indexes.forEach((index) => { if (index.active) activeGames = activeGames.concat(index.games); });
    const rawQ = searchInput.value.trim();
    syncQueryToURL(rawQ);
    const query = normalizeStr(rawQ);
    if (activeFilter==="link") activeGames = activeGames.filter(g=> g.link && g.link.trim());
    else if (activeFilter==="nolink") activeGames = activeGames.filter(g=> !g.link || !g.link.trim());
    let filtered = query === "" ? activeGames : activeGames.filter((g) => getSearchableText(g).includes(query));
    if (sortBy!=="relevance") {
      filtered = [...filtered].sort((a,b)=>{
        if (sortBy==="title-asc") return a.title.localeCompare(b.title);
        if (sortBy==="title-desc") return b.title.localeCompare(a.title);
        if (sortBy==="size-desc") return parseSizeToBytes(b.fileSize||b.meta?.Tamaño||"") - parseSizeToBytes(a.fileSize||a.meta?.Tamaño||"");
        if (sortBy==="size-asc") return parseSizeToBytes(a.fileSize||a.meta?.Tamaño||"") - parseSizeToBytes(b.fileSize||b.meta?.Tamaño||"");
        if (sortBy==="date-desc") return getItemDate(b) - getItemDate(a);
        if (sortBy==="date-asc") return getItemDate(a) - getItemDate(b);
        return 0;
      });
    }
    currentFilteredGames = filtered;
    visibleCount = 50;
    renderCurrentView();
  }
  function updateApp() {
    renderIndexesManager();
    renderSearch();
    updateQuotaInfo();
  }
  // Paquetes (carpetas): agrupan fuentes importadas desde IndexlyHub.
  // Si el paquete trae una sola fuente, se muestra como pill normal, sin carpeta.
  function getPkgCollapsedMap() {
    try { return JSON.parse(localStorage.getItem("indexly_pkg_collapsed") || "{}") || {}; }
    catch { return {}; }
  }
  function isPkgCollapsed(slug) {
    try { return !!getPkgCollapsedMap()[slug]; } catch { return false; }
  }
  window.togglePkgCollapsed = function(slug) {
    try {
      const m = getPkgCollapsedMap();
      m[slug] = !m[slug];
      localStorage.setItem("indexly_pkg_collapsed", JSON.stringify(m));
    } catch {}
    updateApp();
  };
  window.togglePkg = async function (slug) {
    const items = indexes.filter(i => i.pkg && i.pkg.slug === slug);
    if (!items.length) return;
    const target = !items.every(i => i.active);
    items.forEach(i => i.active = target);
    await saveIndexesToStorage(); updateApp();
    showToast(target ? `Paquete "${slug}" activado` : `Paquete "${slug}" desactivado`, "success");
  };
  window.removePkg = async function (slug) {
    const items = indexes.filter(i => i.pkg && i.pkg.slug === slug);
    if (!items.length) return;
    const label = (items[0].pkg && items[0].pkg.name) || slug;
    showConfirm(`¿Eliminar paquete "${label}" (${items.length} fuentes)?`, async () => {
      if (undoTimer) clearTimeout(undoTimer);
      const firstIdx = indexes.findIndex(x => x.pkg && x.pkg.slug === slug);
      lastRemoved = { data: items, index: Math.max(0, firstIdx), isPkg: true };
      const ids = new Set(items.map(i => i.id));
      indexes = indexes.filter(i => !ids.has(i.id));
      if (indexes.length === 0) { searchInput.setAttribute("disabled", "true"); searchInput.value = ""; }
      await saveIndexesToStorage(); updateApp();
      showToast(`Paquete "${label}" eliminado`, "info", 6000, {
        label: "Deshacer",
        onClick: async () => {
          if (lastRemoved && lastRemoved.isPkg && Array.isArray(lastRemoved.data)) {
            const pos = Math.min(lastRemoved.index, indexes.length);
            indexes.splice(pos, 0, ...lastRemoved.data);
            lastRemoved = null;
            if (undoTimer) { clearTimeout(undoTimer); undoTimer = null; }
            if (indexes.length >= 1) searchInput.removeAttribute("disabled");
            await saveIndexesToStorage(); updateApp();
            showToast("Paquete restaurado", "success");
          }
        }
      });
      undoTimer = setTimeout(()=>{ lastRemoved = null; }, 6500);
    });
  };
  function indexPillHtml(index) {
    return `
      <div class="index-pill ${index.active ? "active" : "inactive"}">
        <div class="index-pill-info">
          <span class="status-dot" aria-hidden="true"></span>
          <div class="index-text">
            <strong>${escapeHtml(index.name)}</strong>
            <small>${index.games.length.toLocaleString("es-ES")} elementos${index.mapping ? " · mapeado" : ""}</small>
          </div>
        </div>
        <div class="index-pill-actions">
          <button type="button" class="action-btn map" onclick="openMappingModal('${index.id}')" title="Ajustar mapeo" aria-label="Ajustar ${escapeHtml(index.name)}">⚙</button>
          <button type="button" class="action-btn toggle" onclick="toggleIndex('${index.id}')">${index.active ? "Desactivar" : "Activar"}</button>
          <button type="button" class="action-btn delete" onclick="removeIndex('${index.id}')" aria-label="Eliminar ${escapeHtml(index.name)}">✕</button>
        </div>
      </div>`;
  }
  function renderIndexesManager() {
    if (indexes.length === 0) {
      indexesListContainer.innerHTML = `<div class="empty-state"><div class="empty-icon">◇</div><p class="no-indexes">Sin fuentes aún<br><span>Sube uno o varios archivos para empezar</span></p></div>`;
      bulkActions.style.display = "none";
      return;
    }
    bulkActions.style.display = "flex";
    const groups = new Map();
    const order = [];
    for (const index of indexes) {
      const slug = index.pkg && index.pkg.slug;
      if (!slug) { order.push({ type: "single", index }); continue; }
      if (!groups.has(slug)) { groups.set(slug, { pkg: index.pkg, items: [] }); order.push({ type: "group", slug }); }
      else if (index.pkg && index.pkg.name) { groups.get(slug).pkg = index.pkg; }
      groups.get(slug).items.push(index);
    }
    indexesListContainer.innerHTML = order.map((entry) => {
      if (entry.type === "single") return indexPillHtml(entry.index);
      const g = groups.get(entry.slug);
      if (!g) return "";
      if (g.items.length <= 1) return indexPillHtml(g.items[0]);
      const pkgName = (g.pkg && g.pkg.name) || entry.slug;
      const total = g.items.reduce((a, i) => a + (i.games ? i.games.length : 0), 0);
      const activeCount = g.items.filter(i => i.active).length;
      const allActive = activeCount === g.items.length;
      const noneActive = activeCount === 0;
      const collapsed = isPkgCollapsed(entry.slug);
      const stateCls = allActive ? "active" : (noneActive ? "inactive" : "active");
      const sub = noneActive
        ? `${g.items.length} fuentes · ${total.toLocaleString("es-ES")} elementos · desactivado`
        : (allActive
          ? `${g.items.length} fuentes · ${total.toLocaleString("es-ES")} elementos`
          : `${g.items.length} fuentes · ${total.toLocaleString("es-ES")} elementos · ${activeCount} activas`);
      return `
      <div class="pkg-group ${collapsed ? "collapsed" : ""}">
        <div class="index-pill pkg-header ${stateCls}">
          <button type="button" class="pkg-chevron" onclick="togglePkgCollapsed('${entry.slug}')" aria-expanded="${collapsed ? "false" : "true"}" aria-label="${collapsed ? "Expandir" : "Colapsar"} paquete ${escapeHtml(pkgName)}" title="${collapsed ? "Expandir" : "Colapsar"}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="index-pill-info">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="index-text">
              <strong>${escapeHtml(pkgName)}</strong>
              <small>${escapeHtml(sub)}</small>
            </div>
          </div>
          <div class="index-pill-actions">
            <button type="button" class="action-btn toggle" onclick="togglePkg('${entry.slug}')">${allActive ? "Desactivar" : "Activar"}</button>
            <button type="button" class="action-btn delete" onclick="removePkg('${entry.slug}')" aria-label="Eliminar paquete ${escapeHtml(pkgName)}">✕</button>
          </div>
        </div>
        <div class="pkg-children">${g.items.map(indexPillHtml).join("")}</div>
      </div>`;
    }).join("");
  }

  function renderMetaBadges(meta) {
    if (!meta || Object.keys(meta).length === 0) return "";
    const labelLess = new Set(["tamaño","tamano","filesize","size","uploaddate","upload_date","fechasubida","fecha"]);
    const dateKeys = new Set(["uploaddate","upload_date","fechasubida","fecha"]);
    const entries = Object.entries(meta).slice(0, 3);
    return entries.map(([k,v]) => {
      const lk = k.toLowerCase();
      const isLabelLess = labelLess.has(lk);
      let displayVal = v;
      if (dateKeys.has(lk)) displayVal = formatDateDDMMYY(String(v));
      const text = isLabelLess ? escapeHtml(displayVal) : `${escapeHtml(k)}: ${escapeHtml(displayVal)}`;
      const title = `${escapeHtml(k)}: ${escapeHtml(v)}`;
      return `<span class="meta-badge" title="${title}">${text}</span>`;
    }).join("");
  }

  function renderCurrentView() {
    if (indexes.length === 0) {
      resultsContainer.innerHTML = ""; statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none";
      searchInput.placeholder = "Sube un archivo arriba para empezar…"; return;
    }
    const totalMatches = currentFilteredGames.length;
    searchInput.placeholder = `Buscar entre ${totalMatches.toLocaleString("es-ES")} elementos…`;
    if (totalMatches === 0) {
      const q = searchInput.value.trim();
      resultsContainer.innerHTML = `<div class="empty-results"><p class="no-results">${q ? `Sin resultados para “${escapeHtml(q)}”` : "No hay elementos en las fuentes activas."}</p><span>Prueba otro término o activa más fuentes.</span></div>`;
      statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none"; return;
    }
    statsContainer.innerHTML = `Mostrando <strong>${Math.min(visibleCount, totalMatches).toLocaleString("es-ES")}</strong> de <strong>${totalMatches.toLocaleString("es-ES")}</strong>`;
    const gamesToRender = currentFilteredGames.slice(0, visibleCount);
    resultsContainer.innerHTML = gamesToRender.map((game) => {
      const metaHtml = renderMetaBadges(game.meta);
      const subtitleHtml = game.subtitle ? `<p class="game-subtitle">${escapeHtml(game.subtitle)}</p>` : "";
      const hasMeta = metaHtml || game.fileSize && game.fileSize !== "Tamaño desconocido";
      return `
      <div class="game-card">
        <div class="game-info-container">
          <h3>${escapeHtml(game.title)}</h3>
          ${subtitleHtml}
          <p class="game-meta"><span class="source-badge">${escapeHtml(game.source)}</span>${hasMeta ? metaHtml : ""}</p>
        </div>
        ${game.link ? `<a href="${escapeHtml(game.link)}" target="_blank" rel="noopener" class="magnet-link">Abrir <span aria-hidden="true">↗</span></a>` : '<span class="no-magnet">Sin enlace</span>'}
      </div>`;
    }).join("");
    loadMoreBtn.style.display = visibleCount < totalMatches ? "inline-flex" : "none";
  }
  searchInput.addEventListener("input", () => renderSearch());
  loadMoreBtn.addEventListener("click", () => { visibleCount += 50; renderCurrentView(); });
  // Sort & filter
  const sortSelect = document.getElementById("sort-select");
  const quotaInfo = document.getElementById("quota-info");
  sortSelect.addEventListener("change", (e) => { sortBy = e.target.value; renderSearch(); });
  document.querySelectorAll(".chip").forEach(btn=> btn.addEventListener("click", () => {
    document.querySelectorAll(".chip").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    activeFilter = btn.dataset.filter;
    renderSearch();
  }));
  async function updateQuotaInfo() {
    try {
      if (navigator.storage && navigator.storage.estimate) {
        const est = await navigator.storage.estimate();
        if (est.quota && est.usage) {
          const pct = Math.round((est.usage/est.quota)*100);
          const usedMB = (est.usage/1024/1024).toFixed(1);
          if (pct>75) quotaInfo.textContent = `Almacenamiento: ${usedMB} MB (${pct}%)`;
          else quotaInfo.textContent = "";
        }
      }
    } catch {}
  }
  // Collapse fuentes
  let fuentesCollapsed = localStorage.getItem("indexly_fuentes_collapsed") === "1";
  function applyFuentesCollapsed(v) {
    fuentesCollapsed = v;
    fuentesCard.classList.toggle("collapsed", v);
    if (collapseBtn) {
      collapseBtn.setAttribute("aria-expanded", String(!v));
      collapseBtn.setAttribute("aria-label", v ? "Expandir fuentes" : "Comprimir fuentes");
      collapseBtn.title = v ? "Expandir" : "Comprimir";
    }
    localStorage.setItem("indexly_fuentes_collapsed", v ? "1" : "0");
  }
  if (collapseBtn) {
    applyFuentesCollapsed(fuentesCollapsed);
    collapseBtn.addEventListener("click", () => applyFuentesCollapsed(!fuentesCard.classList.contains("collapsed")));
  }
  document.addEventListener("keydown", (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if ((e.key === "/" && document.activeElement !== searchInput && document.activeElement !== mapNameInput && document.activeElement !== hubSearch && document.activeElement !== hubTokenInput && !mod) || (mod && e.key.toLowerCase() === "k")) {
      e.preventDefault(); searchInput.focus();
    }
  });
  // ---- IndexlyHub: conexión + explorar + importar + favoritos ----
  const HUB_API = "https://indexlyhub.daida.net/api/v1";
  const hubConnectBtn = document.getElementById("hub-connect-btn");
  const hubConnectLabel = document.getElementById("hub-connect-label");
  const hubUploadLink = document.getElementById("hub-upload-link");
  const hubCardBtn = document.getElementById("hub-card-btn");
  const hubStatus = document.getElementById("hub-status");
  const hubDesc = document.getElementById("hub-desc");
  const hubOffline = document.getElementById("hub-offline");
  const hubOnline = document.getElementById("hub-online");
  const hubList = document.getElementById("hub-list");
  const hubMore = document.getElementById("hub-more");
  const hubSearch = document.getElementById("hub-search");
  const hubModal = document.getElementById("hub-modal");
  const hubTokenInput = document.getElementById("hub-token");
  const hubSaveBtn = document.getElementById("hub-save");
  const hubDisconnectBtn = document.getElementById("hub-disconnect");
  const footerNote = document.getElementById("footer-note");
  const FOOTER_DEFAULT = "Todo se guarda localmente. Nada se envía a servidores.";
  const FOOTER_HUB = "Tus archivos siguen en local. Explorar e importar usa la API de IndexlyHub.";
  const HUB_CACHE_MS = 3 * 60 * 1000;

  let hubToken = null;
  try { hubToken = localStorage.getItem("indexly_hub_token") || null; } catch {}
  let hubTab = "popular";
  let hubPage = 1;
  let hubQuery = "";
  let hubLoading = false;
  const hubCache = new Map();
  const hubSeen = new Map();

  function hubTokenPrefix() {
    if (!hubToken) return "";
    return hubToken.length > 11 ? hubToken.slice(0, 11) + "…" : hubToken;
  }
  function updateHubUI() {
    const on = !!hubToken;
    if (hubConnectLabel) hubConnectLabel.textContent = on ? ("Hub · " + hubTokenPrefix()) : "Conectar Hub";
    if (hubConnectBtn) {
      hubConnectBtn.classList.toggle("connected", on);
      hubConnectBtn.title = on ? ("Conectado (" + hubTokenPrefix() + ") — clic para desconectar") : "Conectar tu API de IndexlyHub";
    }
    if (hubUploadLink) hubUploadLink.style.display = on ? "" : "none";
    if (hubCardBtn) hubCardBtn.textContent = on ? "Cambiar" : "Conectar";
    if (hubStatus) { hubStatus.textContent = on ? "conectado" : "desconectado"; hubStatus.classList.toggle("on", on); }
    if (hubDesc) hubDesc.textContent = on ? "Paquetes populares, recientes y tus favoritos" : "Explora paquetes de la comunidad";
    if (hubOffline) hubOffline.style.display = on ? "none" : "";
    if (hubOnline) hubOnline.style.display = on ? "" : "none";
    if (footerNote) footerNote.textContent = on ? FOOTER_HUB : FOOTER_DEFAULT;
    if (!on) {
      if (hubList) hubList.innerHTML = "";
      if (hubMore) hubMore.style.display = "none";
    }
  }
  function hubDisconnect(quiet) {
    hubToken = null;
    try { localStorage.removeItem("indexly_hub_token"); } catch {}
    hubCache.clear();
    hubSeen.clear();
    updateHubUI();
    if (!quiet) showToast("Desconectado del Hub", "info");
  }
  window.openHubModal = function() {
    if (hubTokenInput) hubTokenInput.value = "";
    if (hubDisconnectBtn) hubDisconnectBtn.style.display = hubToken ? "" : "none";
    hubModal.style.display = "flex";
    hubModal.setAttribute("aria-hidden", "false");
    setTimeout(() => { try { hubTokenInput.focus(); } catch {} }, 50);
  };
  window.closeHubModal = function() {
    hubModal.style.display = "none";
    hubModal.setAttribute("aria-hidden", "true");
  };
  hubModal.addEventListener("click", (e) => { if (e.target === hubModal) closeHubModal(); });
  function hubToggleConnect() {
    if (hubToken) {
      showConfirm(`¿Desconectar del Hub (${hubTokenPrefix()})?`, () => { hubDisconnect(false); closeHubModal(); });
    } else {
      openHubModal();
    }
  }
  if (hubConnectBtn) hubConnectBtn.addEventListener("click", hubToggleConnect);
  if (hubCardBtn) hubCardBtn.addEventListener("click", hubToggleConnect);
  if (hubDisconnectBtn) hubDisconnectBtn.addEventListener("click", () => { hubDisconnect(false); closeHubModal(); });
  if (hubTokenInput) hubTokenInput.addEventListener("keydown", (e) => { if (e.key === "Enter") hubSaveBtn.click(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && hubModal.style.display !== "none") closeHubModal(); });

  async function hubVerifyToken(token) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 15000);
    try {
      const res = await fetch(HUB_API + "/favorites", { signal: ctrl.signal, headers: { "Authorization": "Bearer " + token } });
      if (res.status === 401) throw new Error("Token no válido o revocado");
      if (!res.ok) throw new Error(`El Hub respondió ${res.status}`);
      return true;
    } finally { clearTimeout(timer); }
  }
  hubSaveBtn.addEventListener("click", async () => {
    const t = hubTokenInput.value.trim();
    if (!t) { showToast("Pega tu token ih_…", "warning"); return; }
    hubSaveBtn.disabled = true;
    hubSaveBtn.textContent = "Verificando…";
    try {
      await hubVerifyToken(t);
      hubToken = t;
      try { localStorage.setItem("indexly_hub_token", t); } catch {}
      closeHubModal();
      updateHubUI();
      showToast("Conectado al Hub", "success");
      hubLoad(true);
    } catch (err) {
      console.error(err);
      showToast(err.name === "AbortError" ? "El Hub no responde (timeout)" : err.message, "error", 5000);
    } finally {
      hubSaveBtn.disabled = false;
      hubSaveBtn.textContent = "Conectar";
    }
  });

  async function hubFetch(path, opts) {
    opts = opts || {};
    if (!hubToken) throw new Error("Conecta tu API del Hub primero");
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 20000);
    try {
      const res = await fetch(HUB_API + path, { ...opts, signal: ctrl.signal, headers: { ...((opts && opts.headers) || {}), "Authorization": "Bearer " + hubToken } });
      const json = await res.json().catch(() => null);
      if (res.status === 401) { hubDisconnect(true); throw new Error("Token no válido o revocado"); }
      if (res.status === 429) throw new Error("Límite del Hub alcanzado, espera un minuto");
      if (!res.ok || !json || json.success !== true) throw new Error((json && json.error && json.error.message) || `El Hub respondió ${res.status}`);
      return json;
    } finally { clearTimeout(timer); }
  }
  async function fetchHubJson(url) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 25000);
    try {
      const res = await fetch(url, { signal: ctrl.signal, headers: { accept: "application/json, application/gzip, */*" } });
      if (!res.ok) throw new Error(`Descarga falló (HTTP ${res.status})`);
      const blob = await res.blob();
      const text = await decompressBlobToText(blob);
      return JSON.parse(text);
    } finally { clearTimeout(timer); }
  }
  function sanitizePkgSlug(s, fallback) {
    const clean = String(s || "").replace(/[^a-zA-Z0-9áéíóúñüÁÉÍÓÚÑÜ _.\-]/g, "").trim().slice(0, 60);
    return clean || fallback;
  }

  document.querySelectorAll("[data-hubtab]").forEach(btn => btn.addEventListener("click", () => {
    document.querySelectorAll("[data-hubtab]").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    hubTab = btn.dataset.hubtab;
    hubLoad(true);
  }));
  hubSearch.addEventListener("input", debounce(() => { hubQuery = hubSearch.value.trim(); hubLoad(true); }, 350));
  hubMore.addEventListener("click", () => { hubPage++; hubLoad(false); });

  function hubItemHtml(p) {
    if (p.fav) {
      const safeFavSlug = p.favSlug && /^[a-z0-9-]+$/.test(p.favSlug) ? p.favSlug : null;
      const canImport = !!safeFavSlug;
      if (canImport) hubSeen.set(safeFavSlug, { slug: safeFavSlug, name: p.favTitle });
      return `<div class="io-item hub-item">`
        + `<span class="io-item-dot" aria-hidden="true"></span>`
        + `<span class="io-item-info"><strong>${escapeHtml(p.favTitle)}</strong><small>${escapeHtml(p.favPkg || "")}</small></span>`
        + `<span class="io-item-meta">`
        + (canImport ? `<button type="button" class="action-btn secondary" onclick="hubImport('${escapeHtml(safeFavSlug)}')">Importar</button>` : "")
        + `<button type="button" class="action-btn map hub-star on" data-link="${encodeURIComponent(p.favLink)}" data-title="${escapeHtml(p.favTitle)}" onclick="hubToggleFavLink(this)" title="Quitar de favoritos">★</button>`
        + `</span></div>`;
    }
    hubSeen.set(p.slug, p);
    const count = Number(p.itemCount || 0);
    const author = p.author && (p.author.githubLogin || p.author.login) ? "@" + (p.author.githubLogin || p.author.login) : "";
    const sub = [author, p.version ? ("v" + p.version) : ""].filter(Boolean).join(" · ");
    return `<div class="io-item hub-item">`
      + `<span class="io-item-dot" aria-hidden="true"></span>`
      + `<span class="io-item-info"><strong>${escapeHtml(p.name)}</strong><small>${escapeHtml(sub)}</small></span>`
      + `<span class="io-item-meta"><span class="io-item-badge" title="${count.toLocaleString("es-ES")} elementos">${escapeHtml(fmtCompact(count))}</span>`
      + `<button type="button" class="action-btn secondary" onclick="hubImport('${escapeHtml(p.slug)}')">Importar</button>`
      + `<button type="button" class="action-btn map hub-star" data-slug="${escapeHtml(p.slug)}" onclick="hubToggleFav(this)" title="Añadir a favoritos">☆</button>`
      + `</span></div>`;
  }
  function renderHubList(items, hasMore) {
    if (!items.length) {
      hubList.innerHTML = `<p class="hub-empty">Sin resultados. Prueba otro término o pestaña.</p>`;
      hubMore.style.display = "none";
      return;
    }
    hubList.innerHTML = items.map(hubItemHtml).join("");
    hubMore.style.display = hasMore ? "inline-flex" : "none";
  }
  async function hubLoad(reset) {
    if (!hubToken || hubLoading) return;
    if (reset) hubPage = 1;
    const key = hubTab + "|" + hubQuery;
    if (reset) {
      const hit = hubCache.get(key);
      if (hit && Date.now() - hit.at < HUB_CACHE_MS) { renderHubList(hit.items, hit.hasMore); return; }
      hubList.innerHTML = `<p class="hub-loading">Cargando paquetes…</p>`;
      hubMore.style.display = "none";
    }
    hubLoading = true;
    try {
      let items, hasMore;
      if (hubTab === "favs") {
        const json = await hubFetch("/favorites");
        items = (json.data || []).map(f => ({
          fav: true,
          favTitle: String(f.item_title || "Sin título"),
          favLink: String(f.item_link || ""),
          favSlug: String(f.item_link || "").startsWith("package:") ? String(f.item_link).slice(8) : null,
          favPkg: String(f.package_slug || "")
        }));
        hasMore = false;
      } else if (hubQuery) {
        const json = await hubFetch(`/packages?q=${encodeURIComponent(hubQuery)}&page=${hubPage}&pageSize=10`);
        items = json.data || [];
        hasMore = !!(json.meta && json.meta.hasMore);
      } else {
        const sort = hubTab === "popular" ? "downloads" : "recent";
        const json = await hubFetch(`/packages?sort=${sort}&page=${hubPage}&pageSize=10`);
        items = json.data || [];
        hasMore = !!(json.meta && json.meta.hasMore);
      }
      if (reset) {
        hubCache.set(key, { items: items.slice(), hasMore, at: Date.now() });
        renderHubList(items, hasMore);
      } else {
        const prev = hubCache.get(key) || { items: [], hasMore: false, at: Date.now() };
        const merged = prev.items.concat(items);
        hubCache.set(key, { items: merged, hasMore, at: Date.now() });
        renderHubList(merged, hasMore);
      }
    } catch (err) {
      console.error(err);
      if (reset) hubList.innerHTML = `<p class="hub-error">Error: ${escapeHtml(err.message)}</p>`;
      else showToast(err.message, "error");
    } finally { hubLoading = false; }
  }

  window.hubToggleFav = async function(btn) {
    const slug = btn.dataset.slug;
    const meta = hubSeen.get(slug) || { slug, name: slug };
    const isFav = btn.dataset.fav === "1";
    btn.disabled = true;
    try {
      if (isFav) {
        await hubFetch(`/favorites?item_link=${encodeURIComponent("package:" + slug)}`, { method: "DELETE" });
        btn.dataset.fav = "0";
        btn.textContent = "☆";
        btn.classList.remove("on");
        btn.title = "Añadir a favoritos";
      } else {
        await hubFetch("/favorites", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ package_slug: slug, item_title: meta.name || slug, item_link: "package:" + slug }) });
        btn.dataset.fav = "1";
        btn.textContent = "★";
        btn.classList.add("on");
        btn.title = "Quitar de favoritos";
        showToast("Añadido a favoritos", "success");
      }
      hubCache.clear();
    } catch (err) { showToast(err.message, "error"); }
    finally { btn.disabled = false; }
  };
  window.hubToggleFavLink = async function(btn) {
    const link = decodeURIComponent(btn.dataset.link || "");
    const title = btn.dataset.title || "favorito";
    if (!link) return;
    btn.disabled = true;
    try {
      await hubFetch(`/favorites?item_link=${encodeURIComponent(link)}`, { method: "DELETE" });
      const row = btn.closest(".hub-item");
      if (row) row.remove();
      hubCache.clear();
      showToast(`"${title}" quitado de favoritos`, "info");
      if (hubTab === "favs" && !hubList.querySelector(".hub-item")) hubLoad(true);
    } catch (err) { showToast(err.message, "error"); }
    finally { btn.disabled = false; }
  };

  window.hubImport = async function(slug) {
    if (!hubToken) { openHubModal(); return; }
    const meta = hubSeen.get(slug) || { slug, name: slug };
    showToast(`Importando "${meta.name || slug}"…`, "info");
    try {
      const r = await hubFetch(`/packages/${encodeURIComponent(slug)}/raw`);
      const d = r.data || {};
      let rawData = d.rawData;
      if (d.r2_url && rawData === undefined) rawData = await fetchHubJson(d.r2_url);
      if (rawData === undefined) throw new Error("Paquete sin contenido");
      const outerPkg = { slug, name: String(meta.name || slug).slice(0, 100), version: meta.version || null, r2Url: d.r2_url || null };
      let entries;
      if (isV2Envelope(rawData)) {
        entries = inflateIndexes(rawData)
          .filter(it => it && it.rawData)
          .map(it => ({ name: String(it.name || outerPkg.name), active: it.active ?? true, mapping: it.mapping || null, rawData: it.rawData, pkg: it.pkg || outerPkg }));
      } else {
        const mapping = (meta.indexly && meta.indexly.mapping) || null;
        entries = [{ name: outerPkg.name, active: true, mapping, rawData, pkg: outerPkg }];
      }
      if (!entries.length) throw new Error("El paquete no contiene fuentes");
      try { await hubFetch(`/packages/${encodeURIComponent(slug)}/download`, { method: "POST" }); } catch {}
      openImportSelectModal(entries);
    } catch (err) {
      console.error(err);
      showToast(`No se pudo importar: ${err.message}`, "error", 5000);
    }
  };

  // Deep-link del Hub (?import=<url>&name=<slug>&mapping=<json>): descarga y abre el modal de importación normal.
  async function handleHubImport() {
    let params;
    try { params = new URLSearchParams(window.location.search); } catch { return; }
    const importUrl = params.get("import");
    if (!importUrl) return;
    const slugHint = params.get("name") || "";
    let mappingHint = null;
    try {
      const m = JSON.parse(params.get("mapping") || "null");
      if (m && typeof m === "object") mappingHint = { titleKey: m.titleKey || null, subtitleKey: m.subtitleKey || null, linkKey: m.linkKey || null };
    } catch {}
    try {
      const clean = new URL(window.location.href);
      clean.searchParams.delete("import");
      clean.searchParams.delete("name");
      clean.searchParams.delete("mapping");
      history.replaceState(null, "", clean);
    } catch {}
    let fileUrl;
    try { fileUrl = new URL(importUrl); } catch { showToast("Enlace de importación inválido", "error"); return; }
    if (fileUrl.protocol !== "http:" && fileUrl.protocol !== "https:") { showToast("Enlace de importación inválido", "error"); return; }
    const slug = sanitizePkgSlug(slugHint, "hub");
    showToast(`Importando paquete "${slug}"…`, "info");
    try {
      const raw = await fetchHubJson(fileUrl.toString());
      const outerPkg = { slug, name: (slugHint || slug).slice(0, 100), version: null, r2Url: fileUrl.toString() };
      let entries;
      if (isV2Envelope(raw)) {
        entries = inflateIndexes(raw)
          .filter(it => it && it.rawData)
          .map(it => ({ name: String(it.name || outerPkg.name), active: it.active ?? true, mapping: it.mapping || null, rawData: it.rawData, pkg: it.pkg || outerPkg }));
      } else {
        entries = [{ name: outerPkg.name, active: true, mapping: mappingHint, rawData: raw, pkg: outerPkg }];
      }
      if (!entries.length) throw new Error("El paquete no contiene fuentes");
      openImportSelectModal(entries);
    } catch (err) {
      console.error(err);
      showToast(err.name === "AbortError" ? "La descarga agotó el tiempo" : `No se pudo importar: ${err.message}`, "error", 5000);
    }
  }

  loadStoredIndexes().then(() => {
    updateHubUI();
    if (hubToken) hubLoad(true);
    handleHubImport();
  }).catch(() => {
    updateHubUI();
    handleHubImport();
  });
</script>

<style>
  .Search {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .index-manager-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .index-manager-card.drag-over { border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .manager-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
