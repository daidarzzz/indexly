  @media (max-width: 640px) { :global(.toast-container) { left: 12px; right: 12px; bottom: 14px; align-items: stretch; } :global(.toast) { max-width: none; } }
  /* Modals — minimal, no animation */
  .mapping-overlay {
    position: fixed; inset: 0; background: rgba(3,6,12,0.62); backdrop-filter: blur(6px) saturate(110%);
    display: flex; align-items: center; justify-content: center; z-index: 50; padding: var(--space-4);
  }
  .mapping-dialog {
    background: #0f141e; border: 1px solid #1e293b; border-radius: 14px;
    padding: 22px; max-width: 400px; width: 100%;
    box-shadow: 0 16px 40px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.03) inset;
    display: flex; flex-direction: column; gap: 16px;
  }
  .mapping-header { display: flex; justify-content: space-between; align-items: center; }
  .mapping-header h4 { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: -0.01em; color: #f1f5f9; }
  .mapping-close { background: transparent; border: 1px solid #1e293b; border-radius: 999px; width: 26px; height: 26px; display: grid; place-items: center; cursor: pointer; color: #64748b; font-size: 11px; line-height: 1; }
  .mapping-close:hover { background: #152033; color: #e2e8f0; border-color: #24344f; }
  .mapping-desc { margin: 0; font-size: 12px; color: #94a3b8; line-height: 1.5; }
  .mapping-fields { display: flex; flex-direction: column; gap: 12px; }
  .mapping-label { display: flex; flex-direction: column; gap: 6px; font-size: 11px; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; color: #94a3b8; }
  .mapping-label select, .mapping-input { background: #070a12; border: 1px solid #1e293b; border-radius: 8px; padding: 9px 10px; color: #e2e8f0; font-size: 13px; font-weight: 400; text-transform: none; letter-spacing: 0; }
  .mapping-label select:focus, .mapping-input:focus { outline: none; border-color: #24344f; box-shadow: 0 0 0 3px rgba(14,165,233,0.08); }
