    exportConfirm.textContent = "Comprimiendo…";
    try {
      const compact = compactIndexes(selected.map(idx=>({ name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping, pkg: idx.pkg || null })));
      const json = JSON.stringify(compact);
      let blob, ext;
      if (hasCompressionSupport()) {
        blob = await compressJsonToBlob(json);
        ext = "json.gz";
      } else {
        blob = new Blob([json], {type:"application/json"});
        ext = "json";
      }
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = `indexly-backup-${new Date().toISOString().slice(0,10)}.${ext}`;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
      closeExportModal();
      const prettySize = JSON.stringify(selected.map(idx=>({ id: idx.id, name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping, pkg: idx.pkg || null }), null, 2)).length;
      const savedPct = prettySize ? Math.round((1 - blob.size / prettySize)*100) : 0;
