  let lastEmittedQuery = null;
  function renderSearch() {
    let activeGames = [];
    indexes.forEach((index) => { if (index.active) activeGames = activeGames.concat(index.games); });
    const rawQ = searchInput.value.trim();
    if (rawQ !== lastEmittedQuery) { lastEmittedQuery = rawQ; pluginRuntime.emit("query:change", { query: rawQ }); }
    syncQueryToURL(rawQ);
    const query = normalizeStr(rawQ);
    // v2: filtros de búsqueda registrados por plugins. Sin filtros → pipeline idéntico.
    if (pluginRuntime.searchFilters.length) {
      activeGames = pluginRuntime.searchFilters.reduce((acc, f) => {
        try { const out = f.fn(acc); return Array.isArray(out) ? out : acc; }
        catch (err) { console.error("[IndexLy] searchFilter de \"" + f.pluginId + "\":", err); return acc; }
      }, activeGames);
    }
    if (activeFilter==="link") activeGames = activeGames.filter(g=> g.link && g.link.trim());
    else if (activeFilter==="nolink") activeGames = activeGames.filter(g=> !g.link || !g.link.trim());
    else if (typeof activeFilter==="string" && activeFilter.startsWith("plx:")) {
      const chip = pluginRuntime.chips.find(c => c.id === activeFilter.slice(4));
      if (chip && chip.test) {
        activeGames = activeGames.filter(g => { try { return !!chip.test(g); } catch (err) { console.error("[IndexLy] Chip de plugin:", err); return false; } });
      }
    }
    let filtered = query === "" ? activeGames : activeGames.filter((g) => getSearchableText(g).includes(query));
    if (sortBy!=="relevance") {
      filtered = [...filtered].sort((a,b)=>{
        if (sortBy==="title-asc") return a.title.localeCompare(b.title);
        if (sortBy==="title-desc") return b.title.localeCompare(a.title);
        if (sortBy==="size-desc") return parseSizeToBytes(b.fileSize||b.meta?.Tamaño||"") - parseSizeToBytes(a.fileSize||a.meta?.Tamaño||"");
        if (sortBy==="size-asc") return parseSizeToBytes(a.fileSize||a.meta?.Tamaño||"") - parseSizeToBytes(b.fileSize||b.meta?.Tamaño||"");
        if (sortBy==="date-desc") return getItemDate(b) - getItemDate(a);
        if (sortBy==="date-asc") return getItemDate(a) - getItemDate(b);
        return 0;
      });
    }
    currentFilteredGames = filtered;
    visibleCount = 50;
    renderCurrentView();
  }
