  async function hubVerifyToken(token) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 15000);
    try {
      const res = await fetch(HUB_API + "/favorites", { signal: ctrl.signal, headers: { "Authorization": "Bearer " + token } });
      if (res.status === 401) throw new Error("Token no válido o revocado");
      if (!res.ok) throw new Error(`El Hub respondió ${res.status}`);
      return true;
    } finally { clearTimeout(timer); }
  }
  hubSaveBtn.addEventListener("click", async () => {
    const t = hubTokenInput.value.trim();
    if (!t) { showToast("Pega tu token ih_…", "warning"); return; }
    hubSaveBtn.disabled = true;
    hubSaveBtn.textContent = "Verificando…";
    try {
      await hubVerifyToken(t);
      hubToken = t;
      try { localStorage.setItem("indexly_hub_token", t); } catch {}
      closeHubModal();
      updateHubUI();
      showToast("Conectado al Hub", "success");
      hubLoad(true);
    } catch (err) {
      console.error(err);
      showToast(err.name === "AbortError" ? "El Hub no responde (timeout)" : err.message, "error", 5000);
    } finally {
      hubSaveBtn.disabled = false;
      hubSaveBtn.textContent = "Conectar";
    }
  });

  async function hubFetch(path, opts) {
    opts = opts || {};
    if (!hubToken) throw new Error("Conecta tu API del Hub primero");
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 20000);
    try {
      const res = await fetch(HUB_API + path, { ...opts, signal: ctrl.signal, headers: { ...((opts && opts.headers) || {}), "Authorization": "Bearer " + hubToken } });
      const json = await res.json().catch(() => null);
      if (res.status === 401) { hubDisconnect(true); throw new Error("Token no válido o revocado"); }
      if (res.status === 429) throw new Error("Límite del Hub alcanzado, espera un minuto");
      if (!res.ok || !json || json.success !== true) throw new Error((json && json.error && json.error.message) || `El Hub respondió ${res.status}`);
      return json;
    } finally { clearTimeout(timer); }
  }
  async function fetchHubJson(url) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 25000);
    try {
      const res = await fetch(url, { signal: ctrl.signal, headers: { accept: "application/json, application/gzip, */*" } });
      if (!res.ok) throw new Error(`Descarga falló (HTTP ${res.status})`);
      const blob = await res.blob();
      const text = await decompressBlobToText(blob);
      return JSON.parse(text);
    } finally { clearTimeout(timer); }
  }
  function sanitizePkgSlug(s, fallback) {
    const clean = String(s || "").replace(/[^a-zA-Z0-9áéíóúñüÁÉÍÓÚÑÜ _.\-]/g, "").trim().slice(0, 60);
    return clean || fallback;
  }

  document.querySelectorAll("[data-hubtab]").forEach(btn => btn.addEventListener("click", () => {
    document.querySelectorAll("[data-hubtab]").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    hubTab = btn.dataset.hubtab;
    hubLoad(true);
  }));
  hubSearch.addEventListener("input", debounce(() => { hubQuery = hubSearch.value.trim(); hubLoad(true); }, 350));
  hubMore.addEventListener("click", () => { hubPage++; hubLoad(false); });

  function hubItemHtml(p) {
    if (p.fav) {
      const safeFavSlug = p.favSlug && /^[a-z0-9-]+$/.test(p.favSlug) ? p.favSlug : null;
      const canImport = !!safeFavSlug;
      if (canImport) hubSeen.set(safeFavSlug, { slug: safeFavSlug, name: p.favTitle });
      return `<div class="io-item hub-item">`
        + `<span class="io-item-dot" aria-hidden="true"></span>`
        + `<span class="io-item-info"><strong>${escapeHtml(p.favTitle)}</strong><small>${escapeHtml(p.favPkg || "")}</small></span>`
        + `<span class="io-item-meta">`
        + (canImport ? `<button type="button" class="action-btn secondary" onclick="hubImport('${escapeHtml(safeFavSlug)}')">Importar</button>` : "")
        + `<button type="button" class="action-btn map hub-star on" data-link="${encodeURIComponent(p.favLink)}" data-title="${escapeHtml(p.favTitle)}" onclick="hubToggleFavLink(this)" title="Quitar de favoritos">★</button>`
        + `</span></div>`;
    }
    hubSeen.set(p.slug, p);
    const count = Number(p.itemCount || 0);
    const author = p.author && (p.author.githubLogin || p.author.login) ? "@" + (p.author.githubLogin || p.author.login) : "";
    const sub = [author, p.version ? ("v" + p.version) : ""].filter(Boolean).join(" · ");
    const isPluginTab = hubTab === "plugins";
    const mainBtn = isPluginTab
      ? `<button type="button" class="action-btn secondary" onclick="hubInstallPlugin('${escapeHtml(p.slug)}')">Instalar</button>`
      : `<button type="button" class="action-btn secondary" onclick="hubImport('${escapeHtml(p.slug)}')">Importar</button>`;
    return `<div class="io-item hub-item">`
      + `<span class="io-item-dot" aria-hidden="true"></span>`
      + `<span class="io-item-info"><strong>${escapeHtml(p.name)}</strong><small>${escapeHtml(sub)}</small></span>`
      + `<span class="io-item-meta"><span class="io-item-badge" title="${count.toLocaleString("es-ES")} elementos">${escapeHtml(fmtCompact(count))}</span>`
      + mainBtn
      + `<button type="button" class="action-btn map hub-star" data-slug="${escapeHtml(p.slug)}" onclick="hubToggleFav(this)" title="Añadir a favoritos">☆</button>`
      + `</span></div>`;
  }
  function renderHubList(items, hasMore) {
    if (!items.length) {
      hubList.innerHTML = `<p class="hub-empty">Sin resultados. Prueba otro término o pestaña.</p>`;
      hubMore.style.display = "none";
      return;
    }
    hubList.innerHTML = items.map(hubItemHtml).join("");
    hubMore.style.display = hasMore ? "inline-flex" : "none";
  }
  async function hubLoad(reset) {
    if (!hubToken || hubLoading) return;
    if (reset) hubPage = 1;
    const key = hubTab + "|" + hubQuery;
    if (reset) {
      const hit = hubCache.get(key);
      if (hit && Date.now() - hit.at < HUB_CACHE_MS) { renderHubList(hit.items, hit.hasMore); return; }
      hubList.innerHTML = `<p class="hub-loading">Cargando paquetes…</p>`;
      hubMore.style.display = "none";
    }
    hubLoading = true;
    try {
      let items, hasMore;
      if (hubTab === "favs") {
        const json = await hubFetch("/favorites");
        items = (json.data || []).map(f => ({
          fav: true,
          favTitle: String(f.item_title || "Sin título"),
          favLink: String(f.item_link || ""),
          favSlug: String(f.item_link || "").startsWith("package:") ? String(f.item_link).slice(8) : null,
          favPkg: String(f.package_slug || "")
        }));
        hasMore = false;
      } else if (hubTab === "plugins") {
        // kind=plugin (migración aplicada); fallback tags=plugin (pendiente, el wizard etiqueta 'plugin')
        const attempts = ["kind=plugin&", "tags=plugin&"];
        let lastErr = null;
        items = null;
        for (const attempt of attempts) {
          try {
            const json = await hubFetch(`/packages?${attempt}sort=downloads&page=${hubPage}&pageSize=10`);
            items = json.data || [];
            hasMore = !!(json.meta && json.meta.hasMore);
            break;
          } catch (err) { lastErr = err; }
        }
        if (items === null) throw (lastErr || new Error("No se pudo listar plugins"));
      } else if (hubQuery) {
        const json = await hubFetch(`/packages?q=${encodeURIComponent(hubQuery)}&page=${hubPage}&pageSize=10`);
        items = json.data || [];
        hasMore = !!(json.meta && json.meta.hasMore);
      } else {
        const sort = hubTab === "popular" ? "downloads" : "recent";
        const json = await hubFetch(`/packages?sort=${sort}&page=${hubPage}&pageSize=10`);
        items = json.data || [];
        hasMore = !!(json.meta && json.meta.hasMore);
      }
      if (reset) {
        hubCache.set(key, { items: items.slice(), hasMore, at: Date.now() });
        renderHubList(items, hasMore);
      } else {
        const prev = hubCache.get(key) || { items: [], hasMore: false, at: Date.now() };
        const merged = prev.items.concat(items);
        hubCache.set(key, { items: merged, hasMore, at: Date.now() });
        renderHubList(merged, hasMore);
      }
    } catch (err) {
      console.error(err);
      if (reset) hubList.innerHTML = `<p class="hub-error">Error: ${escapeHtml(err.message)}</p>`;
      else showToast(err.message, "error");
    } finally { hubLoading = false; }
  }

  window.hubToggleFav = async function(btn) {
    const slug = btn.dataset.slug;
    const meta = hubSeen.get(slug) || { slug, name: slug };
    const isFav = btn.dataset.fav === "1";
    btn.disabled = true;
    try {
      if (isFav) {
        await hubFetch(`/favorites?item_link=${encodeURIComponent("package:" + slug)}`, { method: "DELETE" });
        btn.dataset.fav = "0";
        btn.textContent = "☆";
        btn.classList.remove("on");
        btn.title = "Añadir a favoritos";
      } else {
        await hubFetch("/favorites", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ package_slug: slug, item_title: meta.name || slug, item_link: "package:" + slug }) });
        btn.dataset.fav = "1";
        btn.textContent = "★";
        btn.classList.add("on");
        btn.title = "Quitar de favoritos";
        showToast("Añadido a favoritos", "success");
      }
      hubCache.clear();
    } catch (err) { showToast(err.message, "error"); }
    finally { btn.disabled = false; }
  };
  window.hubToggleFavLink = async function(btn) {
    const link = decodeURIComponent(btn.dataset.link || "");
    const title = btn.dataset.title || "favorito";
    if (!link) return;
    btn.disabled = true;
    try {
      await hubFetch(`/favorites?item_link=${encodeURIComponent(link)}`, { method: "DELETE" });
      const row = btn.closest(".hub-item");
      if (row) row.remove();
      hubCache.clear();
      showToast(`"${title}" quitado de favoritos`, "info");
      if (hubTab === "favs" && !hubList.querySelector(".hub-item")) hubLoad(true);
    } catch (err) { showToast(err.message, "error"); }
    finally { btn.disabled = false; }
  };

  window.hubImport = async function(slug) {
    if (!hubToken) { openHubModal(); return; }
    const meta = hubSeen.get(slug) || { slug, name: slug };
    showToast(`Importando "${meta.name || slug}"…`, "info");
    try {
      const r = await hubFetch(`/packages/${encodeURIComponent(slug)}/raw`);
      const d = r.data || {};
      let rawData = d.rawData;
      if (d.r2_url && rawData === undefined) rawData = await fetchHubJson(d.r2_url);
      if (rawData === undefined) throw new Error("Paquete sin contenido");
      const outerPkg = { slug, name: String(meta.name || slug).slice(0, 100), version: meta.version || null, r2Url: d.r2_url || null };
      let entries;
      if (isV2Envelope(rawData)) {
        entries = inflateIndexes(rawData)
          .filter(it => it && it.rawData)
          .map(it => ({ name: String(it.name || outerPkg.name), active: it.active ?? true, mapping: it.mapping || null, rawData: it.rawData, pkg: it.pkg || outerPkg }));
      } else {
        const mapping = (meta.indexly && meta.indexly.mapping) || null;
        entries = [{ name: outerPkg.name, active: true, mapping, rawData, pkg: outerPkg }];
      }
      if (!entries.length) throw new Error("El paquete no contiene fuentes");
      try { await hubFetch(`/packages/${encodeURIComponent(slug)}/download`, { method: "POST" }); } catch {}
      openImportSelectModal(entries);
    } catch (err) {
      console.error(err);
      showToast(`No se pudo importar: ${err.message}`, "error", 5000);
    }
  };

  // Instalar un plugin publicado en el Hub (pestaña Plugins): baja el raw,
  // extrae el manifiesto { plugin: {...} } y tras advertencia lo activa.
  window.hubInstallPlugin = async function(slug) {
    if (!hubToken) { openHubModal(); return; }
    const meta = hubSeen.get(slug) || { slug, name: slug };
    showToast(`Descargando plugin "${meta.name || slug}"…`, "info");
    try {
      const r = await hubFetch(`/packages/${encodeURIComponent(slug)}/raw`);
      const d = r.data || {};
      let rawData = d.rawData;
      if (d.r2_url && rawData === undefined) rawData = await fetchHubJson(d.r2_url);
      if (rawData === undefined) throw new Error("Paquete sin contenido");
      const pl = rawData && typeof rawData === "object" ? rawData.plugin : null;
      if (!pl || typeof pl !== "object") throw new Error("El paquete no es un plugin (falta { plugin: {…} })");
      if (!pl.id || typeof pl.code !== "string" || !pl.code.trim()) throw new Error("Manifiesto sin id o sin código");
      if (pluginCodeBytes(pl.code) > MAX_PLUGIN_BYTES) throw new Error(`El código supera ${Math.round(MAX_PLUGIN_BYTES / 1024)} KB`);
      try { compilePlugin(pl.code); } catch (err) { throw new Error("El código del plugin tiene errores de sintaxis: " + err.message); }
      const info = {
        id: String(pl.id),
        name: String(pl.name || pl.id).slice(0, 60),
        version: String(pl.version || "1.0.0").slice(0, 20),
        permissions: Array.isArray(pl.permissions) ? pl.permissions.map(String) : [],
        description: pl.description ? String(pl.description).slice(0, 200) : "",
      };
      const perms = info.permissions.length ? ` Permisos declarados: ${info.permissions.join(", ")}.` : "";
      showConfirm(
        `¿Instalar el plugin "${info.name}" v${info.version}? Ejecutará código con acceso a tus fuentes (solo lectura y añadir). Instala solo desde orígenes de confianza.${perms}`,
        async () => {
          try {
            const rec = await installPluginFromManifest(info, pl.code);
            try { await hubFetch(`/packages/${encodeURIComponent(slug)}/download`, { method: "POST" }); } catch {}
            const stored = installedPlugins.find(p => p.id === rec.id);
            if (stored && stored._error) showToast(`Instalado pero falló al activar: ${stored._error}`, "error", 6000);
            else showToast(`Plugin "${rec.name}" instalado y activado`, "success");
          } catch (err) {
            showToast(`No se pudo instalar: ${err.message}`, "error", 5000);
          }
        }
      );
    } catch (err) {
      console.error(err);
      showToast(`No se pudo instalar: ${err.message}`, "error", 5000);
    }
  };

  // Deep-link del Hub (?import=<url>&name=<slug>&mapping=<json>): descarga y abre el modal de importación normal.
  async function handleHubImport() {
    let params;
    try { params = new URLSearchParams(window.location.search); } catch { return; }
    const importUrl = params.get("import");
    if (!importUrl) return;
    const slugHint = params.get("name") || "";
    let mappingHint = null;
    try {
      const m = JSON.parse(params.get("mapping") || "null");
      if (m && typeof m === "object") mappingHint = { titleKey: m.titleKey || null, subtitleKey: m.subtitleKey || null, linkKey: m.linkKey || null };
    } catch {}
    try {
      const clean = new URL(window.location.href);
      clean.searchParams.delete("import");
      clean.searchParams.delete("name");
      clean.searchParams.delete("mapping");
      history.replaceState(null, "", clean);
    } catch {}
    let fileUrl;
    try { fileUrl = new URL(importUrl); } catch { showToast("Enlace de importación inválido", "error"); return; }
    if (fileUrl.protocol !== "http:" && fileUrl.protocol !== "https:") { showToast("Enlace de importación inválido", "error"); return; }
    const slug = sanitizePkgSlug(slugHint, "hub");
    showToast(`Importando paquete "${slug}"…`, "info");
    try {
      const raw = await fetchHubJson(fileUrl.toString());
      const outerPkg = { slug, name: (slugHint || slug).slice(0, 100), version: null, r2Url: fileUrl.toString() };
      let entries;
      if (isV2Envelope(raw)) {
        entries = inflateIndexes(raw)
          .filter(it => it && it.rawData)
          .map(it => ({ name: String(it.name || outerPkg.name), active: it.active ?? true, mapping: it.mapping || null, rawData: it.rawData, pkg: it.pkg || outerPkg }));
      } else {
        entries = [{ name: outerPkg.name, active: true, mapping: mappingHint, rawData: raw, pkg: outerPkg }];
      }
      if (!entries.length) throw new Error("El paquete no contiene fuentes");
      openImportSelectModal(entries);
    } catch (err) {
      console.error(err);
      showToast(err.name === "AbortError" ? "La descarga agotó el tiempo" : `No se pudo importar: ${err.message}`, "error", 5000);
    }
  }

  // ---- Plugins: runtime, tarjeta de gestión, instalación y secciones ----
  // Modelo userscript-style: el plugin se auto-registra con IndexLy.register({setup(ctx)}).
  // El HTML generado por plugins NO pasa por escapeHtml (su responsabilidad); el resto sí.
  const searchRoot = document.querySelector(".Search");
  const pluginsCard = document.getElementById("plugins-card");
  const pluginsListEl = document.getElementById("plugins-list");
  const pluginsCountEl = document.getElementById("plugins-count");
  const pluginsCollapseBtn = document.getElementById("plugins-collapse");
  const pluginAddModal = document.getElementById("plugin-add-modal");
  const pluginAddConfirm = document.getElementById("plugin-add-confirm");
  const pluginAddError = document.getElementById("plugin-add-error");
  const pluginPreview = document.getElementById("plugin-preview");
  const pluginFileName = document.getElementById("plugin-file-name");
  const pluginUrlInput = document.getElementById("plugin-url-input");
  const pluginSectionWrap = document.getElementById("plugin-sections");
  const pluginTabbar = document.getElementById("plugin-tabbar");
  let installedPlugins = [];
  let activePluginSection = null;
  let pendingPlugin = null;

  async function pluginAddSource(input, pluginId) {
    try {
      if (!input || input.rawData === undefined || input.rawData === null) throw new Error("addSource requiere rawData");
      const name = String(input.name || "Fuente de plugin").trim().slice(0, 60);
      if (indexes.some(i => i.name.toLowerCase() === name.toLowerCase())) throw new Error(`Ya existe una fuente "${name}"`);
      const m = input.mapping || null;
      const mapping = (m && m.titleKey) ? { titleKey: String(m.titleKey), subtitleKey: m.subtitleKey ? String(m.subtitleKey) : null, linkKey: m.linkKey ? String(m.linkKey) : null } : null;
      const flags = (input.flags && typeof input.flags === "object") ? input.flags : null;
      const games = normalizeJson(input.rawData, name, mapping);
      const idx = { id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name, active: input.active !== false, rawData: input.rawData, mapping, pkg: null, flags, games, updatedAt: Date.now() };
      indexes.push(idx);
      searchInput.removeAttribute("disabled");
      await saveIndexesToStorage(); updateApp();
      showToast(`Fuente "${name}" añadida por plugin`, "success");
      return idx.id;
    } catch (err) {
      console.error("[IndexLy] addSource:", err);
      showToast(`Plugin: ${err.message}`, "error");
      return null;
    }
  }
  // v2: escritura de fuentes existentes para plugins con permiso "data:write"
  function pluginSourcesGet(id) {
    const idx = indexes.find(i => i.id === id);
    return idx ? { ...idx } : null;
  }
  async function pluginSourcesUpdate(id, patch, pluginId) {
    const idx = indexes.find(i => i.id === id);
    if (!idx) throw new Error("Fuente no encontrada");
    const p = patch && typeof patch === "object" ? patch : {};
    if (p.name !== undefined) {
      const n = String(p.name).trim().slice(0, 60);
      if (!n) throw new Error("El nombre no puede estar vacío");
      if (n.toLowerCase() !== idx.name.toLowerCase() && indexes.some(x => x.id !== id && x.name.toLowerCase() === n.toLowerCase())) throw new Error(`Ya existe una fuente "${n}"`);
      idx.name = n;
    }
    if (p.active !== undefined) idx.active = !!p.active;
    if (p.flags !== undefined && p.flags && typeof p.flags === "object") idx.flags = { ...(idx.flags || {}), ...p.flags };
    if (p.mapping !== undefined) idx.mapping = (p.mapping && p.mapping.titleKey) ? { titleKey: String(p.mapping.titleKey), subtitleKey: p.mapping.subtitleKey ? String(p.mapping.subtitleKey) : null, linkKey: p.mapping.linkKey ? String(p.mapping.linkKey) : null } : null;
    if (p.rawData !== undefined && p.rawData !== null) idx.rawData = p.rawData;
    if (p.mapping !== undefined || p.rawData !== undefined) idx.games = normalizeJson(idx.rawData, idx.name, idx.mapping);
    idx.updatedAt = Date.now();
    await saveIndexesToStorage();
    updateApp();
    pluginRuntime.emit("source:updated", { source: { ...idx }, pluginId });
    return { ...idx };
  }
  function pluginSourcesRemove(id, pluginId) {
    return new Promise((resolve) => {
      const idx = indexes.find(i => i.id === id);
      if (!idx) { resolve(false); return; }
      const p = installedPlugins.find(x => x.id === pluginId);
      showConfirm(
        `El plugin "${p ? p.name : pluginId}" quiere eliminar la fuente "${idx.name}". ¿Permitirlo?`,
        async () => {
          if (undoTimer) clearTimeout(undoTimer);
          const at = indexes.findIndex(x => x.id === id);
          lastRemoved = { data: idx, index: at };
          indexes = indexes.filter(x => x.id !== id);
          if (indexes.length === 0) { searchInput.setAttribute("disabled", "true"); searchInput.value = ""; }
          await saveIndexesToStorage();
          updateApp();
          pluginRuntime.emit("source:removed", { id, name: idx.name, pluginId });
          showToast(`Fuente "${idx.name}" eliminada por plugin`, "info", 6000, {
            label: "Deshacer",
            onClick: async () => {
              if (lastRemoved && lastRemoved.data && lastRemoved.data.id === id) {
                const pos = Math.min(lastRemoved.index, indexes.length);
                indexes.splice(pos, 0, lastRemoved.data);
                lastRemoved = null;
                if (undoTimer) { clearTimeout(undoTimer); undoTimer = null; }
                if (indexes.length >= 1) searchInput.removeAttribute("disabled");
                await saveIndexesToStorage();
                updateApp();
                showToast("Fuente restaurada", "success");
              }
            }
          });
          undoTimer = setTimeout(() => { lastRemoved = null; }, 6500);
          resolve(true);
        },
        () => resolve(false)
      );
    });
  }
  const pluginHost = {
    showToast: (msg, type, duration) => showToast(msg, type, duration),
    modal: (opts) => openPluginModalFor(opts),
    getIndexes: () => indexes.map(i => ({ ...i })),
    getAllGames: () => indexes.reduce((acc, i) => i.active ? acc.concat(i.games || []) : acc, []),
    getFilteredGames: () => currentFilteredGames.slice(),
    getQuery: () => searchInput.value.trim(),
    addSource: pluginAddSource,
    sourcesGet: pluginSourcesGet,
    sourcesUpdate: pluginSourcesUpdate,
    sourcesRemove: pluginSourcesRemove,
    normalize: (rawData, name, mapping) => normalizeJson(rawData, name, mapping || null),
    refreshApp: () => updateApp(),
    escapeHtml,
    debounce,
  };
  const pluginRuntime = createPluginRuntime(pluginHost);

  // Modal genérico para plugins (ctx.modal)
  const pluginModalEl = document.getElementById("plugin-modal");
  const pluginModalTitleEl = document.getElementById("plugin-modal-title");
  const pluginModalBodyEl = document.getElementById("plugin-modal-body");
  const pluginModalActionsEl = document.getElementById("plugin-modal-actions");
  window.closePluginModal = function() {
    pluginModalEl.style.display = "none";
    pluginModalEl.setAttribute("aria-hidden", "true");
    pluginModalBodyEl.innerHTML = "";
    pluginModalActionsEl.innerHTML = "";
  };
  function openPluginModalFor(opts) {
    opts = opts || {};
    pluginModalTitleEl.textContent = String(opts.title || "—");
    pluginModalBodyEl.innerHTML = String(opts.html || "");
    pluginModalActionsEl.innerHTML = "";
    (Array.isArray(opts.actions) ? opts.actions : []).forEach((a) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "plx-btn " + (a && a.danger ? "plx-btn-danger" : (a && a.primary ? "plx-btn-primary" : "plx-btn-sec"));
      b.textContent = String((a && a.label) || "OK");
      b.addEventListener("click", async () => {
        let keepOpen = false;
        try { keepOpen = a && typeof a.onClick === "function" ? (await a.onClick(pluginModalBodyEl, b)) === false : false; }
        catch (err) { console.error("[IndexLy] Acción de plugin:", err); }
        if (!keepOpen) window.closePluginModal();
      });
      pluginModalActionsEl.appendChild(b);
    });
    pluginModalEl.style.display = "flex";
    pluginModalEl.setAttribute("aria-hidden", "false");
  }
  pluginModalEl.addEventListener("click", (e) => { if (e.target === pluginModalEl) window.closePluginModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && pluginModalEl.style.display !== "none") window.closePluginModal(); });

  // Card actions: botones de plugin junto a "Abrir ↗" (lista) o en el pie de la card (cuadrícula)
  function injectPluginCardActions() {
    if (!pluginRuntime.cardActions.length) return;
    const gamesToRender = currentFilteredGames.slice(0, visibleCount);
    const cards = resultsContainer.children;
    gamesToRender.forEach((game, i) => {
      const card = cards[i];
      if (!card || !card.classList.contains("game-card") && !card.classList.contains("grid-card")) return;
      for (const act of pluginRuntime.cardActions) {
        let ok = true;
        try { ok = act.match ? !!act.match(game) : true; } catch (err) { ok = false; }
        if (!ok) continue;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "plx-card-action";
        btn.textContent = act.label;
        btn.addEventListener("click", (e) => {
          e.preventDefault(); e.stopPropagation();
          try { act.onClick(game, btn); } catch (err) { console.error("[IndexLy] Acción de plugin:", err); }
        });
        const foot = viewGridCardFoot(card);
        foot.appendChild(btn);
      }
    });
  }
  function viewGridCardFoot(card) {
    if (card.classList.contains("grid-card")) return card.querySelector(".grid-foot") || card;
    return card;
  }

  // Footer de plugins
  function injectPluginFooters() {
    const el = document.getElementById("plugin-footers");
    if (!el) return;
    el.innerHTML = pluginRuntime.footers.map(f => f.html).join("");
  }

  // Chips de filtro de plugins
  function renderPluginChips() {
    const wrap = document.getElementById("plugin-chips");
    if (!wrap) return;
    wrap.innerHTML = "";
    if (typeof activeFilter === "string" && activeFilter.startsWith("plx:") && !pluginRuntime.chips.some(c => c.id === activeFilter.slice(4))) {
      activeFilter = "all";
      document.querySelectorAll(".filter-chips .chip[data-filter]").forEach(b => b.classList.toggle("active", b.dataset.filter === "all"));
    }
    for (const c of pluginRuntime.chips) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "chip plx-chip" + (activeFilter === "plx:" + c.id ? " active" : "");
      btn.textContent = c.label;
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-chips .chip").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = "plx:" + c.id;
        renderSearch();
      });
      wrap.appendChild(btn);
    }
  }

  // Secciones (pestañas) de plugins — el navbar vive encima del buscador.
  // La primera pestaña es SIEMPRE el Buscador de IndexLy (vista normal); las demás
  // son secciones registradas por plugins (Streaming, GameVault…).
  let lastTabbarSig = ""; // evita re-render del navbar si no cambió (sin trompicones)
  function renderPluginTabbar() {
    const secs = pluginRuntime.sections;
    if (searchRoot) searchRoot.classList.toggle("has-plugin-tabs", secs.length > 0);
    if (!secs.length) { lastTabbarSig = ""; pluginTabbar.style.display = "none"; pluginTabbar.innerHTML = ""; return; }
    const sig = secs.map(s => s.id + ":" + s.label).join("|") + "#" + (activePluginSection || "");
    if (sig === lastTabbarSig) return;
    lastTabbarSig = sig;
    pluginTabbar.style.display = "flex";
    const searchOn = !activePluginSection;
    pluginTabbar.innerHTML =
      `<button type="button" class="plx-tab${searchOn ? " active" : ""}" aria-pressed="${searchOn}" onclick="pluginShowSection('__search__')">Buscador</button>` +
      secs.map(s =>
        `<button type="button" class="plx-tab${activePluginSection === s.id ? " active" : ""}" aria-pressed="${activePluginSection === s.id}" onclick="pluginShowSection('${escapeHtml(s.id)}')">${escapeHtml(s.label)}</button>`
      ).join("");
  }
  window.pluginShowSection = function(id) {
    // "__search__" = volver al buscador de IndexLy (pestaña fija)
    activePluginSection = (id === "__search__" || activePluginSection === id) ? null : id;
    applyPluginSection();
  };
  // Abre una sección de plugin por id (la usan los propios plugins, ej. "▶ Ver" del Streaming)
  window.pluginOpenSection = function(id) {
    const target = pluginRuntime.sections.find(s => s.id === id);
    if (!target) return false;
    activePluginSection = id;
    applyPluginSection();
    return true;
  };
  window.pluginCloseSection = function() {
    activePluginSection = null;
    applyPluginSection();
  };
  function applyPluginSection() {
    const active = pluginRuntime.sections.find(s => s.id === activePluginSection);
    if (!active) {
      activePluginSection = null;
      searchRoot.classList.remove("section-open");
      pluginSectionWrap.style.display = "none";
      pluginSectionWrap.innerHTML = "";
      renderPluginTabbar();
      return;
    }
    searchRoot.classList.add("section-open");
    pluginSectionWrap.style.display = "block";
    pluginSectionWrap.innerHTML = "";
    const head = document.createElement("div");
    head.className = "plx-section-head";
    head.innerHTML = `<button type="button" class="plx-btn plx-btn-sec" onclick="pluginCloseSection()">← Volver a la búsqueda</button>`;
    pluginSectionWrap.appendChild(head);
    const body = document.createElement("div");
    body.className = "plx-section-body";
    pluginSectionWrap.appendChild(body);
    try { active.render(body); } catch (err) {
      console.error("[IndexLy] Sección de plugin:", err);
      body.innerHTML = `<p class="hub-error">Error en la sección "${escapeHtml(active.label)}": ${escapeHtml(err.message)}</p>`;
    }
    renderPluginTabbar();
  }

  // Tarjeta de gestión de plugins
  function renderPluginsCard() {
    if (!pluginsListEl) return;
    if (pluginsCountEl) pluginsCountEl.textContent = installedPlugins.length ? String(installedPlugins.length) : "";
    if (!installedPlugins.length) {
      pluginsListEl.innerHTML = `<p class="no-indexes">Sin plugins instalados todavía.</p>`;
      return;
    }
    pluginsListEl.innerHTML = installedPlugins.map(p => `
      <div class="plx-item${p.enabled ? "" : " plx-item-off"}">
        <span class="plx-item-dot" aria-hidden="true"></span>
        <div class="plx-item-info">
          <strong>${escapeHtml(p.name)}</strong>
          <small>v${escapeHtml(p.version || "1.0.0")} · id: ${escapeHtml(p.id)}${p._error ? ` · <span class="plx-err">error</span>` : ""}</small>
        </div>
        <div class="plx-item-actions">
          ${p._error ? `<span class="plx-err-badge" title="${escapeHtml(p._error)}">error</span>` : ""}
          <button type="button" class="index-switch" role="switch" aria-checked="${p.enabled ? "true" : "false"}" aria-label="${p.enabled ? "Desactivar" : "Activar"} ${escapeHtml(p.name)}" onclick="pluginToggle('${escapeHtml(p.id)}')"><span class="knob" aria-hidden="true"></span></button>
          <button type="button" class="action-btn delete" onclick="pluginRemove('${escapeHtml(p.id)}')" title="Eliminar" aria-label="Eliminar ${escapeHtml(p.name)}">✕</button>
        </div>
      </div>`).join("");
  }
  window.pluginToggle = async function(id) {
    const p = installedPlugins.find(x => x.id === id);
    if (!p) return;
    p.enabled = !p.enabled;
    try { await saveStoredPlugins(installedPlugins); } catch (err) { showToast("Error al guardar el plugin", "error"); return; }
    location.reload();
  };
  window.pluginRemove = function(id) {
    const p = installedPlugins.find(x => x.id === id);
    if (!p) return;
    showConfirm(`¿Eliminar el plugin "${p.name}"?`, async () => {
      installedPlugins = installedPlugins.filter(x => x.id !== id);
      try { await saveStoredPlugins(installedPlugins); } catch (err) { showToast("Error al guardar", "error"); }
      location.reload();
    });
  };

  // Instalación (fichero o URL) con vista previa y confirmación
  function pluginAddSourceTab(tab) {
    document.querySelectorAll("[data-psrc]").forEach(b => b.classList.toggle("active", b.dataset.psrc === tab));
    document.getElementById("plugin-add-file").style.display = tab === "file" ? "flex" : "none";
    document.getElementById("plugin-add-url").style.display = tab === "url" ? "flex" : "none";
  }
  document.querySelectorAll("[data-psrc]").forEach(btn => btn.addEventListener("click", () => pluginAddSourceTab(btn.dataset.psrc)));
  function resetPluginAddModal() {
    pendingPlugin = null;
    pluginAddConfirm.disabled = true;
    pluginPreview.style.display = "none";
    pluginPreview.innerHTML = "";
    pluginAddError.style.display = "none";
    pluginFileName.textContent = "";
    pluginUrlInput.value = "";
    document.getElementById("plugin-file-input").value = "";
    pluginAddSourceTab("file");
  }
  window.openPluginAddModal = function() {
    resetPluginAddModal();
    pluginAddModal.style.display = "flex";
    pluginAddModal.setAttribute("aria-hidden", "false");
  };
  window.closePluginAddModal = function() {
    pluginAddModal.style.display = "none";
    pluginAddModal.setAttribute("aria-hidden", "true");
  };
  pluginAddModal.addEventListener("click", (e) => { if (e.target === pluginAddModal) window.closePluginAddModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && pluginAddModal.style.display !== "none") window.closePluginAddModal(); });
  function showPluginAddError(msg) {
    pendingPlugin = null;
    pluginAddConfirm.disabled = true;
    pluginPreview.style.display = "none";
    pluginPreview.innerHTML = "";
    pluginAddError.textContent = msg;
    pluginAddError.style.display = "block";
  }
  function showPluginPreview(code, meta) {
    pendingPlugin = { code, meta };
    pluginAddError.style.display = "none";
    pluginPreview.style.display = "block";
    pluginPreview.innerHTML = `
      <div class="plx-preview-head"><strong>${escapeHtml(meta.name)}</strong><span class="plx-preview-ver">v${escapeHtml(meta.version)}</span></div>
      <div class="plx-preview-id">id: ${escapeHtml(meta.id)} · ${(pluginCodeBytes(code) / 1024).toFixed(1)} KB</div>
      ${meta.description ? `<div class="plx-preview-desc">${escapeHtml(meta.description)}</div>` : ""}
      ${meta.permissions.length ? `<div class="plx-preview-perms">permisos: ${escapeHtml(meta.permissions.join(", "))}</div>` : ""}
      <p class="plx-warn">⚠ Este plugin ejecutará código con acceso a tus fuentes. Instala solo desde orígenes de confianza.</p>`;
    pluginAddConfirm.disabled = false;
  }
  function validatePluginSource(code) {
    if (!code || !code.trim()) throw new Error("El plugin está vacío");
    if (pluginCodeBytes(code) > MAX_PLUGIN_BYTES) throw new Error(`El plugin supera ${Math.round(MAX_PLUGIN_BYTES / 1024)} KB`);
    const meta = parsePluginHeader(code);
    if (meta.error) throw new Error(meta.error);
    try { compilePlugin(code); } catch (err) { throw new Error("Error de sintaxis: " + err.message); }
    return meta;
  }
  // Instala y activa un plugin desde un manifiesto válido. Usada por el modal
  // de instalación (fichero/URL) y por el flujo del Hub (hubInstallPlugin).
  // IMPORTANTE: persistir ANTES de activar — activateAll() re-lee desde IndexedDB.
  async function installPluginFromManifest(m, code) {
    if (!m || !m.id) throw new Error("Manifiesto sin id");
    if (installedPlugins.some(p => p.id === m.id)) throw new Error(`Ya existe un plugin con el id "${m.id}". Elimínalo primero.`);
    const rec = {
      id: String(m.id), name: String(m.name || m.id), version: String(m.version || "1.0.0"),
      permissions: Array.isArray(m.permissions) ? m.permissions.map(String) : [],
      description: String(m.description || ""),
      code, enabled: true, installedAt: Date.now(),
    };
    installedPlugins.push(rec);
    try {
      await saveStoredPlugins(installedPlugins);
      installedPlugins = await pluginRuntime.activateAll();
    } catch (err) {
      installedPlugins = installedPlugins.filter(p => p.id !== rec.id);
      try { await saveStoredPlugins(installedPlugins); } catch {}
      throw err;
    }
    renderPluginsCard();
    renderPluginChips();
    injectPluginFooters();
    if (pluginRuntime.sections.length) applyPluginSection();
    return rec;
  }
  pluginAddConfirm.addEventListener("click", async () => {
    if (!pendingPlugin) return;
    pluginAddConfirm.disabled = true;
    try {
      const rec = await installPluginFromManifest(pendingPlugin.meta, pendingPlugin.code);
      window.closePluginAddModal();
      const stored = installedPlugins.find(p => p.id === rec.id);
      if (stored && stored._error) showToast(`Instalado pero falló al activar: ${stored._error}`, "error", 6000);
      else showToast(`Plugin "${rec.name}" instalado`, "success");
      pendingPlugin = null;
    } catch (err) {
      showPluginAddError(`No se pudo instalar: ${err.message}`);
    } finally { pluginAddConfirm.disabled = false; }
  });
  document.getElementById("plugin-file-input").addEventListener("change", async (e) => {
    const file = e.target.files && e.target.files[0];
    e.target.value = "";
    if (!file) return;
    try {
      pluginFileName.textContent = file.name;
      const code = await file.text();
      showPluginPreview(code, validatePluginSource(code));
    } catch (err) { showPluginAddError(err.message); }
  });
  document.getElementById("plugin-url-fetch").addEventListener("click", async () => {
    const url = pluginUrlInput.value.trim();
    if (!url) { showPluginAddError("Introduce una URL"); return; }
    try { const u = new URL(url); if (u.protocol !== "http:" && u.protocol !== "https:") throw new Error(); }
    catch { showPluginAddError("URL inválida (solo http/https)"); return; }
    const btn = document.getElementById("plugin-url-fetch");
    btn.disabled = true;
    btn.textContent = "Descargando…";
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 20000);
    try {
      const res = await fetch(url, { signal: ctrl.signal });
      if (!res.ok) throw new Error(`Descarga falló (HTTP ${res.status})`);
      const code = await res.text();
      pluginFileName.textContent = url.slice(0, 60);
      showPluginPreview(code, validatePluginSource(code));
    } catch (err) {
      showPluginAddError(err.name === "AbortError" ? "La descarga agotó el tiempo" : `No se pudo descargar: ${err.message}`);
    } finally {
      clearTimeout(timer);
      btn.disabled = false;
      btn.textContent = "Descargar";
    }
  });

  // Deep-link de instalación (?plugin=<url>): descarga el plugin y abre el modal con la vista previa.
  async function handlePluginDeepLink() {
    let params;
    try { params = new URLSearchParams(window.location.search); } catch { return; }
    const url = params.get("plugin");
    if (!url) return;
    try {
      const clean = new URL(window.location.href);
      clean.searchParams.delete("plugin");
      history.replaceState(null, "", clean);
    } catch {}
    let fileUrl;
    try { fileUrl = new URL(url); } catch { showToast("Enlace de plugin inválido", "error"); return; }
    if (fileUrl.protocol !== "http:" && fileUrl.protocol !== "https:") { showToast("Enlace de plugin inválido", "error"); return; }
    showToast("Descargando plugin…", "info");
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 20000);
    try {
      const res = await fetch(fileUrl.toString(), { signal: ctrl.signal });
      if (!res.ok) throw new Error(`Descarga falló (HTTP ${res.status})`);
      // El Hub guarda los plugins como .json.gz en R2 (gzip) y los .js también pueden
      // venir comprimidos: baja como blob y descomprime según magic bytes 1f 8b.
      const blob = await res.blob();
      const code = await decompressBlobToText(blob);
      // Detecta qué es: manifiesto JSON {plugin:{…}} (lo que sirve el Hub) o .js crudo.
      let meta = null;
      let pluginCode = code;
      try {
        const parsed = JSON.parse(code);
        const pl = parsed && typeof parsed === "object" ? parsed.plugin : null;
        if (pl && typeof pl === "object" && pl.id && typeof pl.code === "string") {
          if (!pl.code.trim()) throw new Error("Manifiesto sin código");
          if (pluginCodeBytes(pl.code) > MAX_PLUGIN_BYTES) throw new Error(`El código supera ${Math.round(MAX_PLUGIN_BYTES / 1024)} KB`);
          try { compilePlugin(pl.code); } catch (err) { throw new Error("El código del plugin tiene errores de sintaxis: " + err.message); }
          meta = {
            id: String(pl.id),
            name: String(pl.name || pl.id).slice(0, 60),
            version: String(pl.version || "1.0.0").slice(0, 20),
            permissions: Array.isArray(pl.permissions) ? pl.permissions.map(String) : [],
            description: pl.description ? String(pl.description).slice(0, 200) : "",
          };
          pluginCode = pl.code;
        }
      } catch (err) {
        if (err instanceof SyntaxError) { /* no era JSON: seguimos como .js crudo */ }
        else throw err;
      }
      if (!meta) meta = validatePluginSource(code);
      window.openPluginAddModal();
      pluginAddSourceTab("url");
      pluginUrlInput.value = fileUrl.toString();
      pluginFileName.textContent = fileUrl.toString().slice(0, 60);
      if (installedPlugins.some(p => p.id === meta.id)) {
        showPluginAddError(`Ya existe un plugin con el id "${meta.id}". Elimínalo primero para reinstalar.`);
      } else {
        showPluginPreview(pluginCode, meta);
      }
    } catch (err) {
      showToast(err.name === "AbortError" ? "La descarga agotó el tiempo" : `No se pudo descargar el plugin: ${err.message}`, "error", 5000);
    } finally { clearTimeout(timer); }
  }

  // Colapso de la tarjeta de plugins (persistente)
  let pluginsCollapsed = localStorage.getItem("indexly_plugins_collapsed") === "1";
  function applyPluginsCollapsed(v) {
    pluginsCollapsed = v;
    pluginsCard.classList.toggle("collapsed", v);
    if (pluginsCollapseBtn) {
      pluginsCollapseBtn.setAttribute("aria-expanded", String(!v));
      pluginsCollapseBtn.setAttribute("aria-label", v ? "Expandir plugins" : "Comprimir plugins");
      pluginsCollapseBtn.title = v ? "Expandir" : "Comprimir";
    }
    localStorage.setItem("indexly_plugins_collapsed", v ? "1" : "0");
  }
  if (pluginsCollapseBtn) {
    applyPluginsCollapsed(pluginsCollapsed);
    pluginsCollapseBtn.addEventListener("click", () => applyPluginsCollapsed(!pluginsCard.classList.contains("collapsed")));
  }

  // Activación de plugins al arrancar (se llama antes del primer render):
  // activa los plugins habilitados y pinta su tarjeta, chips, navbar y footers.
  async function initPlugins() {
    installedPlugins = await pluginRuntime.activateAll();
    renderPluginsCard();
    renderPluginChips();
    renderPluginTabbar();
    injectPluginFooters();
  }

  applyResultsView();
  // Activación de plugins ANTES del primer render (loadStoredIndexes → updateApp):
  // la navbar de secciones y sus slots existen desde el primer pintado, sin saltos.
  (async () => {
    try { await initPlugins(); } catch (err) { console.error("[IndexLy] initPlugins:", err); }
    await loadStoredIndexes();
    updateHubUI();
    if (hubToken) hubLoad(true);
    handleHubImport();
    try { await handlePluginDeepLink(); } catch (err) { console.error("[IndexLy] pluginDeepLink:", err); }
  })();
</script>

