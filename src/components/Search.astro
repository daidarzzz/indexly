---
// src/components/Search.astro — Premium SaaS restyle + generic normalizer + mapping modal
---

<div class="Search">
  <div class="index-manager-card">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12H14l-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6l2 2h8a2 2 0 0 1 2 2v4Z"/><path d="M14 14v6H4a2 2 0 0 1-2-2v-6"/></svg>
        </div>
        <div>
          <h3>Fuentes</h3>
          <p class="manager-desc">Gestiona tus índices activos</p>
        </div>
      </div>
      <label for="json-input" class="file-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        Añadir JSON
      </label>
      <input type="file" id="json-input" accept=".json" multiple />
    </div>
    <div id="indexes-list" class="indexes-grid-list">
      <p class="no-indexes">No hay índices cargados todavía.</p>
    </div>
  </div>
  <div class="search-wrap">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="text" id="search-input" placeholder="Buscar…" disabled autocomplete="off" spellcheck="false" />
  </div>
  <div id="stats-container" class="stats-container"></div>
  <div id="results" class="results-grid"></div>
  <button id="load-more-btn" class="load-more-btn" style="display: none;">Cargar más</button>
  <p class="footer-note">Todo se guarda localmente. Nada se envía a servidores.</p>
</div>

<div id="mapping-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="mapping-title">
    <div class="mapping-header">
      <h4 id="mapping-title">Ajustar fuente</h4>
      <button class="mapping-close" onclick="closeMappingModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Renombra la fuente y elige qué campo de tu JSON corresponde a cada rol.</p>
    <div class="mapping-fields">
      <label class="mapping-label">Nombre de la fuente
        <input id="map-name" type="text" class="mapping-input" placeholder="Ej: Mis Juegos" maxlength="60" />
      </label>
      <label class="mapping-label">Título (obligatorio)
        <select id="map-title"></select>
      </label>
      <label class="mapping-label">Subtítulo (opcional)
        <select id="map-subtitle"></select>
      </label>
      <label class="mapping-label">Enlace (opcional)
        <select id="map-link"></select>
      </label>
    </div>
    <p class="mapping-hint">Vista previa: <span id="mapping-preview">—</span></p>
    <div class="mapping-actions">
      <button class="mapping-btn secondary" onclick="closeMappingModal()">Cancelar</button>
      <button class="mapping-btn primary" onclick="saveMapping()">Aplicar</button>
    </div>
  </div>
</div>

<script>
  import { normalizeJson, getAvailableKeys, getAutoMapping } from "../utils/normalizer";
  import { get, set } from "idb-keyval";
  let indexes = [];
  let currentFilteredGames = [];
  let visibleCount = 50;
  let mappingModalIndexId = null;
  const fileInput = document.getElementById("json-input");
  const searchInput = document.getElementById("search-input");
  const resultsContainer = document.getElementById("results");
  const indexesListContainer = document.getElementById("indexes-list");
  const loadMoreBtn = document.getElementById("load-more-btn");
  const statsContainer = document.getElementById("stats-container");
  const mappingModal = document.getElementById("mapping-modal");
  const mapNameInput = document.getElementById("map-name");
  const mapTitleSelect = document.getElementById("map-title");
  const mapSubtitleSelect = document.getElementById("map-subtitle");
  const mapLinkSelect = document.getElementById("map-link");
  const mappingPreview = document.getElementById("mapping-preview");

  function getSearchableText(item) {
    const parts = [item.title, item.subtitle, item.source];
    if (item.meta) parts.push(...Object.values(item.meta));
    if (item.fileSize) parts.push(item.fileSize);
    return parts.filter(Boolean).join(" ").toLowerCase();
  }

  async function loadStoredIndexes() {
    try {
      const saved = await get("indexly_saved_indexes");
      if (saved) {
        indexes = saved.map((item) => {
          const parsedGames = normalizeJson(item.rawData, item.name, item.mapping || null);
          return { id: item.id, name: item.name, active: item.active, rawData: item.rawData, mapping: item.mapping || null, games: parsedGames };
        });
        if (indexes.length > 0) searchInput.removeAttribute("disabled");
      }
    } catch (e) { console.error(e); }
    updateApp();
  }
  async function saveIndexesToStorage() {
    try {
      const dataToSave = indexes.map((idx) => ({ id: idx.id, name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping || null }));
      await set("indexly_saved_indexes", dataToSave);
    } catch (e) { console.error(e); alert("⚠️ Error al guardar en IndexedDB."); }
  }
  fileInput.addEventListener("change", async (event) => {
    const target = event.target;
    if (!target.files || target.files.length === 0) return;
    const files = Array.from(target.files);
    target.value = "";
    let addedCount = 0; let duplicateNames = [];
    for (const file of files) {
      try {
        const text = await file.text();
        const rawData = JSON.parse(text);
        const parsedGames = normalizeJson(rawData, file.name, null);
        const indexName = (rawData && typeof rawData === "object" && !Array.isArray(rawData) && rawData.name) ? rawData.name : file.name.replace(/\.json$/i, "");
        const exists = indexes.some((idx) => idx.name.toLowerCase() === indexName.toLowerCase());
        if (exists) { duplicateNames.push(indexName); continue; }
        if (parsedGames.length === 0) {
          alert(`⚠️ "${file.name}" no contiene elementos reconocibles. Puedes ajustarlo manualmente tras cargarlo.`);
          // still add with empty so user can map
          indexes.push({ id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, mapping: null, games: [] });
          addedCount++;
          continue;
        }
        indexes.push({ id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, mapping: null, games: parsedGames });
        addedCount++;
      } catch (error) { console.error(error); alert(`❌ Error en "${file.name}": ${error.message}`); }
    }
    if (duplicateNames.length > 0) alert(`⚠️ Ya existían y se omitieron:\n• ${duplicateNames.join("\n• ")}`);
    if (addedCount > 0) { searchInput.removeAttribute("disabled"); await saveIndexesToStorage(); updateApp(); }
  });
  window.toggleIndex = async function (id) {
    const idx = indexes.find((i) => i.id === id);
    if (idx) { idx.active = !idx.active; await saveIndexesToStorage(); updateApp(); }
  };
  window.removeIndex = async function (id) {
    indexes = indexes.filter((i) => i.id !== id);
    if (indexes.length === 0) { searchInput.setAttribute("disabled", "true"); searchInput.value = ""; }
    await saveIndexesToStorage(); updateApp();
  };

  function fillSelect(select, keys, current, includeEmpty) {
    select.innerHTML = "";
    if (includeEmpty) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "— ninguno —";
      select.appendChild(opt);
    }
    for (const k of keys) {
      const opt = document.createElement("option");
      opt.value = k;
      opt.textContent = k;
      if (k === current) opt.selected = true;
      select.appendChild(opt);
    }
  }

  function updateMappingPreview() {
    const idx = indexes.find(i => i.id === mappingModalIndexId);
    if (!idx) return;
    const titleKey = mapTitleSelect.value;
    const linkKey = mapLinkSelect.value;
    const subtitleKey = mapSubtitleSelect.value;
    if (!titleKey) { mappingPreview.textContent = "Selecciona un campo de Título"; return; }
    try {
      const preview = normalizeJson(idx.rawData, idx.name, { titleKey, linkKey: linkKey || null, subtitleKey: subtitleKey || null });
      if (preview.length === 0) mappingPreview.textContent = "Sin elementos con ese mapeo";
      else mappingPreview.textContent = `${preview.length} elementos · ej: "${preview[0].title}"${preview[0].link ? " · con enlace" : ""}`;
    } catch (e) { mappingPreview.textContent = "Error en vista previa"; }
  }

  window.openMappingModal = function(id) {
    const idx = indexes.find(i => i.id === id);
    if (!idx) return;
    mappingModalIndexId = id;
    const keys = getAvailableKeys(idx.rawData);
    if (keys.length === 0) {
      alert("Este JSON no tiene campos mapeables (array de primitivos o estructura no soportada).");
      return;
    }
    mapNameInput.value = idx.name || "";
    const auto = getAutoMapping(idx.rawData);
    const current = idx.mapping || auto;
    fillSelect(mapTitleSelect, keys, current.titleKey || auto.titleKey || keys[0], false);
    fillSelect(mapSubtitleSelect, keys, current.subtitleKey || auto.subtitleKey || "", true);
    fillSelect(mapLinkSelect, keys, current.linkKey || auto.linkKey || "", true);
    updateMappingPreview();
    mappingModal.style.display = "flex";
    mappingModal.setAttribute("aria-hidden", "false");
    setTimeout(() => mapNameInput.focus(), 50);
  };
  window.closeMappingModal = function() {
    mappingModal.style.display = "none";
    mappingModal.setAttribute("aria-hidden", "true");
    mappingModalIndexId = null;
  };
  window.saveMapping = async function() {
    const idx = indexes.find(i => i.id === mappingModalIndexId);
    if (!idx) return;
    const newName = mapNameInput.value.trim();
    if (!newName) { alert("El nombre no puede estar vacío."); return; }
    const duplicate = indexes.some(x => x.id !== idx.id && x.name.toLowerCase() === newName.toLowerCase());
    if (duplicate) { alert(`Ya existe otra fuente llamada "${newName}".`); return; }
    const titleKey = mapTitleSelect.value;
    if (!titleKey) { alert("Debes elegir un campo de Título."); return; }
    const mapping = { titleKey, subtitleKey: mapSubtitleSelect.value || null, linkKey: mapLinkSelect.value || null };
    idx.name = newName;
    idx.mapping = mapping;
    idx.games = normalizeJson(idx.rawData, idx.name, mapping);
    await saveIndexesToStorage();
    closeMappingModal();
    updateApp();
  };
  mapTitleSelect.addEventListener("change", updateMappingPreview);
  mapSubtitleSelect.addEventListener("change", updateMappingPreview);
  mapLinkSelect.addEventListener("change", updateMappingPreview);
  mappingModal.addEventListener("click", (e) => { if (e.target === mappingModal) closeMappingModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && mappingModal.style.display !== "none") closeMappingModal(); });

  function updateApp() {
    renderIndexesManager();
    let activeGames = [];
    indexes.forEach((index) => { if (index.active) activeGames = activeGames.concat(index.games); });
    const query = searchInput.value.toLowerCase().trim();
    if (query === "") {
      currentFilteredGames = activeGames;
    } else {
      currentFilteredGames = activeGames.filter((g) => getSearchableText(g).includes(query));
    }
    visibleCount = 50;
    renderCurrentView();
  }
  function renderIndexesManager() {
    if (indexes.length === 0) {
      indexesListContainer.innerHTML = `<div class="empty-state"><div class="empty-icon">◇</div><p class="no-indexes">Sin fuentes aún<br><span>Sube uno o varios .json para empezar</span></p></div>`;
      return;
    }
    indexesListContainer.innerHTML = indexes.map((index) => `
      <div class="index-pill ${index.active ? "active" : "inactive"}">
        <div class="index-pill-info">
          <span class="status-dot"></span>
          <div class="index-text">
            <strong>${escapeHtml(index.name)}</strong>
            <small>${index.games.length.toLocaleString("es-ES")} elementos${index.mapping ? " · mapeado" : ""}</small>
          </div>
        </div>
        <div class="index-pill-actions">
          <button class="action-btn map" onclick="openMappingModal('${index.id}')" title="Ajustar mapeo">⚙</button>
          <button class="action-btn toggle" onclick="toggleIndex('${index.id}')">${index.active ? "Desactivar" : "Activar"}</button>
          <button class="action-btn delete" onclick="removeIndex('${index.id}')" aria-label="Eliminar">✕</button>
        </div>
      </div>`).join("");
  }
  function escapeHtml(str) { const d = document.createElement("div"); d.textContent = str == null ? "" : String(str); return d.innerHTML; }
  function formatDateDDMMYY(val) {
    if (!val || typeof val !== "string") return val;
    const s = val.trim();
    // ISO 8601 like 2026-04-04 or 2026-04-04T17:39:30+00:00
    const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[3]}/${iso[2]}/${iso[1].slice(2)}`;
    const d = new Date(s);
    if (!isNaN(d.getTime())) {
      const dd = String(d.getDate()).padStart(2, "0");
      const mm = String(d.getMonth()+1).padStart(2, "0");
      const yy = String(d.getFullYear()).slice(2);
      return `${dd}/${mm}/${yy}`;
    }
    return val;
  }

  function renderMetaBadges(meta) {
    if (!meta || Object.keys(meta).length === 0) return "";
    const labelLess = new Set(["tamaño","tamano","filesize","size","uploaddate","upload_date","fechasubida","fecha"]);
    const dateKeys = new Set(["uploaddate","upload_date","fechasubida","fecha"]);
    const entries = Object.entries(meta).slice(0, 3);
    return entries.map(([k,v]) => {
      const lk = k.toLowerCase();
      const isLabelLess = labelLess.has(lk);
      let displayVal = v;
      if (dateKeys.has(lk)) displayVal = formatDateDDMMYY(String(v));
      const text = isLabelLess ? escapeHtml(displayVal) : `${escapeHtml(k)}: ${escapeHtml(displayVal)}`;
      const title = `${escapeHtml(k)}: ${escapeHtml(v)}`;
      return `<span class="meta-badge" title="${title}">${text}</span>`;
    }).join("");
  }

  function renderCurrentView() {
    if (indexes.length === 0) {
      resultsContainer.innerHTML = ""; statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none";
      searchInput.placeholder = "Sube un JSON arriba para empezar…"; return;
    }
    const totalMatches = currentFilteredGames.length;
    searchInput.placeholder = `Buscar entre ${totalMatches.toLocaleString("es-ES")} elementos…`;
    if (totalMatches === 0) {
      const q = searchInput.value.trim();
      resultsContainer.innerHTML = `<div class="empty-results"><p class="no-results">${q ? `Sin resultados para “${escapeHtml(q)}”` : "No hay elementos en las fuentes activas."}</p><span>Prueba otro término o activa más fuentes.</span></div>`;
      statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none"; return;
    }
    statsContainer.innerHTML = `Mostrando <strong>${Math.min(visibleCount, totalMatches).toLocaleString("es-ES")}</strong> de <strong>${totalMatches.toLocaleString("es-ES")}</strong>`;
    const gamesToRender = currentFilteredGames.slice(0, visibleCount);
    resultsContainer.innerHTML = gamesToRender.map((game) => {
      const metaHtml = renderMetaBadges(game.meta);
      const subtitleHtml = game.subtitle ? `<p class="game-subtitle">${escapeHtml(game.subtitle)}</p>` : "";
      const hasMeta = metaHtml || game.fileSize && game.fileSize !== "Tamaño desconocido";
      return `
      <div class="game-card">
        <div class="game-info-container">
          <h3>${escapeHtml(game.title)}</h3>
          ${subtitleHtml}
          <p class="game-meta"><span class="source-badge">${escapeHtml(game.source)}</span>${hasMeta ? metaHtml : ""}</p>
        </div>
        ${game.link ? `<a href="${escapeHtml(game.link)}" target="_blank" rel="noopener" class="magnet-link">Abrir <span>↗</span></a>` : '<span class="no-magnet">Sin enlace</span>'}
      </div>`;
    }).join("");
    loadMoreBtn.style.display = visibleCount < totalMatches ? "inline-flex" : "none";
  }
  searchInput.addEventListener("input", () => updateApp());
  loadMoreBtn.addEventListener("click", () => { visibleCount += 50; renderCurrentView(); });
  document.addEventListener("keydown", (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if ((e.key === "/" && document.activeElement !== searchInput && !mod) || (mod && e.key.toLowerCase() === "k")) {
      e.preventDefault(); searchInput.focus();
    }
  });
  loadStoredIndexes();
</script>

<style>
  .Search {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .index-manager-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }
  .manager-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .manager-title { display: flex; align-items: center; gap: var(--space-3); }
  .manager-icon {
    width: 32px; height: 32px;
    display: grid; place-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .manager-header h3 {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    line-height: 1;
  }
  .manager-desc {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-light);
    color: var(--color-text-secondary);
  }
  .file-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 8px 14px;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    user-select: none;
    border: 1px solid transparent;
    transition: opacity 0.15s ease;
  }
  .file-label:hover { opacity: 0.86; }
  #json-input { display: none; }
  .indexes-grid-list { display: flex; flex-direction: column; gap: var(--space-2); min-height: 36px; }
  .empty-state {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4) var(--space-2);
    text-align: center;
  }
  .empty-icon {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-tertiary);
    font-size: 13px;
  }
  :global(.index-pill) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  :global(.index-pill:hover) { border-color: var(--color-border-hover); box-shadow: var(--shadow-subtle); }
  :global(.index-pill.active) { background: var(--color-surface-hover); border-color: var(--color-border-hover); }
  :global(.index-pill.inactive) { opacity: 0.5; border-style: dashed; }
  :global(.index-pill-info) { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
  :global(.status-dot) { width: 7px; height: 7px; border-radius: 50%; background: var(--color-text-tertiary); flex-shrink: 0; }
  :global(.index-pill.active .status-dot) { background: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  :global(.index-text) { display: flex; flex-direction: column; min-width: 0; }
  :global(.index-text strong) {
    font-size: var(--text-md); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tight); color: var(--color-text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 24ch;
  }
  :global(.index-text small) { font-size: var(--text-xs); color: var(--color-text-secondary); }
  :global(.index-pill-actions) { display: flex; align-items: center; gap: var(--space-2); }
  :global(.action-btn) {
    border: 1px solid var(--color-border); background: transparent; padding: 6px 10px; border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--weight-medium); cursor: pointer; transition: all 0.15s ease; line-height: 1;
  }
  :global(.action-btn.toggle) { color: var(--color-text-secondary); }
  :global(.action-btn.toggle:hover) { background: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border-strong); }
  :global(.index-pill.active .action-btn.toggle) { background: var(--color-primary-soft); color: var(--color-primary); border-color: var(--color-primary-border); }
  :global(.action-btn.delete) { color: var(--color-text-tertiary); padding: 6px 8px; border-color: transparent; }
  :global(.action-btn.delete:hover) { background: rgba(239,68,68,0.08); color: #f87171; border-color: rgba(239,68,68,0.15); }
  :global(.action-btn.map) { color: var(--color-text-tertiary); padding: 6px 8px; border-color: transparent; }
  :global(.action-btn.map:hover) { background: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border); }
  :global(.no-indexes) { font-size: var(--text-sm); color: var(--color-text-tertiary); margin: 0; text-align: center; }
  :global(.no-indexes span) { color: var(--color-text-secondary); font-weight: var(--weight-light); }
  .search-wrap { position: relative; margin-top: var(--space-8); }
  .search-icon { position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%); pointer-events: none; }
  .search-hint {
    position: absolute; right: var(--space-3); top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: 4px; pointer-events: none;
    background: var(--color-bg); border: 1px solid var(--color-border); border-bottom-width: 1.5px;
    padding: 4px 7px; border-radius: 6px; font-family: var(--font-mono); font-size: 11px; color: var(--color-text-tertiary);
  }
  .search-hint kbd { font-family: inherit; font-size: 11px; font-weight: 500; color: var(--color-text-secondary); }
  #search-input {
    width: 100%; padding: 13px 96px 13px 44px; border-radius: var(--radius-lg);
    background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);
    font-size: var(--text-md); outline: none; transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }
  #search-input::placeholder { color: var(--color-text-tertiary); font-weight: var(--weight-light); }
  #search-input:hover { border-color: var(--color-border-hover); }
  #search-input:focus { background: var(--color-surface-hover); border-color: var(--color-border-hover); box-shadow: var(--shadow-focus); }
  #search-input:disabled { opacity: 0.45; cursor: not-allowed; }
  .stats-container { margin-top: var(--space-4); font-size: var(--text-sm); font-weight: var(--weight-light); color: var(--color-text-secondary); min-height: 16px; }
  .stats-container strong { font-weight: var(--weight-medium); color: var(--color-text); }
