  .bulk-clear { background: transparent; border: none; color: var(--color-text-tertiary); font-size: 11px; font-weight: 500; cursor: pointer; padding: 5px 8px; border-radius: 999px; transition: color 0.15s, background 0.15s; white-space: nowrap; }
  .bulk-clear:hover { color: #f87171; background: rgba(239,68,68,0.08); }
