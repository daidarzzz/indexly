  :global(.index-pill.inactive .index-avatar) { filter: grayscale(0.7) brightness(0.85); box-shadow: none; }
  :global(.index-text) { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
  :global(.index-text strong) {
    font-size: var(--text-md); font-weight: 600; letter-spacing: var(--tracking-tight); color: var(--color-text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 26ch; line-height: 1.25;
  }
  :global(.index-text small) { font-size: var(--text-xs); color: var(--color-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: 6px; }
  :global(.mapped-badge) {
    font-size: 10px; font-weight: 600; letter-spacing: 0.02em; color: var(--color-primary);
    background: var(--color-primary-soft); border: 1px solid var(--color-primary-border);
    padding: 1px 7px; border-radius: 999px; flex-shrink: 0;
  }
  :global(.index-pill-actions) { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  :global(.index-pill .index-pill-actions .action-btn) { opacity: 0; }
  :global(.index-pill:hover .index-pill-actions .action-btn),
  :global(.index-pill:focus-within .index-pill-actions .action-btn) { opacity: 1; }
  @media (hover: none) {
    :global(.index-pill .index-pill-actions .action-btn) { opacity: 1; }
  }
  :global(.action-btn) {
    border: 1px solid var(--color-border); background: transparent; padding: 6px 10px; border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--weight-medium); cursor: pointer; transition: all 0.15s ease; line-height: 1;
  }
  :global(.action-btn.delete) { color: var(--color-text-tertiary); padding: 7px; border-color: transparent; display: grid; place-items: center; border-radius: 10px; }
  :global(.action-btn.delete:hover) { background: rgba(239,68,68,0.08); color: #f87171; border-color: rgba(239,68,68,0.15); }
  :global(.action-btn.map) { color: var(--color-text-tertiary); padding: 7px; border-color: transparent; display: grid; place-items: center; border-radius: 10px; }
  :global(.action-btn.map:hover) { background: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border); }
  @media (hover: none) {
    :global(.action-btn.delete), :global(.action-btn.map) { border-color: var(--color-border); }
  }
  /* Switch activar/desactivar */
  :global(.index-switch) {
    width: 38px; height: 22px; border-radius: 999px; padding: 0; flex-shrink: 0;
    background: #141b29; border: 1px solid var(--color-border); cursor: pointer; position: relative;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  :global(.index-switch .knob) {
    position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%;
    background: #64748b; transition: left 0.15s ease, background 0.15s ease;
  }
  :global(.index-switch:hover) { border-color: var(--color-border-strong); }
  :global(.index-switch:focus-visible) { outline: 1px solid var(--color-primary); outline-offset: 2px; }
  :global(.index-switch[aria-checked="true"]) { background: rgba(14,165,233,0.22); border-color: var(--color-primary-border); }
  :global(.index-switch[aria-checked="true"] .knob) { left: 18px; background: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  /* Paquetes (carpetas) — reutilizan .index-pill/.index-avatar/.index-switch; solo añaden indent + chevron */
  :global(.pkg-group) { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  :global(.pkg-header) { cursor: default; }
  :global(.pkg-chevron) { width: 22px; height: 22px; display: grid; place-items: center; background: transparent; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-tertiary); cursor: pointer; flex-shrink: 0; padding: 0; }
  :global(.pkg-chevron:hover) { background: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border-strong); }
  :global(.pkg-chevron svg) { transition: transform 0.15s ease; }
  :global(.pkg-group.collapsed .pkg-chevron svg) { transform: rotate(-90deg); }
  :global(.pkg-children) { display: flex; flex-direction: column; gap: var(--space-2); margin-left: 11px; padding-left: 12px; border-left: 1px solid var(--color-border); }
  :global(.pkg-group.collapsed .pkg-children) { display: none; }
  :global(.no-indexes) { font-size: var(--text-sm); color: var(--color-text-tertiary); margin: 0; text-align: center; }
  :global(.no-indexes span) { color: var(--color-text-secondary); font-weight: var(--weight-light); }
  .search-wrap { position: relative; margin-top: var(--space-8); }
  .search-icon { position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%); pointer-events: none; }
  .search-hint {
    position: absolute; right: var(--space-3); top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: 4px; pointer-events: none;
    background: var(--color-bg); border: 1px solid var(--color-border); border-bottom-width: 1.5px;
    padding: 4px 7px; border-radius: 6px; font-family: var(--font-mono); font-size: 11px; color: var(--color-text-tertiary);
  }
  .search-hint kbd { font-family: inherit; font-size: 11px; font-weight: 500; color: var(--color-text-secondary); }
  #search-input {
    width: 100%; padding: 13px 96px 13px 44px; border-radius: var(--radius-lg);
    background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);
    font-size: var(--text-md); outline: none; transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }
  #search-input::placeholder { color: var(--color-text-tertiary); font-weight: var(--weight-light); }
  #search-input:hover { border-color: var(--color-border-hover); }
  #search-input:focus { background: var(--color-surface-hover); border-color: var(--color-border-hover); box-shadow: var(--shadow-focus); }
  #search-input:disabled { opacity: 0.45; cursor: not-allowed; }
  .stats-container { margin-top: var(--space-4); font-size: var(--text-sm); font-weight: var(--weight-light); color: var(--color-text-secondary); min-height: 16px; }
  .stats-container strong { font-weight: var(--weight-medium); color: var(--color-text); }
  .results-grid { margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  /* Vista cuadrícula — espejo de las pkg-card del Hub, adaptada a metadatos IndexLy */
  :global(.results-grid.view-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-3); }
  :global(.grid-card) {
    display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); overflow: hidden; color: inherit;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    content-visibility: auto; contain-intrinsic-size: 0 300px; min-width: 0;
  }
  :global(.grid-card:hover) { transform: translateY(-3px); border-color: var(--color-primary-border); box-shadow: 0 12px 32px rgba(0,0,0,0.3), 0 0 0 1px var(--color-primary-border); }
  :global(.grid-card:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  :global(.grid-cover) { position: relative; height: 72px; overflow: hidden; flex-shrink: 0; }
  :global(.grid-cover::after) {
    content: ""; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.16) 1px, transparent 1px); background-size: 14px 14px;
    mask-image: linear-gradient(180deg, black, transparent 90%); -webkit-mask-image: linear-gradient(180deg, black, transparent 90%);
  }
  :global(.grid-cover__initial) {
    position: absolute; left: 12px; bottom: -16px; width: 44px; height: 44px; border-radius: 12px;
    display: grid; place-items: center; font-size: 18px; font-weight: 700; color: #fff;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.28);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); z-index: 1; text-shadow: 0 1px 8px rgba(0,0,0,0.4);
  }
  :global(.grid-cover__pill) {
