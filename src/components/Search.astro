    statsContainer.innerHTML = `Mostrando <strong>${Math.min(visibleCount, totalMatches).toLocaleString("es-ES")}</strong> de <strong>${totalMatches.toLocaleString("es-ES")}</strong>`;
    const gamesToRender = currentFilteredGames.slice(0, visibleCount);
    if (resultsView === "grid") {
      resultsContainer.innerHTML = gamesToRender.map(renderGridCard).join("");
    } else {
      resultsContainer.innerHTML = gamesToRender.map((game) => {
        const metaHtml = renderMetaBadges(game.meta);
        const subtitleHtml = game.subtitle ? `<p class="game-subtitle">${escapeHtml(game.subtitle)}</p>` : "";
        const hasMeta = metaHtml || game.fileSize && game.fileSize !== "Tamaño desconocido";
        return `
        <div class="game-card">
          <div class="game-info-container">
            <h3>${escapeHtml(game.title)}</h3>
            ${subtitleHtml}
            <p class="game-meta"><span class="source-badge">${escapeHtml(game.source)}</span>${hasMeta ? metaHtml : ""}</p>
          </div>
          ${game.link ? `<a href="${escapeHtml(game.link)}" target="_blank" rel="noopener" class="magnet-link">Abrir <span aria-hidden="true">↗</span></a>` : '<span class="no-magnet">Sin enlace</span>'}
        </div>`;
      }).join("");
    }
    loadMoreBtn.style.display = visibleCount < totalMatches ? "inline-flex" : "none";
    injectPluginCardActions();
    injectPluginFooters();
    pluginRuntime.emit("results:render", { count: gamesToRender.length, total: totalMatches, view: resultsView });
    try { document.querySelectorAll("#results .game-card, #results .grid-card").forEach((el, i) => pluginRuntime.emit("items:hydrate", { el, game: gamesToRender[i] })); } catch {}
  }
  // Card de cuadrícula — espejo de las pkg-card del Hub con metadatos IndexLy:
  // cover determinista + inicial, título, subtítulo, fuente + ≤2 badges, pie con
  // tamaño/fecha y botón Abrir siempre visible (sin depender de hover).
  function renderGridCard(game) {
    const title = String(game.title || "Sin título");
    const initial = (title.trim().charAt(0) || "?").toUpperCase();
    const pill = game.fileSize && game.fileSize !== "Tamaño desconocido" ? game.fileSize : game.source || "";
    const subtitleHtml = game.subtitle ? `<p class="grid-subtitle">${escapeHtml(game.subtitle)}</p>` : "";
    let badges = `<span class="source-badge">${escapeHtml(game.source)}</span>`;
    if (game.meta && typeof game.meta === "object") {
      const entries = Object.entries(game.meta).slice(0, 2);
      badges += entries.map(([k, v]) => {
        const text = `${k}: ${v}`;
        return `<span class="meta-badge" title="${escapeHtml(`${k}: ${v}`)}">${escapeHtml(text.length > 28 ? text.slice(0, 27) + "…" : text)}</span>`;
      }).join("");
    }
    let dateVal = "";
    try {
      if (game.meta && typeof game.meta === "object") {
        for (const [k, v] of Object.entries(game.meta)) {
          if (["uploaddate", "upload_date", "fechasubida", "fecha"].includes(String(k).toLowerCase())) { dateVal = formatDateDDMMYY(String(v)); break; }
        }
      }
      if (!dateVal && game.uploadDate) dateVal = formatDateDDMMYY(String(game.uploadDate));
    } catch {}
    const action = game.link
      ? `<a href="${escapeHtml(game.link)}" target="_blank" rel="noopener" class="grid-open">Abrir <span aria-hidden="true">↗</span></a>`
      : `<span class="grid-no-link">Sin enlace</span>`;
    return `
      <div class="grid-card" tabindex="0">
        <div class="grid-cover" style="background:${coverGradientStyle(title)}" aria-hidden="true">
          <span class="grid-cover__initial">${escapeHtml(initial)}</span>
          ${pill ? `<span class="grid-cover__pill">${escapeHtml(String(pill))}</span>` : ""}
        </div>
        <div class="grid-body">
          <h3 class="grid-title">${escapeHtml(title)}</h3>
          ${subtitleHtml}
          <div class="grid-badges">${badges}</div>
        </div>
        <div class="grid-foot">
          ${dateVal ? `<span class="grid-foot__stat">${escapeHtml(dateVal)}</span>` : ""}
          ${action}
        </div>
      </div>`;
  }
