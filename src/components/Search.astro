      resultsContainer.innerHTML = `<div class="empty-results"><p class="no-results">${q ? `Sin resultados para “${escapeHtml(q)}”` : "No hay elementos en las fuentes activas."}</p><span>Prueba otro término o activa más fuentes.</span></div>`;
      statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none";
      injectPluginFooters();
      pluginRuntime.emit("results:render", { count: 0, total: 0, view: resultsView });
      return;
