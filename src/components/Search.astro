    text-decoration: none; font-size: 11.5px; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; border: 1px solid transparent;
  }
  :global(.grid-open:hover) { opacity: 0.88; }
