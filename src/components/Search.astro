  window.removeIndex = async function (id) {
    const idx = indexes.find(i=>i.id===id);
    if (!idx) return;
    showConfirm(`¿Eliminar “${idx.name}”?`, async () => {
      if (undoTimer) clearTimeout(undoTimer);
      const removedIdx = indexes.findIndex(x=>x.id===id);
      lastRemoved = { data: idx, index: removedIdx };
      indexes = indexes.filter((i) => i.id !== id);
      if (indexes.length === 0) { searchInput.setAttribute("disabled", "true"); searchInput.value = ""; }
      await saveIndexesToStorage(); updateApp();
      pluginRuntime.emit("source:removed", { id, name: idx.name });
      showToast(`${idx.name} eliminada`, "info", 6000, {
        label: "Deshacer",
        onClick: async () => {
          if (lastRemoved && lastRemoved.data.id === id) {
            const pos = Math.min(lastRemoved.index, indexes.length);
            indexes.splice(pos, 0, lastRemoved.data);
            lastRemoved = null;
            if (undoTimer) { clearTimeout(undoTimer); undoTimer=null; }
            if (indexes.length>=1) searchInput.removeAttribute("disabled");
            await saveIndexesToStorage(); updateApp();
            showToast("Restaurada", "success");
