  :global(.index-pill) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 10px 10px 10px 12px;
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
  }
  :global(.index-pill:hover) { border-color: var(--color-border-hover); box-shadow: var(--shadow-subtle); transform: translateY(-1px); }
  :global(.index-pill.active) {
    background: linear-gradient(180deg, rgba(255,255,255,0.02), transparent 60%), var(--color-surface-hover);
    border-color: var(--color-border-hover);
  }
  :global(.index-pill.inactive) { opacity: 0.55; }
  :global(.index-pill-info) { display: flex; align-items: center; gap: var(--space-3); min-width: 0; flex: 1; }
  :global(.index-avatar) {
    width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center;
    font-size: 17px; font-weight: 700; flex-shrink: 0;
