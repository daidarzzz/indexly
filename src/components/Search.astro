    let h = 0;
    const str = String(s || "x");
    for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) % 360;
    return h;
  }
  function coverGradientStyle(title) {
    const h = hueFromTitle(title);
    const h2 = (h + 45) % 360;
    return `linear-gradient(120deg, hsl(${h} 65% 32%) 0%, hsl(${h2} 70% 22%) 100%)`;
  }
