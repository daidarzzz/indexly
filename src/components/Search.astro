    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); z-index: 1;
    max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.grid-body) { display: flex; flex-direction: column; gap: 6px; padding: 22px 14px 12px; flex: 1; min-width: 0; }
  :global(.grid-title) {
    margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--color-text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  :global(.grid-subtitle) { margin: 0; font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.grid-badges) { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  :global(.grid-foot) {
    display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--color-text-tertiary);
    border-top: 1px solid var(--color-border); padding: 10px 14px 12px; margin-top: auto;
  }
  :global(.grid-foot__stat) { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.grid-open) {
    margin-left: auto; background: var(--color-text); color: var(--color-bg); padding: 7px 13px; border-radius: var(--radius-full);
    text-decoration: none; font-size: 11.5px; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; border: 1px solid transparent;
  }
  :global(.grid-open:hover) { opacity: 0.88; }
  :global(.grid-no-link) { margin-left: auto; font-size: 10.5px; color: var(--color-text-tertiary); border: 1px dashed var(--color-border); padding: 6px 10px; border-radius: var(--radius-full); flex-shrink: 0; }
  :global(.game-card) {
    background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-4); border-radius: var(--radius-lg);
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    content-visibility: auto; contain-intrinsic-size: 0 80px;
  }
  :global(.game-card:hover) { border-color: var(--color-border-hover); box-shadow: var(--shadow-subtle); transform: translateY(-1px); }
  :global(.game-info-container) { flex: 1; min-width: 0; }
  :global(.game-card h3) {
    margin: 0 0 4px 0; font-size: var(--text-md); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tight);
    line-height: 1.35; color: var(--color-text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  :global(.game-subtitle) { margin: 0 0 6px 0; font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.game-meta) { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0; }
  :global(.source-badge) {
    background: transparent; color: var(--color-text-secondary); border: 1px solid var(--color-border);
    padding: 2px 7px; border-radius: var(--radius-full); font-size: 11px; font-weight: 500; max-width: 20ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.meta-badge) {
    background: var(--color-surface-raised); color: var(--color-text-secondary); border: 1px solid var(--color-border);
    padding: 2px 7px; border-radius: var(--radius-full); font-size: 11px; font-weight: 400; max-width: 24ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.meta-sep) { color: var(--color-text-tertiary); }
  :global(.magnet-link) {
    background: var(--color-text); color: var(--color-bg); padding: 8px 14px; border-radius: var(--radius-full);
    text-decoration: none; font-size: var(--text-sm); font-weight: 500; white-space: nowrap;
