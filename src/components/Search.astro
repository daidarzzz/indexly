  function normalizeStr(s) { return s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase(); }
  function getSearchableText(item) {
    if (item._searchText != null) return item._searchText;
    const parts = [item.title, item.subtitle, item.source];
    if (item.meta) parts.push(...Object.values(item.meta));
    if (item.fileSize) parts.push(item.fileSize);
    const t = normalizeStr(parts.filter(Boolean).join(" "));
    try { Object.defineProperty(item, "_searchText", { value: t, writable: true, enumerable: false }); } catch { item._searchText = t; }
    return t;
  }
  function parseSizeToBytes(str) {
    if (!str || typeof str!=="string") return 0;
    const m = str.trim().match(/^([\d.,]+)\s*(B|KB|MB|GB|TB)?/i);
    if (!m) return 0;
    const n = parseFloat(m[1].replace(",","."));
    const unit = (m[2]||"B").toUpperCase();
    const mult = {B:1,KB:1024,MB:1024**2,GB:1024**3,TB:1024**4};
    return n * (mult[unit]||1);
  }
  function parseDateVal(v) {
    if (!v) return 0;
    const d = new Date(String(v));
    return isNaN(d.getTime()) ? 0 : d.getTime();
  }
  function getItemDate(item) {
    if (item.meta) {
      for (const [k,v] of Object.entries(item.meta)) {
        if (["uploaddate","upload_date","fecha","fechasubida"].includes(k.toLowerCase())) return parseDateVal(v);
      }
    }
    if (item.uploadDate) return parseDateVal(item.uploadDate);
    return 0;
  }

  function debounce(fn, delay) {
    let t;
    return (...args) => { clearTimeout(t); t = setTimeout(()=>fn(...args), delay); };
  }

  function escapeHtml(str) { const d = document.createElement("div"); d.textContent = str == null ? "" : String(str); return d.innerHTML.replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
  function formatDateDDMMYY(val) {
    if (!val || typeof val !== "string") return val;
    const s = val.trim();
    const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[3]}/${iso[2]}/${iso[1].slice(2)}`;
    const d = new Date(s);
    if (!isNaN(d.getTime())) {
      const dd = String(d.getDate()).padStart(2, "0");
      const mm = String(d.getMonth()+1).padStart(2, "0");
      const yy = String(d.getFullYear()).slice(2);
      return `${dd}/${mm}/${yy}`;
    }
    return val;
  }

  // =====================================================
  // Diff de re-import — compara un archivo re-subido con la
  // fuente guardada (mismo nombre) y propone aplicar los cambios.
  // Compara por título normalizado (los ids son posicionales).
  // =====================================================
  const DIFF_MAX_ROWS = 100;
  const DIFF_MARKS = { added: "+", removed: "−", changed: "~" };
  function diffKeyOf(g) {
    return normalizeStr(String((g && g.title) || ""));
  }
  function computeItemsDiff(oldGames, newGames) {
    const oldByTitle = new Map();
    for (const g of oldGames || []) {
      const k = diffKeyOf(g);
      if (!oldByTitle.has(k)) oldByTitle.set(k, []);
      oldByTitle.get(k).push(g);
    }
    const added = [];
    const changed = [];
    let unchangedCount = 0;
    for (const g of newGames || []) {
      const cands = oldByTitle.get(diffKeyOf(g));
      if (!cands || cands.length === 0) { added.push(g); continue; }
      const pairIdx = cands.findIndex((c) => (c.link || "") === (g.link || ""));
      const oldItem = pairIdx >= 0 ? cands.splice(pairIdx, 1)[0] : cands.shift();
      if (pairIdx >= 0) unchangedCount++;
      else changed.push({ oldItem, newItem: g });
      if (cands.length === 0) oldByTitle.delete(diffKeyOf(g));
    }
    const removed = [];
    for (const cands of oldByTitle.values()) removed.push(...cands);
    return { added, removed, changed, unchangedCount };
  }
  function diffSectionHtml(label, kind, rows) {
    if (!rows || rows.length === 0) return "";
    const shown = rows.slice(0, DIFF_MAX_ROWS);
    const extra = rows.length - shown.length;
    const items = shown.map((r) => `
      <div class="diff-row diff-row-${kind}">
        <span class="diff-mark" aria-hidden="true">${DIFF_MARKS[kind]}</span>
        <span class="diff-row-text">
          <strong>${escapeHtml(r.title || "Sin título")}</strong>
          ${r.sub ? `<small>${escapeHtml(r.sub)}</small>` : ""}
          ${r.sub2 ? `<small class="diff-newlink">→ ${escapeHtml(r.sub2)}</small>` : ""}
        </span>
      </div>`).join("");
    return `
      <div class="diff-section">
        <h5 class="diff-section-title">${escapeHtml(label)} <span>(${rows.length.toLocaleString("es-ES")})</span></h5>
        ${items}
        ${extra > 0 ? `<p class="diff-more">… y ${extra.toLocaleString("es-ES")} más</p>` : ""}
      </div>`;
  }
  function openDiffModalFor(entry) {
    activeDiff = entry;
    const d = entry.diff;
    diffTitleEl.textContent = `Cambios en “${entry.indexName}”`;
    diffSummary.innerHTML = `
      <span class="diff-chip diff-chip-added">+${d.added.length.toLocaleString("es-ES")} nuevos</span>
      <span class="diff-chip diff-chip-removed">−${d.removed.length.toLocaleString("es-ES")} eliminados</span>
      <span class="diff-chip diff-chip-changed">~${d.changed.length.toLocaleString("es-ES")} modificados</span>
      <span class="diff-chip">${d.unchangedCount.toLocaleString("es-ES")} sin cambios</span>`;
    diffList.innerHTML =
      diffSectionHtml("Nuevos", "added", d.added.map((g) => ({ title: g.title, sub: g.link || g.subtitle || "" }))) +
      diffSectionHtml("Eliminados", "removed", d.removed.map((g) => ({ title: g.title, sub: g.link || g.subtitle || "" }))) +
      diffSectionHtml("Modificados", "changed", d.changed.map((c) => ({ title: c.newItem.title || c.oldItem.title, sub: c.oldItem.link || "", sub2: c.newItem.link || "" })));
    diffModal.style.display = "flex";
    diffModal.setAttribute("aria-hidden", "false");
    setTimeout(() => diffApply.focus(), 50);
  }
  function enqueueDiff(index, rawData, games) {
    const diff = computeItemsDiff(index.games || [], games);
    if (diff.added.length + diff.removed.length + diff.changed.length === 0) {
      showToast(`“${index.name}” sin cambios respecto a la versión guardada`, "info");
      return;
    }
    pendingDiffQueue.push({ indexId: index.id, indexName: index.name, rawData, games, diff });
  }
  function processDiffQueue() {
    if (activeDiff || pendingDiffQueue.length === 0) return;
    openDiffModalFor(pendingDiffQueue.shift());
  }
  window.closeDiffModal = function() {
    diffModal.style.display = "none";
    diffModal.setAttribute("aria-hidden", "true");
    activeDiff = null;
    processDiffQueue();
  };
  diffApply.addEventListener("click", async () => {
    const entry = activeDiff;
    if (!entry) return;
    const idx = indexes.find((i) => i.id === entry.indexId);
    closeDiffModal();
    if (!idx) return;
    idx.rawData = entry.rawData;
    idx.games = entry.games;
    idx.updatedAt = Date.now();
    await saveIndexesToStorage();
    pluginRuntime.emit("source:updated", { source: { ...idx } });
    updateApp();
    const d = entry.diff;
    showToast(`Fuente actualizada: +${d.added.length} · −${d.removed.length} · ~${d.changed.length}`, "success");
  });
  diffModal.addEventListener("click", (e) => { if (e.target === diffModal) closeDiffModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && diffModal.style.display !== "none") closeDiffModal(); });

  function syncQueryToURL(q) {
    const url = new URL(window.location.href);
    if (q) url.searchParams.set("q", q);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }
  async function loadStoredIndexes() {
    try {
      const saved = await get("indexly_saved_indexes");
      if (saved) {
        indexes = saved.map((item) => {
          const parsedGames = normalizeJson(item.rawData, item.name, item.mapping || null);
          return { id: item.id, name: item.name, active: item.active, rawData: item.rawData, mapping: item.mapping || null, pkg: item.pkg || null, flags: item.flags || null, games: parsedGames, updatedAt: item.updatedAt || null };
        });
        if (indexes.length > 0) searchInput.removeAttribute("disabled");
      }
      const urlQ = new URL(window.location.href).searchParams.get("q");
      if (urlQ) searchInput.value = urlQ;
    } catch (e) { console.error(e); }
    updateApp();
  }
  async function saveIndexesToStorage() {
    try {
      const dataToSave = indexes.map((idx) => ({ id: idx.id, name: idx.name, active: idx.active, rawData: idx.rawData, mapping: idx.mapping || null, pkg: idx.pkg || null, flags: idx.flags || null, updatedAt: idx.updatedAt || null }));
      await set("indexly_saved_indexes", dataToSave);
      // v2: catch-all de cambios en la biblioteca (la emisión granular corre por su cuenta)
      pluginRuntime.emit("sources:changed", {});
    } catch (e) { console.error(e); showToast("Error al guardar en IndexedDB", "error"); }
  }

  async function handleFiles(files) {
    let addedCount = 0;
    const addedSources = [];
    for (const file of files) {
      try {
        const text = await file.text();
        const rawData = parseFileContent(text, file.name);
        const parsedGames = normalizeJson(rawData, file.name, null);
        const baseName = file.name.replace(/\.[^.]+$/i, "");
        const indexName = (rawData && typeof rawData === "object" && !Array.isArray(rawData) && rawData.name) ? rawData.name : baseName;
        const existingIdx = indexes.find((idx) => idx.name.toLowerCase() === indexName.toLowerCase());
        if (existingIdx) { enqueueDiff(existingIdx, rawData, parsedGames); continue; }
        if (parsedGames.length === 0) {
          showToast(`"${file.name}" sin elementos reconocibles — puedes mapearlo`, "warning", 4000);
          const emptyIdx = { id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, mapping: null, pkg: null, games: [] };
          indexes.push(emptyIdx);
          addedSources.push(emptyIdx);
          addedCount++;
          continue;
        }
        const newIdx = { id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, mapping: null, pkg: null, games: parsedGames };
        indexes.push(newIdx);
        addedSources.push(newIdx);
        addedCount++;
      } catch (error) { console.error(error); showToast(`Error en "${file.name}": ${error.message}`, "error"); }
    }
    if (addedCount > 0) {
      searchInput.removeAttribute("disabled");
      await saveIndexesToStorage(); updateApp();
      addedSources.forEach(s => pluginRuntime.emit("source:added", { source: { ...s } }));
      showToast(`${addedCount} fuente(s) añadida(s)`, "success");
    }
    processDiffQueue();
  }

  fileInput.addEventListener("change", async (event) => {
    const files = event.target.files ? Array.from(event.target.files) : [];
    event.target.value = "";
    if (files.length === 0) return;
    await handleFiles(files);
  });

  // Drag & Drop
  ["dragenter","dragover"].forEach(ev => dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add("drag-over"); }));
  ["dragleave","drop"].forEach(ev => dropZone.addEventListener(ev, (e) => { e.preventDefault(); if (ev==="dragleave" && e.target!==dropZone) return; dropZone.classList.remove("drag-over"); }));
  dropZone.addEventListener("drop", async (e) => {
    const allowed = [".json",".csv",".tsv",".yaml",".yml",".xml",".txt"];
    const files = Array.from(e.dataTransfer.files || []).filter(f => allowed.some(ext=>f.name.toLowerCase().endsWith(ext)));
    if (files.length === 0) { showToast("Arrastra archivos .json/.csv/.yaml/.xml/.txt", "warning"); return; }
    await handleFiles(files);
  });
  // Paste archivos
  document.addEventListener("paste", async (e) => {
    const ae = document.activeElement;
    if (ae === searchInput || ae === mapNameInput || ae === hubSearch || ae === hubTokenInput || ae === pluginUrlInput) return;
    if ((pluginAddModal && pluginAddModal.contains(ae)) || (pluginModalEl && pluginModalEl.contains(ae))) return;
    const text = (e.clipboardData || window.clipboardData).getData("text");
    if (!text || !text.trim()) return;
    const t = text.trim();
    if (!t.startsWith("{") && !t.startsWith("[") && !t.includes(",") && !t.includes(":") && !t.startsWith("<")) return;
    try {
      let rawData;
      try { rawData = JSON.parse(t); } catch { rawData = parseFileContent(t, "Pegado.csv"); if (!rawData.items) throw new Error("no parse"); }
      const parsedGames = normalizeJson(rawData, "Pegado");
      if (parsedGames.length === 0) { showToast("El texto pegado no contiene elementos reconocibles", "warning"); return; }
      e.preventDefault();
      const indexName = (rawData && rawData.name) ? rawData.name : `Pegado ${new Date().toLocaleTimeString()}`;
      const existingIdx = indexes.find(x=>x.name.toLowerCase()===indexName.toLowerCase());
      if (existingIdx) { enqueueDiff(existingIdx, rawData, parsedGames); processDiffQueue(); return; }
      const pastedIdx = { id: Date.now().toString()+Math.random().toString(36).substring(2,7), name: indexName, active:true, rawData, mapping:null, pkg: null, games: parsedGames };
      indexes.push(pastedIdx);
      searchInput.removeAttribute("disabled");
      await saveIndexesToStorage(); updateApp();
      pluginRuntime.emit("source:added", { source: { ...pastedIdx } });
      showToast(`Fuente "${indexName}" creada desde portapapeles`, "success");
    } catch {}
  });

  // Export / Import — with selection popups
  function getSelectedIds(container) {
    return Array.from(container.querySelectorAll('input[type="checkbox"]:checked')).filter(c=>!c.classList.contains("io-pkg-check")).map(c=>c.value);
  }
  function fmtCompact(n){
    if (n < 1000) return String(n);
    const k = n/1000;
    if (k >= 100) return Math.round(k) + "k";
    const s = k.toFixed(k >= 10 ? 0 : 1).replace(".", ",").replace(",0", "");
    return s + "k";
  }
  function updateExportUI() {
    const total = indexes.length;
    const checked = exportList.querySelectorAll('input[type="checkbox"]:checked:not(.io-pkg-check)').length;
    exportSelectAll.checked = total>0 && checked===total;
    exportSelectAll.indeterminate = checked>0 && checked<total;
    exportConfirm.textContent = checked===0 ? "Exportar" : `Exportar (${checked})`;
    exportConfirm.disabled = checked===0;
    exportConfirm.style.opacity = checked===0 ? "0.45" : "1";
    exportHint.style.display = checked===0 ? "block" : "none";
    exportHint.textContent = "Selecciona al menos una fuente.";
    if (exportCounter) exportCounter.textContent = `${checked}/${total}`;
    syncPkgHeaders();
  }
  function syncPkgHeaders() {
    exportList.querySelectorAll(".io-pkg-group").forEach(group=>{
      const header = group.querySelector("input.io-pkg-check");
      if (!header) return;
      const children = Array.from(group.querySelectorAll('.io-pkg-children input[type="checkbox"]'));
      if (children.length===0) return;
      const checkedCount = children.filter(c=>c.checked).length;
      header.checked = checkedCount===children.length;
      header.indeterminate = checkedCount>0 && checkedCount<children.length;
    });
  }
  function exportItemHtml(idx, extraClass="") {
    const count = idx.games.length;
    const full = count.toLocaleString("es-ES");
    const tags = [];
    if (idx.pkg && idx.pkg.slug && !extraClass) tags.push(idx.pkg.name || idx.pkg.slug);
    if (idx.mapping) tags.push("mapeado");
    const status = tags.join(" · ");
    return `<label class="io-item${extraClass ? " " + extraClass : ""}"><input type="checkbox" value="${escapeHtml(idx.id)}" checked /><span class="io-item-dot" aria-hidden="true"></span><span class="io-item-info"><strong>${escapeHtml(idx.name)}</strong><small>${escapeHtml(status)}</small></span><span class="io-item-meta"><span class="io-item-badge" title="${escapeHtml(full)} elementos">${escapeHtml(fmtCompact(count))}</span></span></label>`;
  }
  function exportPkgHeaderHtml(slug, pkg, items) {
    const pkgName = (pkg && pkg.name) || slug;
    const total = items.reduce((a, i) => a + (i.games ? i.games.length : 0), 0);
    const full = total.toLocaleString("es-ES");
    const sub = `${items.length} ${items.length===1 ? "fuente" : "fuentes"} · ${full} elementos`;
    return `<div class="io-pkg-group"><label class="io-item io-pkg-header"><input type="checkbox" class="io-pkg-check" data-slug="${escapeHtml(slug)}" checked /><span class="io-pkg-icon" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg></span><span class="io-item-info"><strong>${escapeHtml(pkgName)}</strong><small>${escapeHtml(sub)}</small></span><span class="io-item-meta"><span class="io-item-badge" title="${escapeHtml(full)} elementos">${escapeHtml(fmtCompact(total))}</span></span></label><div class="io-pkg-children">${items.map(i=>exportItemHtml(i, "io-pkg-child")).join("")}</div></div>`;
  }
  function openExportModal() {
    if (indexes.length===0) { showToast("No hay fuentes para exportar", "warning"); return; }
    const groups = new Map();
    const order = [];
    for (const index of indexes) {
      const slug = index.pkg && index.pkg.slug;
      if (!slug) { order.push({ type: "single", index }); continue; }
      if (!groups.has(slug)) { groups.set(slug, { pkg: index.pkg, items: [] }); order.push({ type: "group", slug }); }
      else if (index.pkg && index.pkg.name) { groups.get(slug).pkg = index.pkg; }
      groups.get(slug).items.push(index);
    }
    exportList.innerHTML = order.map((entry)=>{
      if (entry.type === "single") return exportItemHtml(entry.index);
      const g = groups.get(entry.slug);
      if (!g) return "";
      if (g.items.length <= 1) return exportItemHtml(g.items[0]);
      return exportPkgHeaderHtml(entry.slug, g.pkg, g.items);
    }).join("");
    exportList.querySelectorAll('input[type="checkbox"]').forEach(cb=>{
      cb.addEventListener("change", ()=>{
        if (cb.classList.contains("io-pkg-check")) {
          const group = cb.closest(".io-pkg-group");
          group.querySelectorAll('.io-pkg-children input[type="checkbox"]').forEach(c=>{ c.checked = cb.checked; });
        }
        updateExportUI();
      });
    });
    updateExportUI();
    exportModal.style.display="flex";
    exportModal.setAttribute("aria-hidden","false");
  }
