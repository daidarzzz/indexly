---
// src/components/Search.astro — Premium SaaS restyle (lógica intacta)
---

<div class="Search">
  <div class="index-manager-card">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12H14l-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6l2 2h8a2 2 0 0 1 2 2v4Z"/><path d="M14 14v6H4a2 2 0 0 1-2-2v-6"/></svg>
        </div>
        <div>
          <h3>Fuentes</h3>
          <p class="manager-desc">Gestiona tus índices activos</p>
        </div>
      </div>
      <label for="json-input" class="file-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        Añadir JSON
      </label>
      <input type="file" id="json-input" accept=".json" multiple />
    </div>
    <div id="indexes-list" class="indexes-grid-list">
      <p class="no-indexes">No hay índices cargados todavía.</p>
    </div>
  </div>
  <div class="search-wrap">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="text" id="search-input" placeholder="Buscar juegos…" disabled autocomplete="off" spellcheck="false" />
    <span class="search-hint"><kbd>⌘</kbd><span>/</span></span>
  </div>
  <div id="stats-container" class="stats-container"></div>
  <div id="results" class="results-grid"></div>
  <button id="load-more-btn" class="load-more-btn" style="display: none;">Cargar más</button>
  <p class="footer-note">Todo se guarda localmente. Nada se envía a servidores.</p>
</div>

<script>
  import { parseGameJson } from "../utils/gameParser";
  import { get, set } from "idb-keyval";
  let indexes = [];
  let currentFilteredGames = [];
  let visibleCount = 50;
  const fileInput = document.getElementById("json-input");
  const searchInput = document.getElementById("search-input");
  const resultsContainer = document.getElementById("results");
  const indexesListContainer = document.getElementById("indexes-list");
  const loadMoreBtn = document.getElementById("load-more-btn");
  const statsContainer = document.getElementById("stats-container");
  async function loadStoredIndexes() {
    try {
      const saved = await get("indexly_saved_indexes");
      if (saved) {
        indexes = saved.map((item) => {
          const parsedGames = parseGameJson(item.rawData);
          return { id: item.id, name: item.name, active: item.active, rawData: item.rawData, games: parsedGames };
        });
        if (indexes.length > 0) searchInput.removeAttribute("disabled");
      }
    } catch (e) { console.error(e); }
    updateApp();
  }
  async function saveIndexesToStorage() {
    try {
      const dataToSave = indexes.map((idx) => ({ id: idx.id, name: idx.name, active: idx.active, rawData: idx.rawData }));
      await set("indexly_saved_indexes", dataToSave);
    } catch (e) { console.error(e); alert("⚠️ Error al guardar en IndexedDB."); }
  }
  fileInput.addEventListener("change", async (event) => {
    const target = event.target;
    if (!target.files || target.files.length === 0) return;
    const files = Array.from(target.files);
    target.value = "";
    let addedCount = 0; let duplicateNames = [];
    for (const file of files) {
      try {
        const text = await file.text();
        const rawData = JSON.parse(text);
        const parsedGames = parseGameJson(rawData);
        const indexName = rawData.name || file.name.replace(".json", "");
        const exists = indexes.some((idx) => idx.name.toLowerCase() === indexName.toLowerCase());
        if (exists) { duplicateNames.push(indexName); continue; }
        indexes.push({ id: Date.now().toString() + Math.random().toString(36).substring(2, 7), name: indexName, active: true, rawData, games: parsedGames });
        addedCount++;
      } catch (error) { console.error(error); alert(`❌ Error en "${file.name}"`); }
    }
    if (duplicateNames.length > 0) alert(`⚠️ Ya existían y se omitieron:\n• ${duplicateNames.join("\n• ")}`);
    if (addedCount > 0) { searchInput.removeAttribute("disabled"); await saveIndexesToStorage(); updateApp(); }
  });
  window.toggleIndex = async function (id) {
    const idx = indexes.find((i) => i.id === id);
    if (idx) { idx.active = !idx.active; await saveIndexesToStorage(); updateApp(); }
  };
  window.removeIndex = async function (id) {
    indexes = indexes.filter((i) => i.id !== id);
    if (indexes.length === 0) { searchInput.setAttribute("disabled", "true"); searchInput.value = ""; }
    await saveIndexesToStorage(); updateApp();
  };
  function updateApp() {
    renderIndexesManager();
    let activeGames = [];
    indexes.forEach((index) => { if (index.active) activeGames = activeGames.concat(index.games); });
    const query = searchInput.value.toLowerCase();
    currentFilteredGames = query.trim() === "" ? activeGames : activeGames.filter((g) => g.title.toLowerCase().includes(query));
    visibleCount = 50;
    renderCurrentView();
  }
  function renderIndexesManager() {
    if (indexes.length === 0) {
      indexesListContainer.innerHTML = `<div class="empty-state"><div class="empty-icon">◇</div><p class="no-indexes">Sin fuentes aún<br><span>Sube uno o varios .json para empezar</span></p></div>`;
      return;
    }
    indexesListContainer.innerHTML = indexes.map((index) => `
      <div class="index-pill ${index.active ? "active" : "inactive"}">
        <div class="index-pill-info">
          <span class="status-dot"></span>
          <div class="index-text">
            <strong>${escapeHtml(index.name)}</strong>
            <small>${index.games.length} juegos</small>
          </div>
        </div>
        <div class="index-pill-actions">
          <button class="action-btn toggle" onclick="toggleIndex('${index.id}')">${index.active ? "Desactivar" : "Activar"}</button>
          <button class="action-btn delete" onclick="removeIndex('${index.id}')" aria-label="Eliminar">✕</button>
        </div>
      </div>`).join("");
  }
  function escapeHtml(str) { const d = document.createElement("div"); d.textContent = str; return d.innerHTML; }
  function renderCurrentView() {
    if (indexes.length === 0) {
      resultsContainer.innerHTML = ""; statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none";
      searchInput.placeholder = "Sube un JSON arriba para empezar…"; return;
    }
    const totalMatches = currentFilteredGames.length;
    searchInput.placeholder = `Buscar entre ${totalMatches.toLocaleString("es-ES")} juegos…`;
    if (totalMatches === 0) {
      const q = searchInput.value.trim();
      resultsContainer.innerHTML = `<div class="empty-results"><p class="no-results">${q ? `Sin resultados para “${escapeHtml(q)}”` : "No hay juegos en las fuentes activas."}</p><span>Prueba otro término o activa más fuentes.</span></div>`;
      statsContainer.innerHTML = ""; loadMoreBtn.style.display = "none"; return;
    }
    statsContainer.innerHTML = `Mostrando <strong>${Math.min(visibleCount, totalMatches).toLocaleString("es-ES")}</strong> de <strong>${totalMatches.toLocaleString("es-ES")}</strong>`;
    const gamesToRender = currentFilteredGames.slice(0, visibleCount);
    resultsContainer.innerHTML = gamesToRender.map((game) => `
      <div class="game-card">
        <div class="game-info-container">
          <h3>${escapeHtml(game.title)}</h3>
          <p class="game-meta"><span class="source-badge">${escapeHtml(game.source)}</span><span class="meta-sep">·</span><span>${escapeHtml(game.fileSize)}</span></p>
        </div>
        ${game.link ? `<a href="${escapeHtml(game.link)}" target="_blank" rel="noopener" class="magnet-link">Descargar <span>↗</span></a>` : '<span class="no-magnet">Sin enlace</span>'}
      </div>`).join("");
    loadMoreBtn.style.display = visibleCount < totalMatches ? "inline-flex" : "none";
  }
  searchInput.addEventListener("input", () => updateApp());
  loadMoreBtn.addEventListener("click", () => { visibleCount += 50; renderCurrentView(); });
  document.addEventListener("keydown", (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if ((e.key === "/" && document.activeElement !== searchInput && !mod) || (mod && e.key.toLowerCase() === "k")) {
      e.preventDefault(); searchInput.focus();
    }
  });
  loadStoredIndexes();
</script>

<style>
  .Search {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .index-manager-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }
  .manager-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .manager-title { display: flex; align-items: center; gap: var(--space-3); }
  .manager-icon {
    width: 32px; height: 32px;
    display: grid; place-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .manager-header h3 {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    line-height: 1;
  }
  .manager-desc {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-light);
    color: var(--color-text-secondary);
  }
  .file-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 8px 14px;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    user-select: none;
    border: 1px solid transparent;
    transition: opacity 0.15s ease;
  }
  .file-label:hover { opacity: 0.86; }
  #json-input { display: none; }
  .indexes-grid-list { display: flex; flex-direction: column; gap: var(--space-2); min-height: 36px; }
  .empty-state {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4) var(--space-2);
    text-align: center;
  }
  .empty-icon {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-tertiary);
    font-size: 13px;
  }
  :global(.index-pill) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  :global(.index-pill:hover) { border-color: var(--color-border-hover); box-shadow: var(--shadow-subtle); }
  :global(.index-pill.active) { background: var(--color-surface-hover); border-color: var(--color-border-hover); }
  :global(.index-pill.inactive) { opacity: 0.5; border-style: dashed; }
  :global(.index-pill-info) { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
  :global(.status-dot) { width: 7px; height: 7px; border-radius: 50%; background: var(--color-text-tertiary); flex-shrink: 0; }
  :global(.index-pill.active .status-dot) { background: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  :global(.index-text) { display: flex; flex-direction: column; min-width: 0; }
  :global(.index-text strong) {
    font-size: var(--text-md); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tight); color: var(--color-text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 24ch;
  }
  :global(.index-text small) { font-size: var(--text-xs); color: var(--color-text-secondary); }
  :global(.index-pill-actions) { display: flex; align-items: center; gap: var(--space-2); }
  :global(.action-btn) {
    border: 1px solid var(--color-border); background: transparent; padding: 6px 10px; border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--weight-medium); cursor: pointer; transition: all 0.15s ease; line-height: 1;
  }
  :global(.action-btn.toggle) { color: var(--color-text-secondary); }
  :global(.action-btn.toggle:hover) { background: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border-strong); }
  :global(.index-pill.active .action-btn.toggle) { background: var(--color-primary-soft); color: var(--color-primary); border-color: var(--color-primary-border); }
  :global(.action-btn.delete) { color: var(--color-text-tertiary); padding: 6px 8px; border-color: transparent; }
  :global(.action-btn.delete:hover) { background: rgba(239,68,68,0.08); color: #f87171; border-color: rgba(239,68,68,0.15); }
  :global(.no-indexes) { font-size: var(--text-sm); color: var(--color-text-tertiary); margin: 0; text-align: center; }
  :global(.no-indexes span) { color: var(--color-text-secondary); font-weight: var(--weight-light); }
  .search-wrap { position: relative; margin-top: var(--space-8); }
  .search-icon { position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%); pointer-events: none; }
  .search-hint {
    position: absolute; right: var(--space-3); top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: 4px; pointer-events: none;
    background: var(--color-bg); border: 1px solid var(--color-border); border-bottom-width: 1.5px;
    padding: 4px 7px; border-radius: 6px; font-family: var(--font-mono); font-size: 11px; color: var(--color-text-tertiary);
  }
  .search-hint kbd { font-family: inherit; font-size: 11px; font-weight: 500; color: var(--color-text-secondary); }
  #search-input {
    width: 100%; padding: 13px 96px 13px 44px; border-radius: var(--radius-lg);
    background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);
    font-size: var(--text-md); outline: none; transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }
  #search-input::placeholder { color: var(--color-text-tertiary); font-weight: var(--weight-light); }
  #search-input:hover { border-color: var(--color-border-hover); }
  #search-input:focus { background: var(--color-surface-hover); border-color: var(--color-border-hover); box-shadow: var(--shadow-focus); }
  #search-input:disabled { opacity: 0.45; cursor: not-allowed; }
  .stats-container { margin-top: var(--space-4); font-size: var(--text-sm); font-weight: var(--weight-light); color: var(--color-text-secondary); min-height: 16px; }
  .stats-container strong { font-weight: var(--weight-medium); color: var(--color-text); }
  .results-grid { margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  :global(.game-card) {
    background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-4); border-radius: var(--radius-lg);
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  :global(.game-card:hover) { border-color: var(--color-border-hover); box-shadow: var(--shadow-subtle); transform: translateY(-1px); }
  :global(.game-info-container) { flex: 1; min-width: 0; }
  :global(.game-card h3) {
    margin: 0 0 6px 0; font-size: var(--text-md); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tight);
    line-height: 1.35; color: var(--color-text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  :global(.game-meta) { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0; }
  :global(.source-badge) {
    background: transparent; color: var(--color-text-secondary); border: 1px solid var(--color-border);
    padding: 2px 7px; border-radius: var(--radius-full); font-size: 11px; font-weight: 500; max-width: 20ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.meta-sep) { color: var(--color-text-tertiary); }
  :global(.magnet-link) {
    background: var(--color-text); color: var(--color-bg); padding: 8px 14px; border-radius: var(--radius-full);
    text-decoration: none; font-size: var(--text-sm); font-weight: 500; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; border: 1px solid transparent;
    opacity: 0; visibility: hidden; transform: translateX(6px); transition: opacity 0.16s, transform 0.16s, visibility 0.16s; pointer-events: none;
  }
  :global(.game-card:hover .magnet-link), :global(.game-card:focus-within .magnet-link) { opacity: 1; visibility: visible; transform: translateX(0); pointer-events: auto; }
  :global(.magnet-link:hover) { opacity: 0.88; }
  @media (hover: none) { :global(.magnet-link) { opacity: 1; visibility: visible; transform: none; pointer-events: auto; } }
  :global(.no-magnet) { font-size: var(--text-xs); color: var(--color-text-tertiary); border: 1px dashed var(--color-border); padding: 6px 10px; border-radius: var(--radius-full); }
  :global(.empty-results) { text-align: center; padding: var(--space-8) var(--space-6); background: var(--color-surface); border: 1px dashed var(--color-border); border-radius: var(--radius-lg); }
  :global(.no-results) { color: var(--color-text); font-weight: 500; margin: 0 0 6px; }
  :global(.empty-results span) { color: var(--color-text-secondary); font-size: var(--text-sm); }
  .load-more-btn {
    margin: var(--space-6) auto 0; background: transparent; border: 1px solid var(--color-border); color: var(--color-text-secondary);
    padding: 10px 18px; border-radius: var(--radius-full); font-size: var(--text-sm); font-weight: 500; cursor: pointer; transition: all 0.15s;
  }
  .load-more-btn:hover { background: var(--color-surface); color: var(--color-text); border-color: var(--color-border-strong); box-shadow: var(--shadow-subtle); }
  .footer-note { margin: var(--space-8) 0 0; text-align: center; color: var(--color-text-tertiary); font-size: var(--text-xs); }
  @media (max-width: 640px) {
    .Search { padding: var(--space-6) var(--space-4) var(--space-12); }
    .index-manager-card { padding: var(--space-6); }
    :global(.game-card) { flex-direction: column; align-items: stretch; }
    :global(.magnet-link), :global(.no-magnet) { width: 100%; justify-content: center; }
  }
</style>
