  window.saveMapping = async function() {
    const idx = indexes.find(i => i.id === mappingModalIndexId);
    if (!idx) return;
    const newName = mapNameInput.value.trim();
    if (!newName) { showToast("El nombre no puede estar vacío", "warning"); return; }
    const duplicate = indexes.some(x => x.id !== idx.id && x.name.toLowerCase() === newName.toLowerCase());
    if (duplicate) { showToast(`Ya existe "${newName}"`, "warning"); return; }
    const titleKey = mapTitleSelect.value;
    if (!titleKey) { showToast("Elige Título", "warning"); return; }
    const mapping = { titleKey, subtitleKey: mapSubtitleSelect.value || null, linkKey: mapLinkSelect.value || null };
