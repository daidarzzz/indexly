  importSelectConfirm.addEventListener("click", async ()=>{
    if (!pendingImportData) return;
    const idxs = getSelectedIds(importSelectList).map(Number);
    if (idxs.length===0) return;
    let imported=0; let skipped=[]; const importedSources=[];
    for (const i of idxs) {
      const item = pendingImportData[i];
      if (!item || !item.rawData) { skipped.push(String(item?.name||i)); continue; }
      if (indexes.some(x=>x.name.toLowerCase()===String(item.name).toLowerCase())) { skipped.push(item.name); continue; }
      const parsed = normalizeJson(item.rawData, item.name, item.mapping || null);
      const importedIdx = { id: Date.now().toString()+Math.random().toString(36).substring(2,7), name: item.name, active: item.active ?? true, rawData: item.rawData, mapping: item.mapping||null, pkg: item.pkg||null, games: parsed };
      indexes.push(importedIdx);
      importedSources.push(importedIdx);
      imported++;
    }
    const hadSkipped = skipped.length>0;
    closeImportSelectModal();
    if (imported) {
      searchInput.removeAttribute("disabled");
      await saveIndexesToStorage(); updateApp();
      importedSources.forEach(s => pluginRuntime.emit("source:added", { source: { ...s } }));
      showToast(`${imported} fuente(s) importadas`, "success");
    }
    if (hadSkipped) showToast(`Omitidas: ${skipped.join(", ")}`, "warning", 4000);
    if (!imported && !hadSkipped) showToast("Nada que importar", "warning");
