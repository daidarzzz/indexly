    .filter-chips { order: 1; width: 100%; }
    .filter-chips .chip { flex: 1; justify-content: center; }
    .sort-select { order: 2; flex: 1; }
    .view-toggle { order: 3; }
  }
  /* Toasts — minimal, static (no animation) */
  :global(.toast-container) { position: fixed; bottom: 18px; right: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 100; pointer-events: none; }
  :global(.toast) { display: inline-flex; align-items: center; gap: 0; background: #0f141e; border: 1px solid #1e293b; color: #94a3b8; padding: 0; border-radius: 10px; font-size: 12px; font-weight: 400; letter-spacing: 0.01em; box-shadow: 0 10px 28px rgba(0,0,0,0.42), 0 0 0 1px rgba(255,255,255,0.03) inset; pointer-events: auto; max-width: 380px; line-height: 1.4; overflow: hidden; }
  :global(.toast-text) { padding: 10px 14px; display: flex; align-items: center; min-width: 0; flex: 1; }
  :global(.toast-text span) { color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 22ch; }
  :global(.toast-success .toast-text span::before) { content: ""; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #22c55e; margin-right: 8px; vertical-align: middle; flex-shrink: 0; }
  :global(.toast-warning .toast-text span::before) { content: ""; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #eab308; margin-right: 8px; vertical-align: middle; flex-shrink: 0; }
  :global(.toast-error) { border-color: rgba(239,68,68,0.22); background: #12151f; }
  :global(.toast-error .toast-text span::before) { content: ""; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #ef4444; margin-right: 8px; vertical-align: middle; flex-shrink: 0; }
  :global(.toast-sep) { width: 1px; align-self: stretch; background: #1e293b; flex-shrink: 0; margin: 6px 0; }
