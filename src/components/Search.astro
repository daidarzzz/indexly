    background: rgba(255,255,255,0.012);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .index-manager-card.drag-over .drop-hint { border-color: var(--color-primary-border); color: var(--color-primary); background: var(--color-primary-soft); }
  .drop-hint svg { flex-shrink: 0; }
  .drop-hint kbd {
    font-family: var(--font-mono); font-size: 10px; color: var(--color-text-secondary);
    background: var(--color-bg); border: 1px solid var(--color-border); border-bottom-width: 2px;
    border-radius: 6px; padding: 1px 6px;
  }
  .controls { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 18px; padding: 6px 10px; background: #0a0f1c; border: 1px solid #1a2332; border-radius: 999px; flex-wrap: wrap; }
  .controls-sep { width: 1px; align-self: stretch; background: #1e293b; margin: 6px 0; flex-shrink: 0; }
  .filter-chips { display: flex; gap: 2px; padding: 0; background: transparent; border: none; }
  .chip { background: transparent; border: none; color: #64748b; padding: 7px 13px; border-radius: 999px; font-size: 11px; font-weight: 500; letter-spacing: 0.01em; cursor: pointer; transition: background 0.15s, color 0.15s; min-height: 30px; }
  .chip.active { background: #fff; color: #0f172a; box-shadow: 0 1px 6px rgba(0,0,0,0.15); }
  .chip:not(.active):hover { color: #cbd5e1; }
  /* Toggle vista lista/cuadrícula — mismo lenguaje que .filter-chips */
  .chip:not(.active):hover { color: #cbd5e1; background: rgba(255,255,255,0.04); }
  .chip:focus-visible { outline: 1px solid var(--color-primary); outline-offset: 2px; }
  .view-toggle { display: flex; gap: 2px; padding: 0; background: transparent; border: none; }
  .chip.view-btn { display: inline-flex; align-items: center; gap: 6px; }
  .chip.view-btn svg { flex-shrink: 0; }
  .sort-select { background-color: transparent; border: none; color: #94a3b8; padding: 7px 26px 7px 10px; border-radius: 999px; font-size: 11px; font-weight: 500; letter-spacing: 0.01em; cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%2364748b' stroke-width='1.3' stroke-linecap='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 8px center; min-height: 30px; }
  .sort-select:hover { color: #e2e8f0; background-color: rgba(255,255,255,0.04); }
  .sort-select:focus { outline: none; box-shadow: 0 0 0 3px rgba(14,165,233,0.08); }
  .sort-select option { background: #0f141e; color: #e2e8f0; }
  .sort-select:focus { outline: none; border-color: #24344f; box-shadow: 0 0 0 3px rgba(14,165,233,0.08); }
  .sort-select:hover { border-color: #24344f; color: #cbd5e1; }
  .quota-info { font-size: var(--text-xs); color: var(--color-text-tertiary); min-height: 14px; margin-top: var(--space-2); text-align: right; }
  .indexes-grid-list { display: flex; flex-direction: column; gap: var(--space-2); min-height: 36px; }
  /* Estado vacío (inyectado por JS → :global, si no Astro no aplica los estilos) */
  :global(.empty-state) {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-4) var(--space-6);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: rgba(255,255,255,0.012);
  }
  :global(.empty-icon) {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border: 1px dashed var(--color-border-strong);
    border-radius: 12px;
    color: var(--color-text-secondary);
    font-size: 16px;
    background: var(--color-bg);
  }
  :global(.empty-cta) {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--color-text); color: var(--color-bg);
    padding: 10px 18px; border-radius: 999px;
