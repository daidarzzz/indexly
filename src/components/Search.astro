---
// src/components/Search.astro — Premium SaaS restyle + generic normalizer + P0 polish
---

<div class="Search">
  <div class="index-manager-card" id="drop-zone">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12H14l-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6l2 2h8a2 2 0 0 1 2 2v4Z"/><path d="M14 14v6H4a2 2 0 0 1-2-2v-6"/></svg>
        </div>
        <div>
          <h3>Fuentes <span id="fuentes-count" class="fuentes-count" aria-live="polite"></span></h3>
          <p class="manager-desc">Gestiona tus índices activos</p>
        </div>
      </div>
      <div class="manager-actions">
        <button type="button" id="collapse-fuentes" class="collapse-btn" aria-expanded="true" aria-controls="indexes-list bulk-actions" aria-label="Comprimir fuentes" title="Comprimir">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <button type="button" id="export-btn" class="action-btn secondary" title="Descargar backup">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3M8 7l4-4 4 4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
          Exportar
        </button>
        <button type="button" id="import-btn" class="action-btn secondary" title="Restaurar backup">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13M8 12l4 4 4-4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
          Importar
        </button>
        <input type="file" id="import-input" accept=".json,.gz,application/gzip,application/json" class="sr-only" tabindex="-1" />
        <label for="json-input" class="file-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Añadir archivo
        </label>
        <input type="file" id="json-input" accept=".json,.csv,.tsv,.yaml,.yml,.xml,.txt" multiple class="sr-only" />
      </div>
    </div>
    <div id="indexes-list" class="indexes-grid-list">
      <p class="no-indexes">No hay índices cargados todavía.</p>
    </div>
    <div id="bulk-actions" class="bulk-actions" style="display:none">
      <span id="bulk-summary" class="bulk-summary" aria-live="polite"></span>
      <div class="bulk-tools">
        <div class="bulk-seg" role="group" aria-label="Activar o desactivar todo">
          <button type="button" id="bulk-enable" class="bulk-seg-btn">Activar todo</button>
          <button type="button" id="bulk-disable" class="bulk-seg-btn">Desactivar todo</button>
        </div>
        <button type="button" id="bulk-clear" class="bulk-clear">Borrar todo</button>
      </div>
    </div>
    <p class="drop-hint">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3M8 7l4-4 4 4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
      Arrastra archivos aquí o pega con <kbd>Ctrl</kbd> + <kbd>V</kbd>
    </p>
  </div>
  <div class="index-manager-card hub-card" id="hub-card">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="2.5"/></svg>
        </div>
        <div>
          <h3>IndexlyHub <span id="hub-status" class="hub-status">desconectado</span></h3>
          <p class="manager-desc" id="hub-desc">Explora paquetes de la comunidad</p>
        </div>
      </div>
      <div class="manager-actions">
        <button type="button" id="hub-collapse" class="collapse-btn" aria-expanded="true" aria-controls="hub-offline hub-online" aria-label="Comprimir IndexlyHub" title="Comprimir">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <button type="button" id="hub-card-btn" class="action-btn secondary">Conectar</button>
      </div>
    </div>
    <div id="hub-offline" class="hub-offline">
      <p>Conecta tu API de IndexlyHub para explorar paquetes populares, ver tus favoritos e importarlos sin salir de aquí.</p>
      <button type="button" class="file-label" onclick="openHubModal()">Conectar con el Hub</button>
    </div>
    <div id="hub-online" style="display:none">
      <div class="hub-toolbar">
        <div class="hub-tabs" role="group" aria-label="Explorar Hub">
          <button type="button" class="chip active" data-hubtab="popular">Populares</button>
          <button type="button" class="chip" data-hubtab="recent">Recientes</button>
          <button type="button" class="chip" data-hubtab="plugins">Plugins</button>
          <button type="button" class="chip" data-hubtab="favs">Favoritos</button>
        </div>
        <input type="text" id="hub-search" class="mapping-input hub-search" placeholder="Buscar paquetes…" autocomplete="off" spellcheck="false" aria-label="Buscar paquetes en el Hub" />
      </div>
      <div id="hub-list" class="hub-list" aria-live="polite"></div>
      <button type="button" id="hub-more" class="load-more-btn" style="display:none">Cargar más</button>
    </div>
  </div>
  <div class="index-manager-card plugins-card" id="plugins-card">
    <div class="manager-header">
      <div class="manager-title">
        <div class="manager-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
        </div>
        <div>
          <h3>Plugins <span id="plugins-count" class="fuentes-count" aria-live="polite"></span></h3>
          <p class="manager-desc" id="plugins-desc">Amplía IndexLy con extensiones</p>
        </div>
      </div>
      <div class="manager-actions">
        <button type="button" id="plugins-collapse" class="collapse-btn" aria-expanded="true" aria-controls="plugins-list" aria-label="Comprimir plugins" title="Comprimir">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <button type="button" id="plugins-add-btn" class="action-btn secondary" onclick="openPluginAddModal()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Añadir plugin
        </button>
      </div>
    </div>
    <div id="plugins-list" class="plugins-list" aria-live="polite"></div>
  </div>
  <div id="plugin-tabbar" class="plugin-tabbar" role="group" aria-label="Secciones de plugins" style="display:none"></div>
  <div class="search-wrap">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="text" id="search-input" placeholder="Buscar…" disabled autocomplete="off" spellcheck="false" aria-label="Buscar en índices" />
  </div>
  <div class="controls">
    <div class="filter-chips" role="group" aria-label="Filtrar por enlace">
      <button type="button" class="chip active" data-filter="all">Todos</button>
      <button type="button" class="chip" data-filter="link">Con enlace</button>
      <button type="button" class="chip" data-filter="nolink">Sin enlace</button>
      <span id="plugin-chips" class="plugin-chips" role="group" aria-label="Filtros de plugins"></span>
    </div>
    <span class="controls-sep" aria-hidden="true"></span>
    <select id="sort-select" class="sort-select" aria-label="Ordenar">
      <option value="relevance">Relevancia</option>
      <option value="title-asc">Título A-Z</option>
      <option value="title-desc">Título Z-A</option>
      <option value="size-desc">Tamaño ↓</option>
      <option value="size-asc">Tamaño ↑</option>
      <option value="date-desc">Fecha reciente</option>
      <option value="date-asc">Fecha antigua</option>
    </select>
    <span class="controls-sep" aria-hidden="true"></span>
    <div class="view-toggle" role="group" aria-label="Vista de resultados">
      <button type="button" class="chip view-btn active" data-view="list" aria-pressed="true" title="Vista de lista">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg>
        Lista
      </button>
      <button type="button" class="chip view-btn" data-view="grid" aria-pressed="false" title="Vista de cuadrícula">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Cuadrícula
      </button>
    </div>
  </div>
  <div id="quota-info" class="quota-info" aria-live="polite"></div>
  <div id="plugin-sections" class="plugin-sections" aria-live="polite"></div>
  <div id="stats-container" class="stats-container" aria-live="polite" aria-atomic="true"></div>
  <div id="results" class="results-grid" aria-live="polite"></div>
  <button type="button" id="load-more-btn" class="load-more-btn" style="display: none;">Cargar más</button>
  <div id="plugin-footers"></div>
  <p class="footer-note" id="footer-note">Todo se guarda localmente. Nada se envía a servidores.</p>
</div>

<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

<div id="confirm-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <h4 id="confirm-title">Confirmar</h4>
    <p id="confirm-msg" class="mapping-desc"></p>
    <div class="mapping-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeConfirmModal()">Cancelar</button>
      <button type="button" class="mapping-btn danger" id="confirm-ok">Confirmar</button>
    </div>
  </div>
</div>

<div id="mapping-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="mapping-title">
    <div class="mapping-header">
      <h4 id="mapping-title">Ajustar fuente</h4>
      <button type="button" class="mapping-close" onclick="closeMappingModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Renombra la fuente y elige qué campo de tu archivo corresponde a cada rol.</p>
    <div class="mapping-fields">
      <label class="mapping-label" for="map-name">Nombre de la fuente
        <input id="map-name" type="text" class="mapping-input" placeholder="Ej: Mis Juegos" maxlength="60" />
      </label>
      <label class="mapping-label" for="map-title">Título (obligatorio)
        <select id="map-title"></select>
      </label>
      <label class="mapping-label" for="map-subtitle">Subtítulo (opcional)
        <select id="map-subtitle"></select>
      </label>
      <label class="mapping-label" for="map-link">Enlace (opcional)
        <select id="map-link"></select>
      </label>
      <div id="map-flags" class="map-flags"></div>
    </div>
    <p class="mapping-hint">Vista previa: <span id="mapping-preview">—</span></p>
    <div class="mapping-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeMappingModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" onclick="saveMapping()">Aplicar</button>
    </div>
  </div>
</div>

<div id="export-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog io-dialog" role="dialog" aria-modal="true" aria-labelledby="export-title">
    <div class="mapping-header">
      <div class="io-heading">
        <div class="io-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3M8 7l4-4 4 4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
        </div>
        <h4 id="export-title">Exportar fuentes</h4>
      </div>
      <button type="button" class="mapping-close" onclick="closeExportModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Selecciona las fuentes que quieres guardar en el backup.</p>
    <div class="io-toolbar">
      <label class="io-select-all"><input type="checkbox" id="export-select-all" checked /> Seleccionar todo</label>
      <span id="export-counter" class="io-counter">0/0</span>
    </div>
    <div id="export-list" class="io-list" role="group" aria-label="Fuentes a exportar"></div>
    <p id="export-hint" class="mapping-hint" style="display:none"></p>
    <div class="mapping-actions io-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeExportModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" id="export-confirm">Exportar</button>
    </div>
  </div>
</div>

<div id="import-select-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog io-dialog" role="dialog" aria-modal="true" aria-labelledby="import-select-title">
    <div class="mapping-header">
      <div class="io-heading">
        <div class="io-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v8M8 12l4 4 4-4"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/><path d="M4 8v-1a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1"/></svg>
        </div>
        <h4 id="import-select-title">Importar fuentes</h4>
      </div>
      <button type="button" class="mapping-close" onclick="closeImportSelectModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Elige qué fuentes del backup quieres añadir.</p>
    <div class="io-toolbar">
      <label class="io-select-all"><input type="checkbox" id="import-select-all" /> Seleccionar todo</label>
      <span id="import-counter" class="io-counter">0/0</span>
    </div>
    <div id="import-select-list" class="io-list" role="group" aria-label="Fuentes a importar"></div>
    <p id="import-hint" class="mapping-hint" style="display:none"></p>
    <div class="mapping-actions io-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeImportSelectModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" id="import-select-confirm">Importar</button>
    </div>
  </div>
</div>

<div id="diff-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog io-dialog" role="dialog" aria-modal="true" aria-labelledby="diff-title">
    <div class="mapping-header">
      <div class="io-heading">
        <div class="io-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
        </div>
        <h4 id="diff-title">Cambios en la fuente</h4>
      </div>
      <button type="button" class="mapping-close" onclick="closeDiffModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">El archivo coincide con una fuente existente. Estos cambios se aplicarán al confirmar:</p>
    <div id="diff-summary" class="diff-summary" aria-live="polite"></div>
    <div id="diff-list"></div>
    <div class="mapping-actions io-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeDiffModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" id="diff-apply">Aplicar cambios</button>
    </div>
  </div>
</div>

<div id="hub-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="hub-modal-title">
    <div class="mapping-header">
      <h4 id="hub-modal-title">Conectar IndexlyHub</h4>
      <button type="button" class="mapping-close" onclick="closeHubModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Pega un token <code>ih_…</code> creado en tu perfil del Hub (<a href="https://indexlyhub.daida.net/profile" target="_blank" rel="noopener">indexlyhub.daida.net/profile</a> → Tokens de API). Desbloquea explorar, importar y favoritos.</p>
    <div class="mapping-fields">
      <label class="mapping-label" for="hub-token">Token de API
        <input id="hub-token" type="password" class="mapping-input" placeholder="ih_…" autocomplete="off" spellcheck="false" maxlength="120" />
      </label>
    </div>
    <p class="mapping-hint">El token se guarda solo en este navegador. Equivale a tu contraseña: no lo compartas. Puedes revocarlo cuando quieras desde el Hub.</p>
    <div class="mapping-actions">
      <button type="button" class="mapping-btn secondary" onclick="closeHubModal()">Cancelar</button>
      <button type="button" class="mapping-btn danger" id="hub-disconnect" style="display:none">Desconectar</button>
      <button type="button" class="mapping-btn primary" id="hub-save">Conectar</button>
    </div>
  </div>
</div>

<div id="plugin-add-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog io-dialog" role="dialog" aria-modal="true" aria-labelledby="plugin-add-title">
    <div class="mapping-header">
      <div class="io-heading">
        <div class="io-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a1a9b8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
        </div>
        <h4 id="plugin-add-title">Añadir plugin</h4>
      </div>
      <button type="button" class="mapping-close" onclick="closePluginAddModal()" aria-label="Cerrar">✕</button>
    </div>
    <p class="mapping-desc">Instala desde un archivo .js o una URL. El plugin se ejecuta en tu navegador con acceso a tus fuentes: revisa siempre su código y origen.</p>
    <div class="hub-toolbar">
      <div class="hub-tabs" role="group" aria-label="Origen del plugin">
        <button type="button" class="chip active" data-psrc="file">Fichero</button>
        <button type="button" class="chip" data-psrc="url">URL</button>
      </div>
    </div>
    <div id="plugin-add-file" class="plugin-add-pane">
      <label for="plugin-file-input" class="file-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Seleccionar archivo .js
      </label>
      <input type="file" id="plugin-file-input" accept=".js,text/javascript,application/javascript" class="sr-only" />
      <span id="plugin-file-name" class="plugin-src-name" aria-live="polite"></span>
    </div>
    <div id="plugin-add-url" class="plugin-add-pane" style="display:none">
      <input type="text" id="plugin-url-input" class="mapping-input plugin-url-input" placeholder="https://…/plugin.js" autocomplete="off" spellcheck="false" aria-label="URL del plugin" />
      <button type="button" class="action-btn secondary" id="plugin-url-fetch">Descargar</button>
    </div>
    <div id="plugin-preview" class="plugin-preview" style="display:none" aria-live="polite"></div>
    <p id="plugin-add-error" class="mapping-hint" style="display:none"></p>
    <div class="mapping-actions io-actions">
      <button type="button" class="mapping-btn secondary" onclick="closePluginAddModal()">Cancelar</button>
      <button type="button" class="mapping-btn primary" id="plugin-add-confirm" disabled>Instalar</button>
    </div>
  </div>
</div>

<div id="plugin-modal" class="mapping-overlay" style="display:none" aria-hidden="true">
  <div class="mapping-dialog" role="dialog" aria-modal="true" aria-labelledby="plugin-modal-title">
    <div class="mapping-header">
      <h4 id="plugin-modal-title">—</h4>
      <button type="button" class="mapping-close" onclick="closePluginModal()" aria-label="Cerrar">✕</button>
    </div>
    <div id="plugin-modal-body" class="plugin-modal-body"></div>
    <div id="plugin-modal-actions" class="mapping-actions"></div>
  </div>
</div>

<script>
  import { normalizeJson, getAvailableKeys, getAutoMapping } from "../utils/normalizer";
  import { parseFileContent } from "../utils/loaders";
  import { get, set } from "idb-keyval";
  import { compactIndexes, inflateIndexes, migrateV1, isV2Envelope } from "../utils/exportCodec";
  import { compressJsonToBlob, decompressBlobToText, hasCompressionSupport } from "../utils/compress";
  import { createPluginRuntime, getStoredPlugins, saveStoredPlugins, parsePluginHeader, pluginCodeBytes, compilePlugin, MAX_PLUGIN_BYTES } from "../utils/plugins";
  let indexes = [];
  let currentFilteredGames = [];
  let visibleCount = 50;
  let mappingModalIndexId = null;
  let lastRemoved = null;
  let undoTimer = null;
  let activeFilter = "all";
  let sortBy = "relevance";
  // Vista de resultados: "list" (defecto) o "grid". Persiste en localStorage.
  let resultsView = "list";
