  function showToast(message, type="info", duration=3000, action=null) {
    const toast = document.createElement("div");
    toast.className = `toast toast-${type}`;
    toast.setAttribute("role", "status");
    const textWrap = document.createElement("div");
    textWrap.className = "toast-text";
    const span = document.createElement("span");
    span.textContent = message;
    textWrap.appendChild(span);
    toast.appendChild(textWrap);
    if (action) {
      const sep = document.createElement("span");
      sep.className = "toast-sep";
      sep.setAttribute("aria-hidden","true");
      toast.appendChild(sep);
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "toast-action";
      btn.textContent = action.label;
      btn.addEventListener("click", async (e) => {
        e.preventDefault(); e.stopPropagation();
        try { await action.onClick(); } catch(err){ console.error(err); }
        toast.remove();
      });
      toast.appendChild(btn);
    }
    toastContainer.appendChild(toast);
    let t = setTimeout(() => dismiss(), duration);
    function dismiss(){ toast.remove(); if (action && lastRemoved) lastRemoved = null; }
    toast.addEventListener("mouseenter", ()=> clearTimeout(t));
    toast.addEventListener("mouseleave", ()=> { t = setTimeout(()=>dismiss(), 1200); });
    return { dismiss };
  }

  let confirmCallback = null;
  let confirmCancelCb = null;
  function showConfirm(msg, onConfirm, onCancel) {
