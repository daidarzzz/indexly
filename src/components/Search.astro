  }
  if (hubConnectBtn) hubConnectBtn.addEventListener("click", hubToggleConnect);
  if (hubCardBtn) hubCardBtn.addEventListener("click", hubToggleConnect);
  if (hubDisconnectBtn) hubDisconnectBtn.addEventListener("click", () => { hubDisconnect(false); closeHubModal(); });
  if (hubTokenInput) hubTokenInput.addEventListener("keydown", (e) => { if (e.key === "Enter") hubSaveBtn.click(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && hubModal.style.display !== "none") closeHubModal(); });

  let hubCollapsed = localStorage.getItem("indexly_hub_collapsed") === "1";
  function applyHubCollapsed(v) {
    hubCollapsed = v;
    hubCard.classList.toggle("collapsed", v);
    if (hubCollapseBtn) {
      hubCollapseBtn.setAttribute("aria-expanded", String(!v));
      hubCollapseBtn.setAttribute("aria-label", v ? "Expandir IndexlyHub" : "Comprimir IndexlyHub");
      hubCollapseBtn.title = v ? "Expandir" : "Comprimir";
    }
    localStorage.setItem("indexly_hub_collapsed", v ? "1" : "0");
  }
  if (hubCollapseBtn) {
    applyHubCollapsed(hubCollapsed);
    hubCollapseBtn.addEventListener("click", () => applyHubCollapsed(!hubCard.classList.contains("collapsed")));
