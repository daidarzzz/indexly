  #search-input:hover { border-color: var(--color-border-hover); }
  #search-input:focus { background: var(--color-surface-hover); border-color: var(--color-border-hover); box-shadow: var(--shadow-focus); }
  #search-input:disabled { opacity: 0.45; cursor: not-allowed; }
  .stats-container { margin-top: var(--space-4); font-size: var(--text-sm); font-weight: var(--weight-light); color: var(--color-text-secondary); min-height: 16px; }
  .stats-container strong { font-weight: var(--weight-medium); color: var(--color-text); }
  .results-grid { margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  /* Vista cuadrícula — espejo de las pkg-card del Hub, adaptada a metadatos IndexLy */
  :global(.results-grid.view-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-3); }
  :global(.grid-card) {
    display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); overflow: hidden; color: inherit;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    content-visibility: auto; contain-intrinsic-size: 0 300px; min-width: 0;
  }
  :global(.grid-card:hover) { transform: translateY(-3px); border-color: var(--color-primary-border); box-shadow: 0 12px 32px rgba(0,0,0,0.3), 0 0 0 1px var(--color-primary-border); }
  :global(.grid-card:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  :global(.grid-cover) { position: relative; height: 72px; overflow: hidden; flex-shrink: 0; }
  :global(.grid-cover::after) {
    content: ""; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.16) 1px, transparent 1px); background-size: 14px 14px;
    mask-image: linear-gradient(180deg, black, transparent 90%); -webkit-mask-image: linear-gradient(180deg, black, transparent 90%);
  }
  :global(.grid-cover__initial) {
    position: absolute; left: 12px; bottom: -16px; width: 44px; height: 44px; border-radius: 12px;
    display: grid; place-items: center; font-size: 18px; font-weight: 700; color: #fff;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.28);
