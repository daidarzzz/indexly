  // ---- IndexlyHub: conexión + explorar + importar + favoritos ----
  const HUB_API = "https://indexlyhub.daida.net/api/v1";
  const hubConnectBtn = document.getElementById("hub-connect-btn");
  const hubConnectLabel = document.getElementById("hub-connect-label");
  const hubUploadLink = document.getElementById("hub-upload-link");
  const hubCardBtn = document.getElementById("hub-card-btn");
  const hubStatus = document.getElementById("hub-status");
  const hubDesc = document.getElementById("hub-desc");
  const hubOffline = document.getElementById("hub-offline");
  const hubOnline = document.getElementById("hub-online");
  const hubList = document.getElementById("hub-list");
  const hubMore = document.getElementById("hub-more");
  const hubSearch = document.getElementById("hub-search");
  const hubModal = document.getElementById("hub-modal");
  const hubTokenInput = document.getElementById("hub-token");
  const hubSaveBtn = document.getElementById("hub-save");
  const hubDisconnectBtn = document.getElementById("hub-disconnect");
  const hubCollapseBtn = document.getElementById("hub-collapse");
  const hubCard = document.getElementById("hub-card");
  const footerNote = document.getElementById("footer-note");
  const FOOTER_DEFAULT = "Todo se guarda localmente. Nada se envía a servidores.";
  const FOOTER_HUB = "Tus archivos siguen en local. Explorar e importar usa la API de IndexlyHub.";
  const HUB_CACHE_MS = 3 * 60 * 1000;

  let hubToken = null;
  try { hubToken = localStorage.getItem("indexly_hub_token") || null; } catch {}
  let hubTab = "popular";
  let hubPage = 1;
  let hubQuery = "";
  let hubLoading = false;
  const hubCache = new Map();
  const hubSeen = new Map();

  function updateHubUI() {
    const on = !!hubToken;
    if (hubConnectLabel) hubConnectLabel.textContent = on ? "Hub" : "Conectar Hub";
    if (hubConnectBtn) {
      hubConnectBtn.classList.toggle("connected", on);
      hubConnectBtn.title = on ? "Conectado — clic para desconectar" : "Conectar tu API de IndexlyHub";
    }
    if (hubUploadLink) hubUploadLink.style.display = on ? "" : "none";
    if (hubCardBtn) hubCardBtn.textContent = on ? "Cambiar" : "Conectar";
    if (hubStatus) { hubStatus.textContent = on ? "conectado" : "desconectado"; hubStatus.classList.toggle("on", on); }
    if (hubDesc) hubDesc.textContent = on ? "Paquetes populares, recientes y tus favoritos" : "Explora paquetes de la comunidad";
    if (hubOffline) hubOffline.style.display = on ? "none" : "";
    if (hubOnline) hubOnline.style.display = on ? "" : "none";
    if (footerNote) footerNote.textContent = on ? FOOTER_HUB : FOOTER_DEFAULT;
    if (!on) {
      if (hubList) hubList.innerHTML = "";
      if (hubMore) hubMore.style.display = "none";
    }
  }
  function hubDisconnect(quiet) {
    hubToken = null;
    try { localStorage.removeItem("indexly_hub_token"); } catch {}
    hubCache.clear();
    hubSeen.clear();
    updateHubUI();
    if (!quiet) showToast("Desconectado del Hub", "info");
  }
  window.openHubModal = function() {
