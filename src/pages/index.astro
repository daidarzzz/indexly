---
import Layout from "../layouts/Layout.astro";
import Title from "../components/Title.astro";
import Search from "../components/Search.astro";
---

<Layout title="IndexLy">
  <main>
    <Title />
    <Search />
  </main>
  <footer class="site-footer">
    <span>IndexLy</span> · Hecho para organizar tu biblioteca. <a href="https://github.com/daidarzzz/indexly" target="_blank" rel="noopener">Open source</a>
  </footer>
</Layout>

<style>
  main { display: block; }
  .site-footer {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-6) var(--space-8);
    text-align: center;
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--weight-light);
    letter-spacing: 0.02em;
    border-top: 1px solid var(--color-border);
  }
  .site-footer span { color: var(--color-text); font-weight: var(--weight-medium); }
  .site-footer a { color: var(--color-text-secondary); text-decoration: none; border-bottom: 1px solid transparent; transition: color 0.15s ease, border-color 0.15s ease; }
  .site-footer a:hover { color: var(--color-text); border-color: var(--color-border-strong); }
</style>
