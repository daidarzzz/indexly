<style is:global>
  /* =====================================================
     IndexLy — Premium Design System
     Inspired by Vercel / Stripe / Linear
     Grid: 4px base (4,8,16,32,64)
     ===================================================== */

  :root {
    /* — Paleta oscuros profundos (no negro puro) — */
    --color-bg: #070a12;
    --color-surface: #10151f;
    --color-surface-hover: #151c2a;
    --color-surface-raised: #1a2233;
    --color-border: #1a2332;
    --color-border-hover: #24344f;
    --color-border-strong: #2a3a52;

    /* — Acentos — azul eléctrico sutil — */
    --color-primary: #0ea5e9; /* brief fallback #007bff */
    --color-primary-hover: #0284c7;
    --color-primary-soft: rgba(14, 165, 233, 0.08);
    --color-primary-ring: rgba(14, 165, 233, 0.14);
    --color-primary-border: rgba(14, 165, 233, 0.22);

    /* — Tipografía — */
    --color-text: #fafafa;
    --color-text-secondary: #a1a9b8;
    --color-text-tertiary: #6b7280;

    --font-sans: "Inter", "Geist", "SF Pro Display", system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;

    --text-xs: 11px;
    --text-sm: 12px;
    --text-base: 13px;
    --text-md: 14px;
    --text-lg: 16px;
    --text-xl: 22px;
    --text-2xl: 30px;
    --text-hero: clamp(28px, 4vw, 36px);

    --weight-light: 300;
    --weight-regular: 400;
    --weight-medium: 500;
    --weight-semibold: 600;
    --weight-bold: 700;

    --leading-tight: 1.15;
    --leading-normal: 1.5;
    --leading-relaxed: 1.6;

    --tracking-tighter: -0.03em;
    --tracking-tight: -0.02em;
    --tracking-normal: -0.01em;

    /* — Espaciado (múltiplos de 4) — */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-12: 48px;
    --space-16: 64px;

    /* — Radios & sombras — */
    --radius-sm: 8px;
    --radius-md: 10px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --radius-full: 999px;

    --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.15);
    --shadow-focus: 0 0 0 3px var(--color-primary-ring);
    --shadow-card-hover: 0 8px 24px rgba(0, 0, 0, 0.22);
  }

  * { box-sizing: border-box; }
  *::selection { background: var(--color-primary-soft); color: var(--color-text); }

  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  html {
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) var(--color-bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: var(--weight-regular);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-normal);
    overflow-x: hidden;
  }

  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: var(--color-bg); }
  ::-webkit-scrollbar-thumb { background: var(--color-border-strong); border-radius: var(--radius-full); }
  ::-webkit-scrollbar-thumb:hover { background: #2a3441; }

  a { color: inherit; }
  :focus-visible { outline: 1px solid var(--color-primary); outline-offset: 2px; border-radius: 2px; }
</style>
